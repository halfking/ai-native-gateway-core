# ====================================================================
# 09 · 测试环境变量约定（Makefile 目标与 test helper）
# make test（go test ./...）不要求任何变量，真实 DB 类测试缺失自动 skip；
# 以下变量按目标需要 export 后再跑
# ====================================================================

# ── make test-rls（真实 PostgreSQL RLS 门禁）───────────────────────
# 必须用低权限角色（非 superuser/BYPASSRLS），否则假绿
TEST_DATABASE_URL=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable

# ── make test-pg-contracts（视图/表契约测试）───────────────────────
# 写入者 DSN + 低权限租户 DSN，两者必须不同
TEST_TENANT_DATABASE_URL=postgres://test_tenant:example-tenant-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable
# 目标自身置 1 的隔离标记，无需手动设置:
# TEST_PG_CONTRACTS_ISOLATED=1

# ── db 包 live 视图契约（db/view_schema_v2_contract_test.go 等）─────
# 未设置则 skip 进 offline 模式
LLM_GATEWAY_TEST_PG_DSN=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable
LLM_GATEWAY_TEST_PG_URL=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable
TEST_PG_URL=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable
TEST_DB_URL=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable
TEST_REDIS_URL=redis://127.0.0.1:6379/15
LLM_GATEWAY_PG_URL=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable

# ── make test-sessionforensics / test-replay ──────────────────────
# 会话导出数据绝对目录（默认空则回放测试跳过）
ABS_SESSIONS_DIR=/data/sessions-export

# ── dual-mode full 集成（tests/integration/dual_mode_test.go）──────
# 两者同时设置才生效
TEST_DUAL_FULL_PGURL=postgres://test_user:example-test-password@127.0.0.1:5432/llm_gateway_test?sslmode=disable
TEST_DUAL_FULL_REDISURL=redis://127.0.0.1:6379/15

# ── e2e / integration 指向被测网关 ────────────────────────────────
GATEWAY_URL=http://127.0.0.1:8781
LLM_GATEWAY_API_KEY=sk-gw-example-4f8a2b1c9e3d7f6a

# ── 通用 ─────────────────────────────────────────────────────────
# 限制测试样本/迭代数量（大库上跑子集）
TEST_LIMIT=100

# ── 真实上游 live 测试密钥（可选，未设则跳过）───────────────────────
ZHIPU_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_OAUTH_ACCESS_TOKEN=
OAUTH_GEMINI_ACCESS_TOKEN=
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
MLX_ENDPOINT=
AA_API_KEY=
VAPEUR_API_KEY=
MODEL_API_KEY=
# autoroute 审计联调 token（见 03）
# AUTO_AUDIT_TEST_MODE_TOKEN=

# ── dev-research 集成栈（docker-compose.dev-research.yml）──────────
# POSTGRES_HOST=host.docker.internal
# POSTGRES_PORT=5432
# POSTGRES_USER=kxuser
# POSTGRES_PASSWORD=__set_in_local_only__
# POSTGRES_DB=llm_gateway_test_dev
# REDIS_PORT=6379
# LLM_MOCK_HOST_PORT=19080
# 32B base64url，解密 provider credentials（dev-research 与 local-deploy-test 不可混用）
# LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=__set_in_local_only__
# LLM_GATEWAY_JWT_SECRET=__set_in_local_only__
# LLM_GATEWAY_ADMIN_API_KEY=__set_in_local_only__
# LLM_GATEWAY_SEED_ADMIN_PASSWORD=__set_in_local_only__
