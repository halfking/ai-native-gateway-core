# ====================================================================
# 08 · 监控栈（deploy/prometheus/docker-compose.yml）
# 用法: cp envs.samples/08-monitoring.env.sample deploy/prometheus/.env
# 覆盖: alertmanager + grafana + node-exporter + llm-gateway 抓取容器
# ====================================================================

# ── Grafana ──────────────────────────────────────────────────────
# admin 用户固定 admin，此处只设密码
GRAFANA_ADMIN_PASSWORD=example-grafana-password

# ── 飞书告警 Webhook（可选，alertmanager 通用通知）─────────────────
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/example-webhook-id

# ── credential-team oncall webhook（credential-17 告警，强烈建议设置）──
# 不设置时保持 placeholder.invalid 占位，派发会 loud-fail（设计内提示"请配置我"）
# 245 原生部署注入位置: /opt/monitoring/alertmanager/webhook.env
CREDENTIAL_TEAM_WEBHOOK_URL=https://oncall.example.com/credential-team/hook

# ── 被抓取的 llm-gateway 容器（/metrics 需要 admin API key，必填）──
LLM_GATEWAY_ADMIN_API_KEY=admin-sk-example-9d8e7f6a5b4c3d2e

# ── PostgreSQL exporter（监控库连接）──────────────────────────────
# llm-gateway-pg 容器唯一登录角色是 llm_gateway（不是 postgres）
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://llm_gateway:example-pg-password@llm-gateway-pg:5432/llm_gateway?sslmode=disable

# ── 抓取容器 DSN 六件套（R65 参数化；与上面 exporter 二选一形式）────
# 本地栈 PG_HOST=llm-gateway-pg；共享 252 栈保持 pg-252-pg17 网络别名
PG_USER=llm_gateway
PG_PASSWORD=example-pg-password
PG_HOST=llm-gateway-pg
PG_PORT=5432
PG_DB=llm_gateway
PG_SSLMODE=disable
