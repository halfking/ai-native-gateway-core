# ====================================================================
# 04 · 通知渠道（按启用的渠道挑变量，值均为示例值）
# 读取点: cmd/gateway/main_notification.go、main.go、bg/candidate_failure_monitor.go
# ====================================================================

# ── 钉钉 ─────────────────────────────────────────────────────────
# webhook 机器人模式（优先）
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=example-token
# webhook 加签密钥（审批回调验签时回退 DINGTALK_APP_SECRET）
DINGTALK_SIGN_SECRET=SEC-example-sign-secret
# 企业应用工作通知模式（webhook 未设时启用）
DINGTALK_APP_KEY=ding-example-app-key
DINGTALK_APP_SECRET=example-dingtalk-app-secret
DINGTALK_AGENT_ID=123456789

# ── 飞书 ─────────────────────────────────────────────────────────
# 自建应用渠道（AppID 为空则不启用）
LARK_APP_ID=cli_example_app_id
LARK_APP_SECRET=example-lark-app-secret
# 物化视图刷新失败/数据漂移告警收件人
LARK_ALERT_RECIPIENT=user_id_ou_example

# ── 企业微信 ─────────────────────────────────────────────────────
# 前缀版优先于无前缀版
LLM_GATEWAY_WECHAT_CORP_ID=ww-example-corp-id
LLM_GATEWAY_WECHAT_CORP_SECRET=example-wechat-corp-secret
# 回调配置（可选）
LLM_GATEWAY_WECHAT_TOKEN=example-wechat-token
LLM_GATEWAY_WECHAT_AES_KEY=example-wechat-aes-key
LLM_GATEWAY_WECHAT_AGENT_ID=1000002

# ── 候选凭据失败监控（不设 webhook 则只记日志）─────────────────────
CANDIDATE_FAILURE_WEBHOOK_URL=https://hooks.example.com/candidate-failure
# 触发告警的失败次数（默认 10）
CANDIDATE_FAILURE_ALERT_THRESHOLD=10
# 统计窗口（默认 5m）
CANDIDATE_FAILURE_ALERT_WINDOW=5m
# 告警冷却（默认 15m）
CANDIDATE_FAILURE_ALERT_COOLDOWN=15m
# 冷却判定：失败占比 / 最小样本数 / 冷却分钟数（默认 0.8 / 20 / 2）
CANDIDATE_FAILURE_COOL_RATIO=0.8
CANDIDATE_FAILURE_COOL_MIN_SAMPLES=20
CANDIDATE_FAILURE_COOL_MINUTES=2
# 数据陈旧阈值（默认 30m）
CANDIDATE_FAILURE_STALENESS_THRESHOLD=30m
