# ====================================================================
# 06 · scripts/deploy-local.sh 本地蓝绿部署（对应根目录 .env.local.example）
# 用法: cp envs.samples/06-deploy-local.env.sample .env.local
#       填真实值后: set -a; source .env.local; set +a; ./scripts/deploy-local.sh deploy
# ====================================================================

# ── 数据库（必填）────────────────────────────────────────────────
export LLM_GATEWAY_DATABASE_URL="postgres://postgres:example-db-password@127.0.0.1:5432/llm_gateway_dev?sslmode=disable"

# ── 固定密钥（重要！一旦设置不可变更，见目录 README「密钥生成」）────
# SECRET_KEY 变更 → 所有已签发会话失效
# CREDENTIAL_ENCRYPTION_KEY 变更 → 库里全部凭据密文无法解密（2026-09-05 provider 587 事故）
# 全新安装: openssl 生成后固定写入；从 245/252 同步库的必须用源环境同名密钥
export LLM_GATEWAY_SECRET_KEY="example-secret-key-0123456789abcdef"
export LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY="example-base64url-32byte-key"

# ── Admin API key（可每次部署动态生成，不影响持久数据）────────────
export LLM_GATEWAY_ADMIN_API_KEY="$(openssl rand -base64 32)"

# ── 引导管理员 ───────────────────────────────────────────────────
export LLM_GATEWAY_ADMIN_USER="admin"
export LLM_GATEWAY_ADMIN_PASSWORD="$(openssl rand -base64 16)"

# ── Redis（会话管理与 URSM v2）───────────────────────────────────
export LLM_GATEWAY_REDIS_ADDR="127.0.0.1:6379"

# ── 凭据解密冒烟测试（deploy-local 固定执行，candidate 与晋升两道门）──
# 指定部署后自动验证解密的 provider id 列表；未设置时自动选
# active_credential_count 最高的前 3 家（post-deploy-verify.sh）；
# 冒烟失败 → 候选实例被停掉、active 原样保留（deploy-local.sh:1171/1209）。
# 本仓库无 LLM_GATEWAY_SKIP_DECRYPT_SMOKE 读取点，冒烟没有跳过开关。
# export LLM_GATEWAY_DECRYPT_SMOKE_PROVIDER_ID="587,18,1"

# ── 端口 ─────────────────────────────────────────────────────────
export SERVICE_PORT="8781"

# ── URSM v2 模式（注意：无 LLM_GATEWAY_ 前缀，deploy-local-lib.sh 直接读
#    URSM_V2_MODE 并写进运行时 env（默认 authoritative）；shadow=V1 主+V2
#    影子写，authoritative=V2 主路径）────────────────────────────────
# export URSM_V2_MODE="authoritative"

# ── 运行时 env 白名单（dl_write_env）──────────────────────────────
# 网关容器的运行时 env = 发布包 bundle/env + 脚本白名单组装，白名单外的
# .env.local 键不会到达网关进程（如 BODIES_CODEC / URSM_SNAPSHOT_RETENTION_DAYS
# / STAGE_EVENTS_RETENTION_DAYS —— 这些是网关进程级 env，见 01/02，别放这里）。
# 白名单内可直接在 .env.local 覆盖的还有：CORS_ORIGINS、REDIS_DB（默认 2）、
# STORAGE_MODE、HOTZONE_ENABLED/DIR/RETENTION_HOURS/MAX_SIZE_GB/REQUEST_MIRROR。

# ── 部署拓扑输入旋钮（deploy-local-lib.sh / deploy-local.sh）────────
# 极简部署：由 --minimal 命令行旗标控制（脚本启动内置重置 0，env 写了会被覆盖）
# export MINIMAL_DEPLOY="0"
# 安装根目录（默认由 dl_default_root 推导）
# export LLM_GATEWAY_ROOT=""
# 共享 PG/Redis 数据布局推导的唯一输入（SHARED_* 目录均由它推导）
# export KAIXUAN_ROOT=""
# 允许与既有密钥不一致（危险；true/1 才放行并打 warning）
# export DL_ALLOW_KEY_DRIFT="false"
# 允许空 admin 密码（默认 false）
# export DL_ALLOW_EMPTY_ADMIN_PASSWORD="false"
# PG 预检强制（默认 0；=1 时 DSN 解析失败即 fail-closed）
# export DL_PG_PREFLIGHT_REQUIRED="0"
# 部署后把 admin 密码同步进实例（默认 true；写 false 跳过）
# export DEPLOY_SYNC_ADMIN_PASSWORD="true"
# DB 启动重试预算（写入运行时 env，默认 "90s"；值必须带 duration 单位）
# export LLM_GATEWAY_DB_BOOT_RETRY_SECONDS="90s"
# 蓝绿端口控制（active 端口默认 8782/候选 8781；SERVICE_PORT 作候选端口回落）
# export LLM_GATEWAY_ACTIVE_PORT=""
# export SERVICE_PORT="8781"
# 宿主机 Redis 发布端口覆盖（容器 redis_port==6379 时写进 env）
# export LLM_GATEWAY_REDIS_HOST_PORT=""
# 显式指定复用的 Redis 容器名（跳过三级自动发现）
# export LLM_GATEWAY_REDIS_CONTAINER=""
# nginx 上游配置文件路径（设置后走代理分支：候选保持运行，上游切到它；
# 不设则受控重启，非零停机）
# export LLM_GATEWAY_UPSTREAM_FILE=""
# 版本文件（默认走发布包内 version.json）
# export LLM_GATEWAY_VERSION_FILE=""
# 连接池（full 模式 pgxpool 上限默认 32；STORAGE 仅 lite 模式消费）
# export LLM_GATEWAY_DB_MAX_CONNS=""
# export LLM_GATEWAY_STORAGE_MAX_CONNECTIONS=""
# 系统监控（默认 true；URSM authoritative 运行时要求开启）
# export LLM_GATEWAY_SYSTEM_MONITOR_ENABLED="true"
# 健康检查超时秒（默认 60；也可 --timeout）
# export HEALTH_TIMEOUT="60"
# 基础镜像扫描目录（构建时从中挑选 BASE_IMAGE，非直接读 env）
# export DOCKER_BASE_IMAGES_DIR=""

# ── 脚本推导产物（dl_detect_resources 等自动 export，.env.local 写了会被
#    覆盖，仅 status/排障时读）────────────────────────────────────
# DL_DOCKER / DL_COMPOSE / DL_DB_MODE(none|docker|external|system) /
# DL_REDIS_MODE(none|docker|external|minimal|system) /
# DL_PG_CONTAINER / DL_REDIS_CONTAINER / DL_PG_SOURCE / DL_REDIS_SOURCE /
# DL_PG_MOUNT_TYPE / DL_REDIS_MOUNT_TYPE /
# SHARED_ROOT / SHARED_PG_DIR / SHARED_REDIS_DIR / SHARED_PG_RUN_DIR /
# SHARED_PG_BACKUP_DIR / DEPLOY_CANDIDATE_PORT / RELEASE_VERSION /
# HOST_UID / HOST_GID（脚本按 id -u/-g 自算）/ DL_CLEANUP_DOWNLOADS
# （--cleanup-downloads 旗标触发的内部旗标）
