# ====================================================================
# 10 · 安装器与 llm-launcher（installer/ 目录）
# 无头安装/激活/升级场景在命令前 export；交互安装走向导不需要
# ====================================================================

# ── 安装位置 ─────────────────────────────────────────────────────
# 安装根目录（优先于 LLM_GATEWAY_INSTALL_DIR；默认 cwd）
INSTALL_DIR=/opt/llm-gateway
LLM_GATEWAY_INSTALL_DIR=/opt/llm-gateway

# ── 无头激活 ─────────────────────────────────────────────────────
# license key（无头模式必填）
INSTALL_LICENSE_KEY=example-license-key
# 试用 license 邮箱
INSTALL_TRIAL_EMAIL=user@example.com
# 非交互同意条款（不区分大小写 true 生效）
INSTALL_AGREE_TERMS=true
# 置 1 跳过激活步骤
INSTALL_SKIP_ACTIVATION=0
# 试用模式相关
LICENSE_MODE=
LICENSE_NO_GRACE=
KX_LICENSE_KEY=
KX_LICENSE_KEY_HASH=

# ── 注册中心与镜像仓库 ───────────────────────────────────────────
# 激活/注册中心地址（默认 https://llmgateway.internal.example.com）
LLM_GATEWAY_MASTER_URL=https://llm.example-center.com
# 私有镜像仓库（默认 registry.internal.example.com）
KX_REGISTRY=registry.example.com
KX_REGISTRY_USERNAME=example-registry-user
KX_REGISTRY_PASSWORD=example-registry-password
# 镜像 tag 覆盖（heartbeat/升级器）
APP_IMAGE_TAG=latest

# ── 实例身份（launcher / upgrader 上报）───────────────────────────
INSTANCE_ID=
LICENSE_KEY=
HARDWARE_HASH=

# ── 升级器杂项 ───────────────────────────────────────────────────
# 自动更新管理 token
AUTOUPDATE_ADMIN_TOKEN=
# launcher 引导的运行时密钥（由安装器写入目标 env，一般无需手动）
# LLM_GATEWAY_SECRET_KEY=...
# LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=...
# LLM_GATEWAY_API_KEY=...
# LLM_GATEWAY_ADMIN_API_KEY=...
