# ====================================================================
# 01 · 网关进程运行时核心（config/config.go 主加载链）
# 复制合并进部署机 .env / systemd EnvironmentFile；值均为示例值
# 优先级: 环境变量 > YAML(LLM_GATEWAY_CONFIG_FILE) > 代码默认值
# ====================================================================

# ── 监听与运行环境 ────────────────────────────────────────────────
# 监听地址（默认 :8781）
LLM_GATEWAY_LISTEN=:8781
# 部署环境标识（fallback: GO_ENV / APP_ENV）
LLM_GATEWAY_ENV=dev
# 进程角色（蓝绿部署 worker 归属）: active | traffic-only（默认 active）
LLM_GATEWAY_RUNTIME_ROLE=active
# pprof 调试端口（留空关闭）
LLM_GATEWAY_PPROF_LISTEN=

# ── 数据库（必填）────────────────────────────────────────────────
# 规范 DSN（无前缀 DATABASE_URL 为兼容 fallback，二选一）
LLM_GATEWAY_DATABASE_URL=postgres://llm_gateway:example-db-password@127.0.0.1:5432/llm_gateway?sslmode=disable
# 连接池上限
LLM_GATEWAY_DB_MAX_CONNS=40
# 独立存储层连接数上限（storage 走单独池时）
LLM_GATEWAY_STORAGE_MAX_CONNECTIONS=20

# ── Redis（session / live-stream / rpm / availability cache 共用）──
# 共享实例上建议 db=2（db=0/1/9 已被其他系统占用，见根目录 .env.example 注）
LLM_GATEWAY_REDIS_ADDR=127.0.0.1:6379
LLM_GATEWAY_REDIS_PASSWORD=example-redis-password
LLM_GATEWAY_REDIS_DB=2
# URL 形式连接（与上面三件套二选一）
# LLM_GATEWAY_REDIS_URL=redis://:example-redis-password@127.0.0.1:6379/2

# ── 密钥（必填，生成命令见目录 README；前缀版优先于无前缀版）─────
# admin 会话 token 签名；设置后不可随意更换（会话全失效）
LLM_GATEWAY_SECRET_KEY=example-secret-key-0123456789abcdef
# provider 凭据 AES 加密 key（base64url 32B）；绝不可更换，否则库里密文全废
LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=ZXhhbXBsZS1jcmVkZW50aWFsLWVuY3J5cHRpb24ta2V5
# JWT 签名（未设时回退 SECRET_KEY；与 maintain 共享 HS256 时必须显式一致）
LLM_GATEWAY_JWT_SECRET=example-jwt-secret-0123456789abcdef
# 会话服务间 JWT 三件套（session service 对接时设置）
LLM_GATEWAY_SESSION_SERVICE_JWT_SECRET=example-session-svc-jwt-secret
LLM_GATEWAY_SESSION_SERVICE_JWT_ISSUER=llm-gateway
LLM_GATEWAY_SESSION_SERVICE_JWT_AUDIENCE=llm-gateway
# 客户端指纹 HMAC 盐（客户端识别/防伪造）
LLM_GATEWAY_IDENTITY_SALT=example-identity-salt-0123456789
# Cursor 客户端 HMAC 校验密钥（可选）
CURSOR_HMAC_SECRET=

# ── API 鉴权 ─────────────────────────────────────────────────────
# 数据面 Bearer token（/v1/* 客户端用）
LLM_GATEWAY_API_KEY=sk-gw-example-4f8a2b1c9e3d7f6a
# 控制面 /api/admin/* 鉴权 token
LLM_GATEWAY_ADMIN_API_KEY=admin-sk-example-9d8e7f6a5b4c3d2e

# ── 引导管理员 ───────────────────────────────────────────────────
LLM_GATEWAY_ADMIN_USER=admin
LLM_GATEWAY_ADMIN_PASSWORD=example-admin-password
LLM_GATEWAY_ADMIN_EMAIL=admin@example.com
# 首次启动 seed 的 admin 密码（与上面二选一，首次生效）
LLM_GATEWAY_SEED_ADMIN_PASSWORD=example-seed-admin-password

# ── 网络与 TLS ───────────────────────────────────────────────────
# 对外可达基础 URL（注册中心上报/自检回调用；留空自动推导）
LLM_GATEWAY_ENDPOINT=http://127.0.0.1:8781
LLM_GATEWAY_GATEWAY_BASE_URL=http://127.0.0.1:8781
# 局域网广播地址（mDNS 服务发现用）
# LLM_GATEWAY_LAN_ADVERTISE=10.0.0.10:8781
# 前置 TLS 反代时置 true（X-Forwarded-Proto 处理）
LLM_GATEWAY_BEHIND_TLS=false
LLM_GATEWAY_COOKIE_SECURE=false
# CORS 允许来源（逗号分隔，* 全放）
LLM_GATEWAY_CORS_ORIGINS=http://localhost:3000
# 客户端真实 IP 信任的代理网段（逗号分隔 CIDR；不设走内置默认表）
LLM_GATEWAY_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16

# ── 上游与超时（秒/时长，见 config.go timeout 段）────────────────
# 直通上游（单上游模式才需要；多供应商走 DB 配置）
# LLM_GATEWAY_UPSTREAM=https://oneapi.example.com
# 默认供应商 / 默认凭据 id（数字；缺省走路由决策）
# LLM_GATEWAY_DEFAULT_PROVIDER=
# LLM_GATEWAY_DEFAULT_CREDENTIAL=
LLM_GATEWAY_UPSTREAM_TIMEOUT=300
LLM_GATEWAY_STREAM_TIMEOUT=600
LLM_GATEWAY_STREAM_CHUNK_TIMEOUT=120
LLM_GATEWAY_FIRST_BYTE_TIMEOUT=60
LLM_GATEWAY_RESPONSE_HEADER_TIMEOUT=30
LLM_GATEWAY_KEEPALIVE_INTERVAL=15
LLM_GATEWAY_SYNC_RETRY_TIMEOUT=30
# SSE 单行最大字节（防恶意超长行）
LLM_GATEWAY_SSE_MAX_LINE_BYTES=1048576

# ── 会话 ─────────────────────────────────────────────────────────
LLM_GATEWAY_SESSION_TTL_HOURS=24
# 会话复用窗口
LLM_GATEWAY_SESSION_REUSE_WINDOW=300
# 从请求体提取会话 ID 的 key 列表（逗号分隔）
LLM_GATEWAY_SESSION_ID_BODY_KEYS=session_id,conversation_id
LLM_GATEWAY_DEFAULT_LANGUAGE=zh-CN

# ── 日志 ─────────────────────────────────────────────────────────
LLM_GATEWAY_LOG_LEVEL=info
LLM_GATEWAY_LOG_FORMAT=json
# 文件日志轮转：留空走 stderr；填绝对路径启用 rotation
LLM_GATEWAY_LOG_FILE=
LLM_GATEWAY_LOG_MAX_SIZE_MB=100
LLM_GATEWAY_LOG_MAX_BACKUPS=10
LLM_GATEWAY_LOG_MAX_AGE_DAYS=7
LLM_GATEWAY_LOG_COMPRESS=true

# ── 数据目录与存储 ───────────────────────────────────────────────
# 各类落盘根目录（默认相对工作目录 ./data）
LLM_GATEWAY_DATA_DIR=/var/lib/llm-gateway
LLM_GATEWAY_BODIES_DIR=
# lite 会话体落盘编码: gzip | zstd（回滚旧二进制前切回 gzip）
LLM_GATEWAY_BODIES_CODEC=gzip
# 存储模式/类型（见 config/storage.go；默认 DB 模式）
LLM_GATEWAY_STORAGE_MODE=db
# LLM_GATEWAY_STORAGE_TYPE=postgres
# 单机 sqlite 模式时的库文件路径
# LLM_GATEWAY_SQLITE_PATH=
# 备份目录
LLM_GATEWAY_BACKUP_DIR=/var/lib/llm-gateway/backups

# ── 附件 ─────────────────────────────────────────────────────────
# 存储目录（默认 ./data/attachments；容器部署挂 volume）
LLM_GATEWAY_ATTACHMENT_DIR=/var/lib/llm-gateway/attachments
# 访问认证: none | apikey | signed | admin（推荐 apikey）
LLM_GATEWAY_ATTACHMENT_AUTH_MODE=apikey
# 公开访问 URL 前缀（CDN 场景；留空用 /api/attachments/）
LLM_GATEWAY_ATTACHMENT_PUBLIC_URL=
LLM_GATEWAY_ATTACHMENT_PUBLIC_BASE_URL=
LLM_GATEWAY_ATTACHMENT_CORS_ORIGINS=*
# 单附件大小上限（字节）
LLM_GATEWAY_ATTACHMENT_MAX_SIZE=52428800
# URL 出站抓取与严格模式（安全项，默认关闭）
LLM_GATEWAY_ATTACHMENT_URL_OUTBOUND=false
LLM_GATEWAY_ATTACHMENT_STRICT=false
# 附件 URL 出站抓取回退（抓取失败时回退原始 URL）
LLM_GATEWAY_ATTACHMENT_URL_FETCH_FALLBACK=false
# 附件请求体读取超时（秒）
LLM_GATEWAY_ATTACHMENT_REQUEST_BODY_TIMEOUT_SEC=

# ── 认证时效 ─────────────────────────────────────────────────────
# admin JWT 有效期
LLM_GATEWAY_JWT_EXPIRY=
# 认证信息过期宽限（秒，domains/authentication/verifier.go）
LLM_GATEWAY_AUTH_STALE_GRACE_SECONDS=

# ── 会话服务 JWT / V2 读路径 ─────────────────────────────────────
# session-manager 专用 JWT 门禁（见 settings/session_service_auth_specs.go）
LLM_GATEWAY_SESSION_SERVICE_JWT_ENABLED=
# sessions v2 压缩读路径（平台级，默认开；settings 链 ParseBool，true/1 均可）
LLM_GATEWAY_SESSIONS_V2_COMPRESSION_READ=true
# 会话存储 v2 总开关（迁移期遗留，正常用 URSM_V2_MODE）
LLM_GATEWAY_V2_ENABLED=
# lite 会话体无鉴权读取（仅本地调试，生产必须关闭）
LLM_GATEWAY_LITE_ALLOW_UNAUTHENTICATED=false

# ── 后台任务与进程形态 ───────────────────────────────────────────
# 后台任务模式: full（默认）| data-plane（跳过 Python 71 拥有的循环）
LLM_GATEWAY_BG_MODE=full
# 实例标识（多实例区分；OPS_INSTANCE_ID 的网关侧形式）
LLM_GATEWAY_INSTANCE_ID=

# ── 池与协议转换 ─────────────────────────────────────────────────
# 连接池优雅释放宽限（秒）
LLM_GATEWAY_POOL_GRACE_PERIOD=
# IR 协议转换路径开关（默认开；false 仅用于紧急回滚 legacy 路径）
LLM_GATEWAY_IR_CONVERTER=
# 单请求最大 prompt token 数
LLM_GATEWAY_MAX_PROMPT_TOKENS=
# 测试基建：修复 role 交替（仅测试环境）
LLM_GATEWAY_FIX_ROLE_ALTERNATION=
# floor plan 并发
LLM_GATEWAY_FLOOR_PLAN_CONCURRENCY=

# ── 目录补充（默认相对工作目录）───────────────────────────────────
LLM_GATEWAY_LOG_DIR=
LLM_GATEWAY_LOGS_DIR=
LLM_GATEWAY_LOG_INDEX_DIR=
LLM_GATEWAY_CACHE_DIR=
# keyring 快照与同步（密钥轮转）
LLM_GATEWAY_KEYSTORE_SNAPSHOT_DIR=
LLM_GATEWAY_KEYSTORE_SYNC_INTERVAL=

# ── Redis 专用通道（缺省回落 LLM_GATEWAY_REDIS_*）────────────────
# 限流专用（ratelimit/redis_sliding.go）/ RPM 统计专用（rpm_redis.go）
RATE_LIMIT_REDIS_URL=
RPM_REDIS_URL=
# URL 形式连接（与上面三件套等价；storage 与迁移命令读取）
# LLM_GATEWAY_REDIS_URL=redis://:example-redis-password@127.0.0.1:6379/2
# REDIS_URL=redis://:example-redis-password@127.0.0.1:6379/2
# LLM_GATEWAY_POSTGRES_URL=（LLM_GATEWAY_DATABASE_URL 的别名形式）

# ── 静态资源与辅助服务 ───────────────────────────────────────────
# admin web 静态目录（留空用内嵌）
LLM_GATEWAY_STATIC_DIR=
# 本地 Python 辅助服务端点（文本分析/NLP 特性；留空禁用）
LLM_GATEWAY_PYTHON_ENDPOINT=
