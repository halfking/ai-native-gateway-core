# ====================================================================
# 07 · 运维占位符（服务器 IP / SSH / 多环境 DSN）
# 出现在 scripts/*.sh、docs/*.md 与 Dockerfile；真实值不进仓库：
# 本地放 shell 环境或部署工具变量组，生产走 SOPS/k8s secret
# IP 示例使用文档保留段（203.0.113.0/24 公网、10.x 内网），必须替换
# ====================================================================

# ── 服务器 IP ─────────────────────────────────────────────────────
# 154 网关服务器（llm.kxpms.cn，主机模式部署）
HOST_154_IP=203.0.113.154
HOST_154_INTERNAL_IP=10.0.0.154
# 252 阿里云（llm.itestu.cn + nps + vpn + redis:6389 + pg17:5432）
HOST_252_IP=203.0.113.252
HOST_252_INTERNAL_IP=10.0.0.252
# 245 网关服务器（registry.kxpms.cn 生产镜像仓库）
HOST_245_IP=203.0.113.245
HOST_245_INTERNAL_IP=10.0.0.245
# 186 应用服务器（即将弃用）
HOST_186_IP=203.0.113.186
# 文档中引用的其他占位符
HOST_184_IP=203.0.113.184
HOST_154_ALT_IP=203.0.113.160
HOST_252_DB_IP=10.0.0.252
HOST_245_GATEWAY_IP=10.177.0.245
HOST_154_GATEWAY_IP=10.177.0.154
LAN_GATEWAY_IP=192.168.1.10
ONEAPI_SUPPLIER_HOST=oneapi.example.com
E2E_API_KEY=sk-e2e-example-0123456789abcdef

# ── k3s 集群（kaixuan-1 控制面，k2/k3 同段）────────────────────────
KAIXUAN_1_IP=10.1.0.1
KAIXUAN_2_IP=10.1.0.2
KAIXUAN_3_IP=10.1.0.3
# kaixuan-1 后端 PostgreSQL 17（pg17 + citus + pgvector）
KAIXUAN_1_PG_HOST=10.1.0.1
KAIXUAN_1_PG_PORT=30432
# 阿里 252 上的 PostgreSQL 17
ALI_252_PG_HOST=10.0.0.252
ALI_252_PG_PORT=5432

# ── SSH 连接（默认密钥登录 root；sshpass 场景优先读 SSHPASS）───────
SSH_USER=root
SSH_PORT=25022
SSH_PORT_154=25022
SSH_PORT_252=25022
SSH_PORT_245=25022
SSH_PORT_186=25022
# 私钥路径（154/252/245/186 通用；kaixuan 独立）
SSH_KEY_154_PATH=$HOME/.ssh/id_ed25519
SSH_KEY_252_PATH=$HOME/.ssh/id_ed25519
SSH_KEY_245_PATH=$HOME/.ssh/id_ed25519
SSH_KEY_186_PATH=$HOME/.ssh/id_ed25519
SSH_KEY_KAIXUAN_1_PATH=$HOME/.ssh/kaixuan1_id_rsa
SSH_KEY_KAIXUAN_2_PATH=$HOME/.ssh/kaixuan2_id_rsa
SSH_KEY_KAIXUAN_3_PATH=$HOME/.ssh/kaixuan3_id_rsa
# SSH 密码（仅 password 认证场景；密钥认证留空）
SSHPASS=example-ssh-password
SSHPASS_154=example-ssh-password
SSHPASS_252=example-ssh-password
SSHPASS_245=example-ssh-password
SSHPASS_186=example-ssh-password
# check-and-fix-missing-tables.sh / ssh-deploy 密码占位
DEPLOY_SSH_PASSWORD=example-deploy-ssh-password

# ── 多环境数据库 URL（check-and-fix-missing-tables.sh DB_CONFIGS：
#    local / kaixuan-1 / 154 三个键）────────────────────────────────
# 本地 dev 栈
LLM_GATEWAY_DATABASE_URL_LOCAL=postgres://llm_gateway:example-db-password@127.0.0.1:5432/llm_gateway?sslmode=disable
# kaixuan-1 控制面后端
LLM_GATEWAY_DATABASE_URL_KAIXUAN_1=postgres://llm_gateway:example-db-password@10.1.0.1:30432/llm_gateway?sslmode=disable
# 154 主机部署
LLM_GATEWAY_DATABASE_URL_154=postgres://llm_gateway:example-db-password@10.0.0.154:5432/llm_gateway?sslmode=disable

# ── 节点运维（ops collector）──────────────────────────────────────
# 运维节点标识（写入 gateway_instances.region）：local / 245 / 154
OPS_NODE_REGION=local
# 首次激活与注册中心地址（默认 https://llm.kxpms.cn）
LLM_GATEWAY_CENTER_URL=https://llm.example-center.com
# 节点数据汇聚 API（心跳/采集）
OPS_COLLECT_URL=https://llm.example-center.com
# 运维节点注册 license key
OPS_COLLECT_LICENSE_KEY=example-license-key
# 仅调试：设 1 允许直连 DB 写 gateway_instances
OPS_COLLECT_DIRECT_DB=0
# 实例标识（默认持久化 ~/.local/share/kx-gateway/instance.id）
OPS_INSTANCE_ID=
OPS_DATA_DIR=
# 设 1 关闭节点自注册心跳
OPS_CENTER_AGENT_DISABLED=0

# ── 252 运维告警推送（scripts/252-monitor/notify.sh）───────────────
FEISHU_URL=https://open.feishu.cn/open-apis/bot/v2/hook/example-webhook-id
FEISHU_SECRET=example-feishu-secret
DINGTALK_URL=https://oapi.dingtalk.com/robot/send?access_token=example-token
DINGTALK_SECRET=example-dingtalk-secret
TELEGRAM_BOT_TOKEN=123456:ABC-example-token
TELEGRAM_CHAT_ID=-1001234567890
GENERIC_URL=https://hooks.example.com/generic
WEBHOOK_TYPE=generic

# ── 镜像仓库与内部域名 ───────────────────────────────────────────
REGISTRY=registry.example.com
LLMGATEWAY_HOST=llmgateway.example.com
AUTH_HOST=auth.example.com
MCP_HOST=mcp.example.com
