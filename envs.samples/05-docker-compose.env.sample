# ====================================================================
# 05 · docker compose 栈环境变量（根目录 docker-compose*.yml 插值用）
# 用法: cp envs.samples/05-docker-compose.env.sample .env && docker compose up -d
# 注意: docker-compose.yml 对 5 个必填项使用 :? 强校验，缺失直接报错
# ====================================================================

# ── 网关服务（docker-compose.yml 必填五项）────────────────────────
LLM_GATEWAY_DATABASE_URL=postgres://llm_gateway:example-db-password@llm-gateway-pg:5432/llm_gateway?sslmode=disable
LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=ZXhhbXBsZS1jcmVkZW50aWFsLWVuY3J5cHRpb24ta2V5
LLM_GATEWAY_API_KEY=sk-gw-example-4f8a2b1c9e3d7f6a
LLM_GATEWAY_ADMIN_API_KEY=admin-sk-example-9d8e7f6a5b4c3d2e
LLM_GATEWAY_SECRET_KEY=example-secret-key-0123456789abcdef
# 注册中心（默认 https://llm.kxpms.cn）
LLM_GATEWAY_CENTER_URL=https://llm.example-center.com

# ── 宿主机挂载目录（默认 ./data/*，生产指向持久卷）─────────────────
HOST_ATTACHMENT_DIR=/srv/llm-gateway/attachments
HOST_RAW_LOG_DIR=/srv/llm-gateway/raw-logs
HOST_BACKUP_DIR=/srv/llm-gateway/backups

# ── Grafana（同 compose 内 prometheus/grafana 服务）───────────────
GRAFANA_ADMIN_PASSWORD=example-grafana-password

# ── PostgreSQL 容器（persistent / v4-local / quickstart 栈）────────
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=example-postgres-password
POSTGRES_DB=llm_gateway
POSTGRES_PORT=5432

# ── Redis 容器 ───────────────────────────────────────────────────
REDIS_PASSWORD=example-redis-password
REDIS_PORT=6379

# ── quickstart 栈（docker-compose.quickstart.yml 的无前缀键）───────
# API_KEY / ADMIN_API_KEY / SECRET_KEY / CREDENTIAL_ENCRYPTION_KEY
# 与上方前缀版语义相同，quickstart compose 用无前缀名插值：
API_KEY=sk-gw-example-4f8a2b1c9e3d7f6a
ADMIN_API_KEY=admin-sk-example-9d8e7f6a5b4c3d2e
SECRET_KEY=example-secret-key-0123456789abcdef
CREDENTIAL_ENCRYPTION_KEY=ZXhhbXBsZS1jcmVkZW50aWFsLWVuY3J5cHRpb24ta2V5

# ── 镜像与端口（本地构建栈）───────────────────────────────────────
REGISTRY=registry.example.com
TAG=latest
APP_PORT=8781
# mock 上游宿主机发布端口（容器网络内固定 llm-mock-upstream:18080）
LLM_MOCK_HOST_PORT=19080

# ── 认证（compose 栈内 Casdoor 联动）──────────────────────────────
CASDOOR_ENDPOINT=http://casdoor:4800
CASDOOR_CLIENT_ID=example-casdoor-client-id
CASDOOR_CLIENT_SECRET=example-casdoor-client-secret

# ── 服务容器 DSN 参数化（R65 起的 6 个 PG 变量；本地栈 PG_HOST 改 llm-gateway-pg，
#    共享 252 栈保持 pg-252-pg17 网络别名）──────────────────────────
PG_USER=llm_gateway
PG_PASSWORD=example-pg-password
PG_HOST=llm-gateway-pg
PG_PORT=5432
PG_DB=llm_gateway
PG_SSLMODE=disable
