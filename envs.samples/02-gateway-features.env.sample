LLM_GATEWAY_DEBUG_MESSAGES_BODY=

# ── 伪装与路由 ───────────────────────────────────────────────────
LLM_GATEWAY_ENABLE_DISGUISE=false
LLM_GATEWAY_DISGUISE_PROFILES_PATH=
LLM_GATEWAY_MODEL_ALIAS_PREFIX=
