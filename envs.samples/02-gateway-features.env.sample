# ====================================================================
# 02 · 网关可选功能开关（按需挑变量，全部有代码内默认值）
# 默认值以代码为准；此处示例值即"推荐起步值"
# ====================================================================

# ── 请求存活恢复（L1 Holdback，默认关闭）──────────────────────────
# 前 N 个语义帧或窗口时间内保持缓冲，窗口内失败可透明重试
# （针对早期断流的模型可降 empty_response 80%+；代价是首字延迟）
LLM_GATEWAY_RECOVERY_HOLDBACK_WINDOW_MS=5000
LLM_GATEWAY_RECOVERY_HOLDBACK_MAX_CHUNKS=20
# L2 恢复模式与总开关
LLM_GATEWAY_RECOVERY_L2_ENABLED=false
LLM_GATEWAY_RECOVERY_L2_MODE=
# 自动恢复巡检与回看窗口
LLM_GATEWAY_AUTO_RECOVER_INTERVAL_SECONDS=60
LLM_GATEWAY_RECOVERY_LOOKBACK_WINDOW_HOURS=1
LLM_GATEWAY_RECOVERY_LOOKBACK_INTERVAL_SECONDS=300

# ── 请求存活恢复 V2（survival worker，默认关闭）───────────────────
LLM_GATEWAY_REQUEST_SURVIVAL_ENABLED=false
LLM_GATEWAY_REQUEST_SURVIVAL_DURABLE_ENABLED=false
LLM_GATEWAY_REQUEST_SURVIVAL_TENANT_ALLOWLIST=
LLM_GATEWAY_REQUEST_SURVIVAL_INTERACTIVE_DEADLINE_SECONDS=120
LLM_GATEWAY_REQUEST_SURVIVAL_RETRY_INTERVAL_SECONDS=30
LLM_GATEWAY_REQUEST_SURVIVAL_RETRY_BASE_SECONDS=5
LLM_GATEWAY_REQUEST_SURVIVAL_RETRY_MAX_SECONDS=300
LLM_GATEWAY_REQUEST_SURVIVAL_MAX_ATTEMPTS=8
# 夜间档：更大重试预算
LLM_GATEWAY_REQUEST_SURVIVAL_NIGHT_MAX_ATTEMPTS=16
LLM_GATEWAY_REQUEST_SURVIVAL_NIGHT_START_HOUR=23
LLM_GATEWAY_REQUEST_SURVIVAL_DURABLE_DEADLINE_SECONDS=3600
LLM_GATEWAY_REQUEST_SURVIVAL_STATUS_INTERVAL_SECONDS=15
LLM_GATEWAY_REQUEST_SURVIVAL_WORKER_COUNT=4
LLM_GATEWAY_REQUEST_SURVIVAL_WORKER_LEASE_SECONDS=60
LLM_GATEWAY_REQUEST_SURVIVAL_MAX_ACTIVE_TASKS_PER_TENANT=100

# ── 流重试与空流防护 ──────────────────────────────────────────────
LLM_GATEWAY_STREAM_RETRY_ENABLED=true
LLM_GATEWAY_STREAM_RETRY_THRESHOLD=2
LLM_GATEWAY_STREAM_RETRY_MAX_RETRIES=2
LLM_GATEWAY_STREAM_RETRY_BASE_DELAY_MS=500
LLM_GATEWAY_STREAM_RETRY_MAX_DELAY_MS=8000
LLM_GATEWAY_STREAM_RETRY_KEEPALIVE_SECS=15
LLM_GATEWAY_ENABLE_EMPTY_STREAM_GATE=true
LLM_GATEWAY_EMPTY_STREAM_EARLY_EMPTY_CHUNKS=3
LLM_GATEWAY_ENABLE_PRE_STREAM_KEEPALIVE=true
LLM_GATEWAY_MIDSTREAM_FAILURE_NOTICE=true

# ── 请求侧异常探测（reqprobe，默认开）──────────────────────────────
# 参数协商账本：off 关闭学习
# LLM_GATEWAY_REQPROBE_LEARN=off

# ── Extensions 透传（厂商特有字段保留，默认 false）────────────────
# LLM_GATEWAY_TRANSPORT_IR=true

# ── Goal 模式（自动续跑+任务审计，默认关闭，可按租户 settings 覆盖）─
LLM_GATEWAY_GOAL_ENABLED=false
LLM_GATEWAY_GOAL_DETECTION_MODE=hybrid
LLM_GATEWAY_GOAL_AUTO_CONTINUE=true
LLM_GATEWAY_GOAL_MAX_AUTO_CONTINUE=3
LLM_GATEWAY_GOAL_AUDIT_ENABLED=false
LLM_GATEWAY_GOAL_USE_AUTOROUTE_AUDIT=true
LLM_GATEWAY_GOAL_AUDIT_MODEL=auto
LLM_GATEWAY_GOAL_FALLBACK_AUDIT_MODEL=auto
LLM_GATEWAY_GOAL_AUTO_FIX=false
# 死循环防护：切换模型 + 重置续跑预算
LLM_GATEWAY_GOAL_MODEL_SWITCH_ON_LOOP=true
LLM_GATEWAY_GOAL_MAX_MODEL_SWITCH=3
LLM_GATEWAY_GOAL_FALLBACK_MODELS=auto,gpt-4o,claude-3-5-sonnet
LLM_GATEWAY_GOAL_REPEAT_DETECTION=true
LLM_GATEWAY_GOAL_REPEAT_THRESHOLD=3
LLM_GATEWAY_GOAL_COMPLETION_CONFIDENCE=0.8
# follow-up 硬护栏：必须 > MAX_AUTO_CONTINUE × (MAX_MODEL_SWITCH+1)
LLM_GATEWAY_GOAL_MAX_FOLLOW_UP_DEPTH=15
LLM_GATEWAY_GOAL_MAX_FOLLOW_UPS_PER_SESSION=50

# ── 自动会话标题/摘要（默认开；空/非法回落开启）───────────────────
LLM_GATEWAY_AUTO_TITLE_ENABLED=true
LLM_GATEWAY_AUTO_SUMMARY_ENABLED=true

# ── 自动 Handoff（会话交接，默认关闭）─────────────────────────────
LLM_GATEWAY_HANDOFF_ENABLED=false
LLM_GATEWAY_HANDOFF_TRIGGER_MODE=auto
LLM_GATEWAY_HANDOFF_CLIENT_MODE=transparent
LLM_GATEWAY_HANDOFF_ABSOLUTE_THRESHOLD=180000
LLM_GATEWAY_HANDOFF_PERCENTAGE_THRESHOLD=0.8
LLM_GATEWAY_HANDOFF_MESSAGE_THRESHOLD=0
LLM_GATEWAY_HANDOFF_SKILL_NAME=handoff

# ── 任务托管与移交（hosted task delegation，默认关闭）─────────────
LLM_GATEWAY_HOSTED_TASKS_ENABLED=false
LLM_GATEWAY_HOSTED_TASK_WORKSPACE_MAP=default=/srv/workspace
LLM_GATEWAY_HOSTED_TASK_CALLBACK_ALLOWLIST=
LLM_GATEWAY_HOSTED_TASK_CALLBACK_ENC_KEY=
LLM_GATEWAY_HOSTED_TASK_MODEL=
LLM_GATEWAY_HOSTED_TASK_TIMEOUT_SECONDS=3600
LLM_GATEWAY_HOSTED_TASK_DEFAULT_DEADLINE_SECONDS=3600
LLM_GATEWAY_HOSTED_TASK_MAX_DEADLINE_SECONDS=86400
LLM_GATEWAY_HOSTED_TASK_RECONCILE_INTERVAL_SECONDS=5
LLM_GATEWAY_HOSTED_TASK_DISPATCH_RETRY_AFTER_SECONDS=30

# ── 凭据健康 ─────────────────────────────────────────────────────
# 指纹槽位（多凭据指纹隔离）
LLM_GATEWAY_ENABLE_CREDENTIAL_FP_SLOTS=false
LLM_GATEWAY_CREDENTIAL_FP_SLOT_ACTIVE_GATE_SECONDS=
LLM_GATEWAY_CREDENTIAL_FP_SLOT_RECLAIM_IDLE_SECONDS=
# 单凭据默认并发
LLM_GATEWAY_DEFAULT_CREDENTIAL_CONCURRENCY=
# 自动吊销（连续失败阈值/窗口）
LLM_GATEWAY_CREDENTIAL_AUTO_REVOKE=false
LLM_GATEWAY_CREDENTIAL_AUTO_REVOKE_THRESHOLD=
LLM_GATEWAY_CREDENTIAL_AUTO_REVOKE_WINDOW_HOURS=
LLM_GATEWAY_CREDENTIAL_AUTO_REVOKE_INTERVAL=
# 软 nud­ge（429/auth/empty/timeout 分型提示）
LLM_GATEWAY_CREDENTIAL_NUDGE_429=
LLM_GATEWAY_CREDENTIAL_NUDGE_AUTH=
LLM_GATEWAY_CREDENTIAL_NUDGE_EMPTY=
LLM_GATEWAY_CREDENTIAL_NUDGE_TIMEOUT=
LLM_GATEWAY_CREDENTIAL_NUDGE_WINDOW=
LLM_GATEWAY_CREDENTIAL_WEIGHT_NUDGE=
# 凭据恢复 worker（traffic-only 节点也必须跑；true 才停用）
LLM_GATEWAY_CRED_RECOVERY_DISABLED=false
LLM_GATEWAY_CRED_RECOVERY_INTERVAL_SECONDS=60
LLM_GATEWAY_CRED_CYCLER_INTERVAL=
LLM_GATEWAY_CRED_PROBE_V2_INTERVAL=
LLM_GATEWAY_CRED_PROBE_V2_FAST_REPROBE_DELAY=

# ── 配额与余额巡检 ───────────────────────────────────────────────
LLM_GATEWAY_QUOTA_PROBE_DISABLED=false
LLM_GATEWAY_QUOTA_FETCH_MIN_INTERVAL_MS=
LLM_GATEWAY_PERIODIC_QUOTA_PROBE_INTERVAL=
LLM_GATEWAY_PERIODIC_QUOTA_PRE_PROBE_WINDOW=
LLM_GATEWAY_PERIODIC_QUOTA_RECOVER_AT_MAX_LINGER=
LLM_GATEWAY_BALANCE_FLOOR_GUARD=false
LLM_GATEWAY_BALANCE_FLOOR_INTERVAL=
LLM_GATEWAY_BALANCE_FLOOR_ESCAPE_HOURS=
LLM_GATEWAY_BALANCE_QUOTA_PROBE_INTERVAL=
LLM_GATEWAY_BALANCE_QUOTA_FORCE_COOLDOWN=

# ── 供应商画像与成本对账 ──────────────────────────────────────────
LLM_GATEWAY_PROVIDER_PROFILE_ENABLED=false
LLM_GATEWAY_PROVIDER_PROFILE_COLLECTION_INTERVAL=
LLM_GATEWAY_PROVIDER_PROFILE_AGGREGATION_INTERVAL=
LLM_GATEWAY_PROVIDER_PROFILE_ALERT_INTERVAL=
LLM_GATEWAY_PROVIDER_PROFILE_CLEANUP_INTERVAL=
LLM_GATEWAY_PROVIDER_COST_RECONCILIATION_ENABLED=false
LLM_GATEWAY_PROVIDER_COST_RECONCILIATION_INTERVAL=

# ── Mock Probe 通道（进程内自检，默认全关）────────────────────────
LLM_GATEWAY_MOCK_PROBE_ENABLED=false
LLM_GATEWAY_MOCK_PROBE_HIDE_IN_ADMIN=true
# <1s 回落 30s 防探测风暴
LLM_GATEWAY_MOCK_PROBE_INTERVAL_SECONDS=30
LLM_GATEWAY_MOCK_PROBE_FAILURE_THRESHOLD=3

# ── MNF 连败冷却（model-not-found 停用供应商）─────────────────────
LLM_GATEWAY_MNF_STREAK_ENABLED=
LLM_GATEWAY_MNF_STREAK_THRESHOLD=
LLM_GATEWAY_MNF_STREAK_CAPACITY=
LLM_GATEWAY_MNF_COOL_THRESHOLD=
LLM_GATEWAY_MNF_COOL_MINUTES=

# ── 会话压缩（compaction/compression 家族）────────────────────────
LLM_GATEWAY_SESSION_COMPRESSOR_DISABLE=false
LLM_GATEWAY_COMPACTION_DISABLE=false
LLM_GATEWAY_COMPACTION_MODELS=
LLM_GATEWAY_COMPRESSION_MODE=
LLM_GATEWAY_COMPRESSION_LITE=
LLM_GATEWAY_COMPRESSION_CAVEMAN=
LLM_GATEWAY_COMPRESSION_SELECTOR=
LLM_GATEWAY_COMPRESSION_SELECTOR_SPEC=
LLM_GATEWAY_COMPRESSION_RUNNER_MODE=
LLM_GATEWAY_COMPRESSION_STRATEGY_RUNNER_ENABLED=
LLM_GATEWAY_COMPRESSION_TARGET_RATIO=
LLM_GATEWAY_COMPRESSION_TOOLFOCUSED=
LLM_GATEWAY_COMPRESSION_MEMO_TTL=
LLM_GATEWAY_COMPRESSION_WARMUP_MIN_FACTS=
LLM_GATEWAY_COMPRESSION_WINDOW_FRACTION=

# ── URSM v2（会话存储 v2 / 影子模式灰度）──────────────────────────
# shadow: V1 主路径+V2 影子写；authoritative: V2 主路径（部署脚本默认）
LLM_GATEWAY_URSM_V2_MODE=shadow
LLM_GATEWAY_URSM_V2_REDIS_KEY_PREFIX=
LLM_GATEWAY_URSM_V2_KEY_SCHEMA_MODE=
LLM_GATEWAY_URSM_V2_LRU_SIZE=
LLM_GATEWAY_URSM_V2_LRU_SOFT_TTL_MS=
LLM_GATEWAY_URSM_V2_COOL_SECONDS=
LLM_GATEWAY_URSM_V2_OUTAGE_GRACE_SECONDS=
LLM_GATEWAY_URSM_V2_SHADOW_DOUBLE_WRITE=
LLM_GATEWAY_URSM_V2_SHADOW_SAMPLE_RATE=
LLM_GATEWAY_URSM_V2_STRICT_CANARY=
LLM_GATEWAY_URSM_V2_CANARY_MODELS=
LLM_GATEWAY_URSM_V2_CANARY_TENANTS=
LLM_GATEWAY_URSM_V2_CANARY_CREDENTIALS=
LLM_GATEWAY_URSM_V2_CANARY_PERCENT=
# sessions v2 读路径主切换
SESSIONS_V2_PRIMARY_READ=0
TEST_SESSION_V2_ISOLATED=0

# ── 无界增长表保留窗口（容量门禁整改）─────────────────────────────
# ursm_node_snapshot_min 快照保留天数（默认 30，0=禁用清理）
URSM_SNAPSHOT_RETENTION_DAYS=30
# request_stage_events 保留天数（默认 7，0=禁用清理）
STAGE_EVENTS_RETENTION_DAYS=7
# 夜间 vacuum 窗口
LLM_GATEWAY_VACUUM_HOUR=
LLM_GATEWAY_VACUUM_INTERVAL_HOURS=

# ── 会话一致性巡检 ───────────────────────────────────────────────
LLM_GATEWAY_CONSISTENCY_CHECK_ENABLED=false
LLM_GATEWAY_CONSISTENCY_INTERVAL_HOURS=
LLM_GATEWAY_CONSISTENCY_IDLE_THRESHOLD_MIN=
LLM_GATEWAY_CONSISTENCY_MAX_SESSIONS_PER_RUN=
LLM_GATEWAY_CONSISTENCY_DELETE_ORPHANS=

# ── Hotzone / 请求归档 / 原始日志 ─────────────────────────────────
LLM_GATEWAY_HOTZONE_ENABLED=false
LLM_GATEWAY_HOTZONE_DIR=
LLM_GATEWAY_HOTZONE_MAX_SIZE_GB=
