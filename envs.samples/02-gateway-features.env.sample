# ── URSM v2（会话存储 v2 / 影子模式灰度）──────────────────────────
# 注意：本族无 LLM_GATEWAY_ 前缀（读取点 domains/ursm/v2/config.go LoadFromEnv）
# MODE: off | shadow | canary | authoritative（大小写敏感，非法值启动失败）
# 代码内默认 authoritative（config.go:113）；无 Redis 时 Manager 不装配退回 legacy。
# shadow=V1 主路径+V2 影子写；authoritative=V2 主路径（deploy-local 默认）
URSM_V2_MODE=shadow
# Redis key 命名空间前缀（默认 ursm:v2:；strict canary 要求非默认且以 : 结尾）
URSM_V2_REDIS_KEY_PREFIX=
# key 语法：legacy | dual | canonical（默认 legacy；非法值启动失败）
URSM_V2_KEY_SCHEMA_MODE=
# 进程内 NodeMirror LRU（默认 100000；0=禁用镜像）
URSM_V2_LRU_SIZE=
# 镜像软 TTL 毫秒整数（默认 30000；不是 duration 字符串）
URSM_V2_LRU_SOFT_TTL_MS=
# 节点故障冷却秒（默认 30；可被 settings_kv llmgw_ursm_cool_seconds 热覆盖）
URSM_V2_COOL_SECONDS=
# Redis 硬故障宽限秒（默认 1800；上限 86400；0=关闭宽限严格 fail-closed）
URSM_V2_OUTAGE_GRACE_SECONDS=
# 影子写开关：仅认 1/true/yes（不分大小写）；仅 Mode=shadow 且 rollout 同真时生效
URSM_V2_SHADOW_DOUBLE_WRITE=
# 影子采样率 0~1 浮点（默认 0.01；非法值静默回落默认）
URSM_V2_SHADOW_SAMPLE_RATE=
# 严格金丝雀：仅认 1/true/yes；需 MODE=canary + PERCENT=0 + 三 allowlist 非空
# + 前缀非默认以 : 结尾，任一缺失启动报错（scope.go）
URSM_V2_STRICT_CANARY=
# 依赖门（默认 false=依赖缺失降级 ModeOff 继续服务；true=拒绝启动 fail-fast）
URSM_V2_STRICT_DEPS=
URSM_V2_CANARY_MODELS=
URSM_V2_CANARY_TENANTS=
# 正整数 CSV（凭证 id）；任一非法启动失败
URSM_V2_CANARY_CREDENTIALS=
# 0-100 按凭证哈希放行；非法/越界启动失败
URSM_V2_CANARY_PERCENT=
# sessions v2 读路径主切换（读取点裸判 == "true"，仅认 true，勿用 1/0）
SESSIONS_V2_PRIMARY_READ=false
# 测试基建专用（domains/session/v2/test_helpers.go）：仅认字面量 "1"，
# 网关二进制不读；=1 时才允许跑会写库的 v2 数据库测试
TEST_SESSION_V2_ISOLATED=0

