LLM_GATEWAY_SYSTEM_MONITOR_ENABLED=true
LLM_GATEWAY_SYSTEM_MONITOR_WORKERS_PER_NODE=
LLM_GATEWAY_HEALTH_CHECK_INTERVAL=
LLM_GATEWAY_FD_SCAN_INTERVAL=
