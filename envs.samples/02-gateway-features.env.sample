# LLM_GATEWAY_GEOIP_CSV=data/geoip/segments.csv

# ── 订阅代理管理器（S8-F4/R60 旋钮）───────────────────────────────
LLM_GATEWAY_PROXY_SUBSCRIPTION_REFRESH=1h
LLM_GATEWAY_PROXY_PROBE_INTERVAL=5m
LLM_GATEWAY_PROXY_SUBSCRIPTION_ALLOW_PRIVATE=false
PROVIDERCAP_EGRESS_ALLOW_PRIVATE=false

# ── 出口标识（多出口节点上报）─────────────────────────────────────
LLM_GATEWAY_EGRESS_IP=
LLM_GATEWAY_EGRESS_FORWARDED_FOR=

# ── 会话分析（session analytics / auto title-summary 引擎）─────────
# settings/session_analytics_specs.go 共 13 条规格（含未列出的
# SA_MODEL_EMBEDDING）；默认值/类型以 SPECS-REFERENCE 为准
LLM_GATEWAY_SESSION_ANALYTICS_ENABLED=
LLM_GATEWAY_SA_OPT_ENABLED=
LLM_GATEWAY_SA_TITLE_ON_FIRST=
LLM_GATEWAY_SA_SUMMARY_STRATEGY=
LLM_GATEWAY_SA_REQ_SUMMARY_MODE=
LLM_GATEWAY_SA_MODEL_TITLE=
LLM_GATEWAY_SA_MODEL_SUMMARY=
LLM_GATEWAY_SA_MODEL_REQ_SUMMARY=
LLM_GATEWAY_SA_MODEL_TAGS=
LLM_GATEWAY_SA_MODEL_CLUSTER_LABEL=
LLM_GATEWAY_SA_CLUSTER_MODE=
LLM_GATEWAY_SA_CLUSTER_SCHEDULE=
# 会话摘要 per-turn digest 输入层（默认关）
LLM_GATEWAY_SESSIONS_SUMMARY_PER_TURN_DIGEST=

# ── 日志全文索引（Bleve fanout）───────────────────────────────────
# ENABLED 仅认 true/1（默认关）；默认 BATCH 256 / BUFFER 8192 / FLUSH 500ms
LLM_GATEWAY_LOG_BLEVE_ENABLED=false
LLM_GATEWAY_LOG_BLEVE_BATCH=
LLM_GATEWAY_LOG_BLEVE_BUFFER=
LLM_GATEWAY_LOG_BLEVE_FLUSH_MS=

# ── 数据生命周期 cron（admin/data_lifecycle_cron_env.go）──────────
# DISABLED 仅认 1 或 true（默认启用）；RUN_AT 格式 HH:MM（默认 02:00）
HOT_CRON_DISABLED=false
# 单批行数（默认 500）
HOT_CRON_BATCH_SIZE=
# 首次重试等待秒（默认 30）
HOT_CRON_BACKOFF_SECONDS=
# 单表失败重试次数（默认 3）
HOT_CRON_MAX_RETRIES=
# 迁移超过 N 小时的数据（默认 8）
HOT_CRON_RETENTION_HOURS=
HOT_CRON_RUN_AT=

# ── 路由优化插件（settings/routing_opt_feature_flags.go）──────────
# 总开关默认关（零开销短路）；子旗标默认：CLASSIFICATION_ENHANCEMENT/
# MODEL_RECOMMENDATION/FEEDBACK_INTEGRATION=true，其余 false
ROUTING_OPT_ENABLED=false
# 默认 0.05
ROUTING_OPT_EXPLORATION_RATE=
# 默认 10
ROUTING_OPT_MAX_PLUGIN_LATENCY_MS=
ROUTING_OPT_ADAPTIVE_LEARNING=
ROUTING_OPT_FEEDBACK_INTEGRATION=
ROUTING_OPT_MODEL_RECOMMENDATION=
ROUTING_OPT_CLASSIFICATION_ENHANCEMENT=
ROUTING_OPT_AFFINITY_CACHE=
ROUTING_OPT_AB_TEST_ENABLED=
# 默认 0.1
ROUTING_OPT_AB_TEST_PERCENTAGE=

# ── Autoroute 特性开关（autoroute/feature_flags.go + legacyflags）──
# 代码默认除 CHANNEL_QUALITY_ROUTING/SHADOW_ONLY 外全 false/0
AUTO_ENABLE_V2=
# dispatch 换模型 legacy 强制覆盖：=="true" 时无视热键 dispatch_v2.allow_model_change
# 强制开启（domains/dispatch/gate.go）
AUTO_ROUTE_FALLBACK_ENABLED=
AUTO_USE_CHANNEL_QUALITY_ROUTING=true
AUTO_USE_COMPLEXITY_SCORE=
AUTO_USE_EXPLICIT_DEFAULT=
AUTO_USE_POPULARITY_WEIGHT=
AUTO_USE_STANDARD_IQ_GATE=
# 以下 4 项 Deprecated（autoroute/internal/legacyflags）：仅 URSM_V2_MODE=off
# 回退路径读取，新部署勿用
AUTO_USE_48H_FALLBACK=
AUTO_USE_CACHE_REVALIDATION=
AUTO_USE_HOT_TOP3_POOL=
AUTO_USE_SIMPLIFIED_SCORING=
# 数值默认：POPULARITY_WEIGHT 5 / MIN_STANDARD_IQ 0 / FEATURED_BONUS 5
AUTO_POPULARITY_WEIGHT=
AUTO_MIN_STANDARD_IQ=
AUTO_FEATURED_BONUS=
AUTO_ROLE_ROUTING_ENABLED=
# 默认 true（父开关 AUTO_ROLE_ROUTING_ENABLED 关闭时不生效）。轻量池
# 偏好整层不可用时，是否继续回退到主流模型（glm-5.3 / claude-opus-5 /
# gpt-5.6-sol / grok-4.6 / deepseek-v4-pro）。设 false 退回旧口径：
# 整层不可用即让位给评分结果。
AUTO_ROLE_ROUTING_MAINSTREAM_FALLBACK=
# off | shadow（默认）| on；shadow 只记录不影响选中
AUTO_AFFINITY_MODE=
# 0..1，默认 0.10
AUTO_AFFINITY_EXPLORE_RATIO=
# V3 实验族：ENABLED 默认 false；SHADOW_ONLY 默认 true；VARIANT_PCT 默认 0；
# VERSION/EXPERIMENT/SCOPE 字符串直读
AUTO_OPTIMIZATION_V3_ENABLED=
AUTO_OPTIMIZATION_V3_VERSION=
AUTO_OPTIMIZATION_V3_EXPERIMENT=
AUTO_OPTIMIZATION_V3_SCOPE=
AUTO_OPTIMIZATION_V3_VARIANT_PCT=
AUTO_OPTIMIZATION_V3_SHADOW_ONLY=
AUTO_OPTIMIZATION_V3_AUTO_ROLLBACK=

# ── 路由/故障/探测阈值（settings 规格，支持 settings_kv 热覆盖）────
# 读取点 settings/spec_thresholds.go（Wave2 集中化）；默认值见 SPECS-REFERENCE；
# 末项在 settings/spec_proxy.go
LLM_GATEWAY_ROUTING_NODE_FAIL_STREAK_LIMIT=
LLM_GATEWAY_ROUTING_NODE_DISABLED_COOLDOWN_SECONDS=
LLM_GATEWAY_ROUTING_STICKY_FAILURE_THRESHOLD=
LLM_GATEWAY_DISGUISE_FP_SLOT_TTL_SECONDS=
LLM_GATEWAY_ERROR_PROBE_WORKERS=
LLM_GATEWAY_CREDENTIAL_MODEL_NOT_FOUND_INITIAL_COOLDOWN_SECONDS=
LLM_GATEWAY_CREDENTIAL_MODEL_NOT_FOUND_SUSTAINED_COOLDOWN_SECONDS=
LLM_GATEWAY_CREDENTIAL_MODEL_DEPRECATED_COOLDOWN_SECONDS=
LLM_GATEWAY_PROXY_DEFAULT_BANNED_REGIONS=

# ── 其他子系统开关 ───────────────────────────────────────────────
# IR 语义分析器装配（main.go =="true"，默认关；SA 族引擎另见上方 settings 段）
LLM_GATEWAY_SEMANTIC_ANALYSIS_ENABLED=
# 全链路一致性指纹采集漂移检测（bg/integrity_fingerprint_drift.go）
# 默认：INTERVAL 1h / DAYS 7 / MIN_SAMPLES 20 / DOMINANT_RATIO 0.8
LLM_GATEWAY_INTEGRITY_FP_DRIFT_DAYS=
LLM_GATEWAY_INTEGRITY_FP_DRIFT_MIN_SAMPLES=
LLM_GATEWAY_INTEGRITY_FP_DRIFT_INTERVAL=
LLM_GATEWAY_INTEGRITY_FP_DRIFT_DOMINANT_RATIO=
# 采集器（bg/integrity_harvester.go）：INTERVAL 5m / CRITICAL_AGE 1m /
# HIGH_WINDOW 15m / HIGH_MIN_COUNT 3；ENABLED 默认开（仅 "false" 关）
LLM_GATEWAY_INTEGRITY_HARVEST_HIGH_MIN_COUNT=
LLM_GATEWAY_INTEGRITY_HARVEST_HIGH_WINDOW=
LLM_GATEWAY_INTEGRITY_HARVEST_CRITICAL_AGE=
LLM_GATEWAY_INTEGRITY_HARVEST_INTERVAL=
# 探测规划（bg/integrity_probe_planner.go）：INTERVAL 10m / DEDUP 24h /
# MAX_PER_TICK 25
LLM_GATEWAY_INTEGRITY_PROBE_MAX_PER_TICK=
LLM_GATEWAY_INTEGRITY_PROBE_DEDUP=
LLM_GATEWAY_INTEGRITY_PROBE_INTERVAL=
#（STREAM_ABORT 开关见上方 Hotzone 段，此处不重复）
LLM_GATEWAY_INTEGRITY_STREAM_ABORT_MIN_HITS=
LLM_GATEWAY_INTEGRITY_STREAM_RECORD_MIN_HITS=
# 请求明细环形缓冲条数上限（默认 4096）/ DB 读回重试次数（默认 1，0=禁用）
LLM_GATEWAY_REQUEST_DETAIL_MAX_ENTRIES=
LLM_GATEWAY_REQUEST_DETAIL_DB_RETRY=
# 免费模型全覆盖放行（omnifree，=="true" 默认关）
OMNIFREE_ENABLED=
# 压力感知路由（=="true" 默认关；曲线参数见下方 W_* 段）
PRESSURE_AWARE_ROUTING=
# 质量采集器 / 画像更新器：默认开（留空或 true 启动；写任意其他值停用）
PROFILE_UPDATER_ENABLED=
QUALITY_COLLECTOR_ENABLED=
# 参数注册表（默认开；仅 "false"（不分大小写）回退旧双门禁还原行为）
PARAMREG_ENABLED=
# 服务发现绑定过期宽限小时（默认 24；有成功请求的绑定免于过期）
DISCOVERY_GRACE_HOURS=
# 凭据-模型绑定过期清理启用（discovery/discovery.go =="1" 默认关）
ENABLE_CMB_EXPIRE=
# 系统提示词占位符保护（默认开；注意：当前生产代码无调用方，注入点未接线）
SANITIZE_SYSTEM_PROMPT_ENABLED=
# 输出侧敏感值强制 gate 的动作（cmd/gateway/goal_control.go；默认 mask=替换为
# [REDACTED]，=="block" 时整响应拦截。拦截行为无独立 Prometheus 序列，见审计轮）
LLM_GATEWAY_SANITIZE_OUTPUT_ACTION=
# sticky 多级查找调试日志（=="1" 默认关）
STICKY_MULTILEVEL_DEBUG=

# ── 路由评分与压力感知（routing weights / pressure-aware）─────────
# 多目标权重默认值（router_scoring.go）：STICKY 0.15 / COST 0.15 /
# PLANQUOTA 0.10 / BALANCE 0.05 / RECENCY 0.05 / HEADROOM 0.05 /
# CAPACITY 0.02 / IQ 0
LLM_GATEWAY_ROUTING_W_BALANCE=
LLM_GATEWAY_ROUTING_W_CAPACITY=
LLM_GATEWAY_ROUTING_W_COST=
LLM_GATEWAY_ROUTING_W_HEADROOM=
LLM_GATEWAY_ROUTING_W_IQ=
LLM_GATEWAY_ROUTING_W_PLANQUOTA=
LLM_GATEWAY_ROUTING_W_RECENCY=
LLM_GATEWAY_ROUTING_W_STICKY=
# balance 打平水位（默认 5）
LLM_GATEWAY_ROUTING_BALANCE_WATERMARK=
# 成本软顶 $/1M 混合价（默认 30；超过按饱和惩罚）
LLM_GATEWAY_ROUTING_COST_CAP=
# recency 新鲜度视野秒（默认 30）
LLM_GATEWAY_ROUTING_RECENCY_HORIZON_SECONDS=
# 延迟队列放大曲线 p95×(1+α·(p−knee)^β)：ALPHA 1.2 / BETA 1.8 / KNEE 0.6
LLM_GATEWAY_PRESSURE_ALPHA=
LLM_GATEWAY_PRESSURE_BETA=
LLM_GATEWAY_PRESSURE_KNEE=
# headroom 分数指数 (1−p)^γ（默认 1.0）
LLM_GATEWAY_HEADROOM_GAMMA=

# ── ML 路由（onnx 推理，settings/routing_ml_flags.go）─────────────
# 默认：ENABLED false / MIN_CONFIDENCE 0.6 / INTRA_OP_THREADS 1 /
# RELOAD_SECONDS 0（0=不自动热重载）
ROUTING_ML_ENABLED=
ROUTING_ML_MANIFEST_PATH=
ROUTING_ML_MIN_CONFIDENCE=
ROUTING_ML_ORT_LIB_PATH=
ROUTING_ML_INTRA_OP_THREADS=
ROUTING_ML_RELOAD_SECONDS=

# ── V2 子系统门禁（迁移期灰度开关族）──────────────────────────────
# 主二进制读取点 cmd/gateway/main_pipeline.go:174-182：CACHE/SECURITY/
# AUDIT/OBSERV/STREAMING 默认 true；AUTH/ANALYSIS 默认 false
LLM_GATEWAY_V2_AUTH=
LLM_GATEWAY_V2_CACHE=
LLM_GATEWAY_V2_STREAMING=
LLM_GATEWAY_V2_AUDIT=
# 仅 gateway-v2 二进制读取（cmd/gateway-v2/main.go:100，默认 true）
LLM_GATEWAY_V2_SESSION_AUDIT=
LLM_GATEWAY_V2_OBSERV=
LLM_GATEWAY_V2_SECURITY=
LLM_GATEWAY_V2_APPROVAL_GATE=
LLM_GATEWAY_V2_ANALYSIS=
# 批量默认 10 / 间隔默认 5s
LLM_GATEWAY_V2_ANALYSIS_BATCH=
LLM_GATEWAY_V2_ANALYSIS_INTERVAL=

# ── 粘性负载与窗口 ───────────────────────────────────────────────
# 每凭据容量默认 8 / 滑窗默认 300s / 刷新默认 3000ms
LLM_GATEWAY_STICKYLOAD_DEFAULT_CAPACITY=
LLM_GATEWAY_STICKYLOAD_WINDOW_SECONDS=
LLM_GATEWAY_STICKYLOAD_REFRESH_MS=
# 压缩窗口判定默认：50 条 / 空闲 300s / 空闲最少 10 条
LLM_GATEWAY_WINDOW_IDLE_SECONDS=
LLM_GATEWAY_WINDOW_MAX_MSG_COUNT=
LLM_GATEWAY_WINDOW_MIN_IDLE_MSG_COUNT=

# ── live-stream 缓存 / 探测队列 / 提交门 ──────────────────────────
# TTL 默认 4h（admin.LiveStreamLaneRetention）；清理间隔默认随 TTL
LLM_GATEWAY_LIVE_STREAM_CACHED_TTL=
LLM_GATEWAY_LIVE_STREAM_CACHED_CLEANUP_INTERVAL=
# kill-switch：默认开（持久探测队列）；写 0/false/off/no 停用走 legacy 直探
LLM_GATEWAY_PROBE_QUEUE_ENABLED=
# kill-switch：默认开（同步探测 hold）；关闭时 503 立即返回（紧急回滚用）
LLM_GATEWAY_SYNC_NO_CANDIDATE_PROBE=
# Go duration（默认 10s）
LLM_GATEWAY_SYNC_NO_CANDIDATE_TIMEOUT=
# 默认开；MODE: buffered（默认）| immediate
LLM_GATEWAY_ATTEMPT_COMMIT_GATE=
LLM_GATEWAY_ATTEMPT_COMMIT_GATE_MODE=
# 坏候选复活器（bg/broken_probe_reviver.go）：巡检/复活等待均默认 30m（duration）
LLM_GATEWAY_BROKEN_REVIVER_INTERVAL=
LLM_GATEWAY_BROKEN_REVIVE_AFTER=

# ── 资源与自愈监控 ───────────────────────────────────────────────
# 默认：30s / 10000 goroutine / 10MB / 100 fd
LLM_GATEWAY_RESOURCE_MONITOR_INTERVAL=
LLM_GATEWAY_GOROUTINE_THRESHOLD=
LLM_GATEWAY_MEM_GROWTH_THRESHOLD_MB=
LLM_GATEWAY_FD_GROWTH_THRESHOLD=
# DB/Redis 启动重试预算：Go duration 字符串（ParseDuration），裸数字无效。
# 代码默认 DB 20s / Redis 30s；deploy-local 写 90s 兜底蓝绿切流（R37）
LLM_GATEWAY_DB_BOOT_RETRY_SECONDS=90s
LLM_GATEWAY_REDIS_BOOT_RETRY_SECONDS=
# 客户端指纹限流器：容量默认 10000 / 空闲 TTL 默认 30m
LLM_GATEWAY_IDENTITY_LIMITER_MAX_ENTRIES=
LLM_GATEWAY_IDENTITY_LIMITER_IDLE_TTL=

# ── JEV 分类 / 提示缓存 / 遥测兜底 ────────────────────────────────
# ── JEV 分类器（autoroute/classifier_jev.go，fail-open 契约）──────
# 启发式 → 低置信 → JEV；激活值 1/true/yes/on/enabled（不分大小写，默认关）。
# 凭据走 TYPESAFE_API_KEY（见 03），缺失时回退 LLM 分类。
LLM_GATEWAY_JEV_CLASSIFIER=
LLM_GATEWAY_JEV_MODEL=jev-latest
# 秒数（可小数），默认 3s，上限 10s
LLM_GATEWAY_JEV_TIMEOUT=
# 提示缓存：STABILIZE 默认 true / INJECT 默认 false（main.go）
LLM_GATEWAY_PROMPT_CACHE_INJECT=
LLM_GATEWAY_PROMPT_CACHE_STABILIZE=
# DB 降级遥测 ring buffer 容量（默认 10000）
TELEMETRY_FALLBACK_BUFFER_CAP=

# ── 会话审计 / 摘要回填 ──────────────────────────────────────────
# Go duration（默认 15m；如 30s/15m/1h）
SESSION_AUDIT_APPROVAL_TIMEOUT=
# turn-digest 回填 kill-switch：默认 true（opt-out；非 1/true/yes 即关闭）
SESSIONS_V2_DIGEST_BACKFILL_ENABLED=
# 每秒写入上限默认 100 / 每事务批行数默认 100
SESSIONS_V2_DIGEST_BACKFILL_BATCH=
SESSIONS_V2_DIGEST_BACKFILL_RATE=

# ── feature flag 杂项 ────────────────────────────────────────────
# P4 旗标（settings/p4_feature_flags.go）：端点选择器 / Ollama 原生协议，均默认 false
FF_ENDPOINT_SELECTOR=
# ⛔ 不可开启（R72 审计 §3.1）：IR 词表与 ollama executor 门禁的 catalog 词表不匹配，
# 开启后 Ollama 出站全量 501；待 usage 拆分 → ollama.* 命名空间 → tool_calls 接线完成后再开。
FF_OLLAMA_NATIVE=
# autoroute 触发面（Deprecated legacyflags：仅 URSM_V2_MODE=off 回退路径读取）
AUTO_ON_MESSAGES=
AUTO_ON_RESPONSES=
AUTO_ON_EMBEDDINGS=
AUTO_EMBEDDING_ROUTE=
# 候选失败监控巡检间隔（parseDurationEnv 默认 1m；告警参数见 04）
CANDIDATE_FAILURE_MONITOR_INTERVAL=

# ── 版本/配置覆盖 ────────────────────────────────────────────────
# YAML 主配置文件路径（默认搜索路径见 config.go）
LLM_GATEWAY_CONFIG_FILE=
LLM_GATEWAY_VERSION=
LLM_GATEWAY_VERSION_FILE=
LLM_GATEWAY_VERSION_JSON=
