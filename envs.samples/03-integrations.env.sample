# ====================================================================
# 03 · 第三方集成（按启用的集成挑变量，值均为示例值）
# ====================================================================

# ── 认证（Casdoor OIDC）──────────────────────────────────────────
CASDOOR_ENDPOINT=http://127.0.0.1:4800
CASDOOR_CLIENT_ID=example-casdoor-client-id
CASDOOR_CLIENT_SECRET=example-casdoor-client-secret

# ── Memora（向量库会话回写；kxmemory 是唯一写入者，网关走 API 回写）──
# 两项都配置即启用回写
LLM_GATEWAY_MEMORA_BASE_URL=http://127.0.0.1:8000
LLM_GATEWAY_MEMORA_API_KEY=example-memora-ingest-key
# smart search（可选独立端点）
LLM_GATEWAY_MEMORA_SMART_SEARCH_BASE_URL=
LLM_GATEWAY_MEMORA_SMART_SEARCH_API_KEY=
MEMORA_PROJECT_ID=example-project-id

# ── 会话分析模型（可选；OpenAI 兼容 /v1/chat/completions + /v1/embeddings）──
# 同时设置后启用 LLM 请求摘要、rolling summary 与 embedding 聚类；
# 未设置时走规则摘要/聚类，不产生外部模型调用
LLM_GATEWAY_ANALYSIS_BASE_URL=https://analysis-provider.example.com/v1
LLM_GATEWAY_ANALYSIS_API_KEY=sk-analysis-example-0123456789abcdef
# 仅本地 httptest/loopback 开发允许 true；生产必须 false
LLM_GATEWAY_ANALYSIS_ALLOW_INSECURE_LOCAL=false
LLM_GATEWAY_EMBEDDING_MODEL=embedding-fast
LLM_GATEWAY_SA_MODEL_EMBEDDING=

# ── Goal/Autoroute 共用 LLM 端点（OpenAI 兼容；留空则 LLM 判定降级 no-op）──
LLMGatewayAutoLLMEndpoint=https://llmgateway.example.com/v1
LLMGatewayAutoLLMApiKey=sk-auto-example-0123456789abcdef
LLMGatewayAutoLLMModel=gpt-4o-mini
LLMGatewayAutoLLMTimeout=15
# Handoff 摘要降级端点（可选）
LLM_GATEWAY_HANDOFF_FALLBACK_API_KEY=

# ── Gateway → ASM durable outbox（两项都配置 dispatcher 才启动）────
ASM_INTERNAL_ENDPOINT=http://127.0.0.1:8080/internal/v1/events
AI_SESSION_MANAGER_GATEWAY_EVENT_SECRET=example-asm-event-secret
# 可选节拍：Go duration / 正整数（默认 5s / 5 / 10s）
OUTBOX_POLL_INTERVAL=5s
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_HTTP_TIMEOUT=10s
OUTBOX_HMAC_SECRET=example-outbox-hmac-secret

# ── maintain（插件权益门禁查询服务）───────────────────────────────
MAINTAIN_SERVICE_URL=http://127.0.0.1:8090
# maintain web 静态资源目录（开发联调时覆盖）
MAINTAIN_WEB_DIST=

# ── ACC Runtime（hosted task delegation 用，见 02 总开关）──────────
LLM_GATEWAY_ACC_BASE_URL=http://127.0.0.1:4101
# Bearer 须含 sub+tenant_id claim
LLM_GATEWAY_ACC_SERVICE_TOKEN=example-acc-service-token
# agent-companion 注册的 runtime_id
LLM_GATEWAY_ACC_RUNTIME_ID=example-runtime-id
LLM_GATEWAY_ACC_PROJECT_TENANT=
LLM_GATEWAY_ACC_PROJECT_SYNC_INTERVAL=
LLM_GATEWAY_ACC_WORK_TYPE_SYNC_INTERVAL=

# ── 会话取证（session forensics，可选）────────────────────────────
SESSION_FORENSICS_BASE_URL=
SESSION_FORENSICS_BEARER=

# ── License / 注册中心（installer 与运行时共用）────────────────────
# 首次激活与注册中心地址（默认 https://llmgateway.internal.example.com）
LLM_GATEWAY_CENTER_URL=https://llm.example-center.com
LLM_GATEWAY_MASTER_URL=https://llm.example-center.com
# license 签发密钥（仅自建 license authority 时需要）
LLM_GATEWAY_LICENSE_PRIVATE_KEY=
LLM_GATEWAY_LICENSE_PUBLIC_KEY=
LLM_GATEWAY_LICENSE_AES_KEY=
LLM_GATEWAY_LICENSE_DATA_DIR=
LLM_GATEWAY_LICENSE_ACTIVATED=
# license authority 服务端（licensing 子系统）
LICENSE_AUTHORITY_URL=
LICENSE_AUTHORITY_ADMIN_TOKEN=
LICENSE_AUTHORITY_SMTP_HOST=
LICENSE_AUTHORITY_SMTP_PORT=
LICENSE_AUTHORITY_SMTP_USER=
LICENSE_AUTHORITY_SMTP_PASS=
LICENSE_AUTHORITY_SMTP_FROM=
LICENSE_AUTHORITY_SMTP_USE_TLS=

# ── 可观测性导出（OTLP，可选）─────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# ── keyring（多密钥轮转，可选）────────────────────────────────────
KEYRING_CURRENT_KID=
KEYRING_JSON=

# ── 环境变量注入器（部署工具用；SOPS 解密）────────────────────────
# age 私钥路径（默认 ~/.config/sops/age/keys.txt）
# SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt
