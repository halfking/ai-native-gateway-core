{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.example.com/schemas/gateway-events-v1.json",
  "title": "Gateway Outbox Event Schema",
  "description": "llm-gateway-go durable outbox → ai-session-manager /internal/v1/events 事件契约 v1",
  "definitions": {
    "EventEnvelope": {
      "type": "object",
      "required": ["event_id", "schema_version", "event_type", "tenant_id", "occurred_at"],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt-[a-zA-Z0-9_-]+$",
          "description": "全局唯一事件 ID，用于幂等"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0",
          "description": "事件 schema 版本"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "request.completed.v1",
            "request.failed.v1",
            "session.opened.v1",
            "session.updated.v1",
            "session.deleted.v1"
          ],
          "description": "事件类型"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "description": "租户 ID"
        },
        "session_id": {
          "type": "string",
          "description": "会话 ID（非 session.opened 时必需）"
        },
        "request_id": {
          "type": "string",
          "description": "请求 ID（request.* 事件必需）"
        },
        "correlation_id": {
          "type": "string",
          "description": "跨系统关联 ID"
        },
        "source_system": {
          "type": "string",
          "enum": ["acc", "redclaw", "memora", "pocket", "gateway"],
          "description": "调用方系统"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "事件发生时间（RFC3339 UTC）"
        },
        "payload": {
          "type": "object",
          "description": "事件载荷，schema 由 event_type 决定"
        }
      }
    },
    "RequestCompletedPayload": {
      "type": "object",
      "required": ["model", "provider", "input_tokens", "output_tokens", "cost_usd", "latency_ms", "status"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "成本，字符串格式避免浮点精度问题"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": ["success", "error"]
        },
        "error_code": {
          "type": "string",
          "description": "status=error 时必需"
        },
        "task_id": {
          "type": "string",
          "description": "关联任务 ID（可选）"
        },
        "run_id": {
          "type": "string",
          "description": "关联运行 ID（可选）"
        },
        "dispatch_id": {
          "type": "string",
          "description": "关联分发 ID（可选）"
        },
        "agent_id": {
          "type": "string",
          "description": "关联智能体 ID（可选）"
        },
        "project_id": {
          "type": "string",
          "description": "关联项目 ID（可选）"
        },
        "user_id": {
          "type": "string",
          "description": "用户 ID（可选）"
        }
      }
    },
    "RequestFailedPayload": {
      "type": "object",
      "required": ["model", "provider", "error_code", "error_message"],
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "error_message": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      }
    },
    "SessionOpenedPayload": {
      "type": "object",
      "required": ["session_id", "user_id"],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "source_system": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "SessionUpdatedPayload": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "SessionDeletedPayload": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DeliveryRequest": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/EventEnvelope"
          },
          "description": "批量事件（1-100）"
        }
      }
    },
    "DeliveryResponse": {
      "type": "object",
      "required": ["data", "request_id"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["accepted", "duplicates"],
          "properties": {
            "accepted": {
              "type": "integer",
              "minimum": 0,
              "description": "接受数量"
            },
            "duplicates": {
              "type": "integer",
              "minimum": 0,
              "description": "重复数量"
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["event_id", "code", "message"],
                "properties": {
                  "event_id": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              },
              "description": "失败项"
            }
          }
        },
        "request_id": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "event_type": {"const": "request.completed.v1"},
        "payload": {"$ref": "#/definitions/RequestCompletedPayload"}
      }
    },
    {
      "properties": {
        "event_type": {"const": "request.failed.v1"},
        "payload": {"$ref": "#/definitions/RequestFailedPayload"}
      }
    },
    {
      "properties": {
        "event_type": {"const": "session.opened.v1"},
        "payload": {"$ref": "#/definitions/SessionOpenedPayload"}
      }
    },
    {
      "properties": {
        "event_type": {"const": "session.updated.v1"},
        "payload": {"$ref": "#/definitions/SessionUpdatedPayload"}
      }
    },
    {
      "properties": {
        "event_type": {"const": "session.deleted.v1"},
        "payload": {"$ref": "#/definitions/SessionDeletedPayload"}
      }
    }
  ]
}
