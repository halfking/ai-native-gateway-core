[Unit]
Description=LLM Gateway Go (245 pre-prod · llmgo.kxpms.cn · e37f7a8c)
Documentation=https://llm.kxpms.cn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/llm-gateway-go
EnvironmentFile=/opt/llm-gateway-go/.env
# 2026-08-04 (spec §10.4.1): IR as default protocol conversion path.
# Emergency rollback: change to "false" in /opt/llm-gateway-go/.env.
Environment=TRANSPORT_LAYER_IR_ENABLED=true
ExecStart=/opt/llm-gateway-go/gateway
Restart=always
RestartSec=5
StandardOutput=append:/var/log/llm-gateway-go/gateway.stdout.log
StandardError=append:/var/log/llm-gateway-go/gateway.stderr.log

# 2026-07-16: 更短的 stop 超时 — Go srv.Shutdown 内部 30s drain,
# 25s 给 systemd 等信号, 然后 SIGKILL. 默认 90s 太长, restart 期间
# :8781 一直 unbound, nginx 拿 connection refused.
TimeoutStopSec=25s
KillSignal=SIGTERM

# drain 标记: 部署脚本读这个文件判断旧实例是否已退出.
ExecStopPost=/bin/sh -c 'date +%s > /var/run/llm-gateway-go.drained 2>/dev/null || true'

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# 资源限制
LimitNOFILE=65536
LimitNPROC=32768

[Install]
WantedBy=multi-user.target