[Unit]
Description=LLM Gateway Go (245 pre-prod · llmgo.kxpms.cn · e37f7a8c)
Documentation=https://llm.kxpms.cn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/llm-gateway-go
EnvironmentFile=/opt/llm-gateway-go/.env
# 2026-08-04 (spec §10.4.1): IR as default protocol conversion path.
# Emergency rollback: change to "false" in /opt/llm-gateway-go/.env.
Environment=TRANSPORT_LAYER_IR_ENABLED=true
# 2026-08-24: GC 背压 — 245 memcg OOM-kill x53（anon 1.95G 撑满 MemoryMax=2G,
# failcnt 378 万）。GOMEMLIMIT 略低于 cgroup 上限, 让 Go GC 在 memcg
# 击杀之前先自我回收。配合 memory-override.conf 的 MemoryHigh/MemoryMax
# （服务端 drop-in）与 LLM_GATEWAY_MAX_PROMPT_TOKENS 入口拒绝三层防线。
Environment=GOMEMLIMIT=1900MiB
ExecStart=/opt/llm-gateway-go/gateway
Restart=always
RestartSec=5
StandardOutput=append:/var/log/llm-gateway-go/gateway.stdout.log
StandardError=append:/var/log/llm-gateway-go/gateway.stderr.log

# 2026-07-16: 更短的 stop 超时 — ★★ 2026-11-17（订正 + 根修）：本单元此前写
# 25s，而它自己的注释写着「Go srv.Shutdown 内部 30s drain」——**25 < 30 ⇒
# 单元按自己的注释就是自相矛盾** ⇒ systemd 在应用排空完成前 SIGKILL ⇒
# 在途的 SSE / 流式请求被硬切 ⇒ nginx 回 502（llm.itestu.cn 的 502 根因之一；
# 211 蓝绿侧同型根因见 scripts/deploy-seamless-docker.sh 的 DD_STOP_TIMEOUT，
# 两侧由 tests/deploy_stop_budget_test.sh 对拍）。
#   ⇒ 现在按应用侧**可对拍**的预算定：36s（注销 3 + mock probe drain 5 +
#     srv.Shutdown 23 + worker stop 5，见 cmd/gateway/shutdown_budget.go 的
#     shutdownWorstCaseBudget）+ 9s 余量 = 45s。
#   「默认 90s 太长」的顾虑仍成立，但那条针对的是**无界**停机；这里 45s 是
#   **有界**预算（应用侧每段都带 ctx 上限）。
#   ★ 残余代价（如实登记，不藏）：本单元是**单实例**形态 ⇒ SIGTERM 到达后
#     srv.Shutdown **立刻关 listener** ⇒ 停机窗口内的新请求 connection
#     refused（单实例形态的固有代价，非本次引入）。蓝绿形态（211/245/252）
#     没有这个窗口：nginx 早已切到新槽，旧槽排空零代价。
TimeoutStopSec=45s
KillSignal=SIGTERM

# drain 标记: 部署脚本读这个文件判断旧实例是否已退出.
ExecStopPost=/bin/sh -c 'date +%s > /var/run/llm-gateway-go.drained 2>/dev/null || true'

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# 资源限制
LimitNOFILE=65536
LimitNPROC=32768

[Install]
WantedBy=multi-user.target
