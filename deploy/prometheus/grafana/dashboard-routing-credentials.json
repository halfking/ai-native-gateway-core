{
  "dashboard": {
    "title": "LLM Gateway - 路由凭据状态机监控",
    "tags": ["llm-gateway", "routing", "credential-state"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Admin Reset 按环节（surface × result）",
        "description": "admin 端点（emergency-repair force_enable / reset-state）触发的凭据状态复位。result=error 为 500 类失败；surface=lookup/result=not_found 为 404（凭据 id 不存在）。",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(llmgw_routing_credential_reset_total[5m])",
            "legendFormat": "{{surface}} - {{result}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Resets/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Reset 404 vs 500（近 1h）",
        "description": "404（not_found，操作员敲错 ID）与 500（error，链路故障）的分野。404 高不说明系统故障；500 高说明 reset 链路有问题。",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(llmgw_routing_credential_reset_total{surface=\"lookup\",result=\"not_found\"}[1h]))",
            "legendFormat": "404 not_found",
            "refId": "A"
          },
          {
            "expr": "sum(increase(llmgw_routing_credential_reset_total{result=\"error\"}[1h]))",
            "legendFormat": "500 error",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 20, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Priority 选择分布（近 1h）",
        "description": "planCandidates 结束时的首选候选分类：priority_only=优先桶拿到首选；spillover_to_non_priority=有优先候选但首选是标准候选；no_priority_candidates=池内无优先候选（基线）。",
        "type": "piechart",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "sum by (outcome) (increase(llmgw_routing_priority_candidates_selected_total[1h]))",
            "legendFormat": "{{outcome}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "credential_recovery 30s tick 恢复结果（sql_kind × outcome）",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(llmgw_routing_credential_recovery_total[5m])",
            "legendFormat": "{{sql_kind}} - {{outcome}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Rows/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "恢复 Tick 耗时",
        "description": "credential_recovery 单次完整 tick 的墙钟耗时（gauge）。持续接近或超过 30s 周期意味着 tick 开始重叠。",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "llmgw_routing_credential_recovery_tick_duration_seconds",
            "legendFormat": "recovery tick",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "health_auto_recover 1min tick",
        "type": "graph",
        "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "increase(llmgw_routing_health_auto_recover_total[5m])",
            "legendFormat": "{{outcome}}",
            "refId": "A"
          },
          {
            "expr": "llmgw_routing_health_auto_recover_tick_duration_seconds",
            "legendFormat": "tick duration (s)",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Ticks / Seconds"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "主动自检（autoheal）提交结果",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(llmgw_routing_auto_heal_submit_total[5m])",
            "legendFormat": "{{outcome}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Submits/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "全员冷却降级触发（近 24h）",
        "description": "router 在所有候选都冷却时被迫选最浅冷却候选的次数。任何非零都值得排查。",
        "type": "stat",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (reason) (increase(llmgw_routing_cooling_fallback_total[24h]))",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        }
      }
    ]
  }
}
