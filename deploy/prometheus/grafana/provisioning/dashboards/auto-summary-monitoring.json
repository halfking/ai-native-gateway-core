{
  "dashboard": {
    "title": "LLM Gateway - Auto Title / Summary 监控",
    "tags": ["llm-gateway", "auto-summary", "auto-title", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "description": "auto_title_* / auto_summary_* metrics. NOTE: these metrics use a non-standard prefix (the llm-gateway convention is llm_gateway_*). The intentional deviation is documented in metrics/auto_summary_metrics.go and the 2026-08-06 changelog.",
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Auto-Summary 触发速率 (按 result)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum by (result) (rate(auto_summary_trigger_total[5m]))",
            "legendFormat": "{{result}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "triggers/sec"},
          {"format": "short"}
        ],
        "description": "rate(5m). result ∈ {ok, error, rate_limited, saturated, db_error}. Spikes in non-ok results indicate trouble."
      },
      {
        "id": 2,
        "title": "Auto-Title 触发速率 (按 result)",
        "type": "graph",
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum by (result) (rate(auto_title_trigger_total[5m]))",
            "legendFormat": "{{result}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "triggers/sec"},
          {"format": "short"}
        ],
        "description": "rate(5m). result ∈ {ok, error}. error > 0 over a long window means title generation is broken."
      },
      {
        "id": 3,
        "title": "Auto-Summary 失败占比 (last 1h)",
        "type": "stat",
        "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(auto_summary_trigger_total{result!=\"ok\"}[1h])) / sum(increase(auto_summary_trigger_total[1h]))",
            "legendFormat": "failure ratio",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.05},
                {"color": "red", "value": 0.15}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
        },
        "description": "Healthy: <5%. Alert at 15% sustained. Includes rate_limited / saturated / db_error / error as 'failure'."
      },
      {
        "id": 11,
        "title": "Auto-Title 短消息豁免占比 (last 1h)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 40, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "(sum(increase(auto_title_trigger_total{result=\"short_user_message\"}[1h])) / clamp_min(sum(increase(auto_title_trigger_total[1h])), 1)) or vector(0)",
            "legendFormat": "short user message ratio",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": null}
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
        },
        "description": "The share of first-turn auto-title decisions skipped because the last user message already fits the title rune budget. A zero value may mean no first-turn title attempts occurred in the window."
      },
      {
        "id": 4,
        "title": "Auto-Summary LLM 调用延迟 (P50/P95/P99, by mode)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(auto_summary_llm_latency_seconds_bucket[5m])))",
            "legendFormat": "P50 - {{mode}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(auto_summary_llm_latency_seconds_bucket[5m])))",
            "legendFormat": "P95 - {{mode}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le, mode) (rate(auto_summary_llm_latency_seconds_bucket[5m])))",
            "legendFormat": "P99 - {{mode}}",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ],
        "description": "mode ∈ {summary, map, reduce}. reduce should be ~3-5x summary; map similar to summary."
      },
      {
        "id": 5,
        "title": "Auto-Title LLM 调用延迟 (P50/P95/P99)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(auto_title_llm_latency_seconds_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(auto_title_llm_latency_seconds_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(auto_title_llm_latency_seconds_bucket[5m]))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ],
        "description": "Expected: P99 ≤ 30s (timeout = 30s). P99 > 30s means we're hitting the timeout — bump budget or check upstream."
      },
      {
        "id": 6,
        "title": "Auto-Summary LLM 调用结果 (按 mode × result 堆叠)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (mode, result) (rate(auto_summary_llm_call_total[5m]))",
            "legendFormat": "{{mode}} - {{result}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "calls/sec"},
          {"format": "short"}
        ],
        "stack": true,
        "description": "Stacked area chart. non-ok results cluster at the top. result ∈ {ok, transient_retry, error, invalid_response}."
      },
      {
        "id": 7,
        "title": "Auto-Summary 闸门跳过原因",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (reason) (rate(auto_summary_gate_skip_total[5m]))",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "skips/sec"},
          {"format": "short"}
        ],
        "description": "reason values: never_summarized, rolling_gate_open, only_N_new_turns_since_last_summary, db_error. Healthy sessions show mostly 'only_N_new_turns' (the rolling gate working)."
      },
      {
        "id": 8,
        "title": "Map-Reduce 部分失败 (per hour)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "increase(auto_summary_map_reduce_partial_fail_total[1h])",
            "legendFormat": "partial fails / 1h",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "partial failures"},
          {"format": "short"}
        ],
        "description": "Non-zero sustained means an upstream provider is flaky. Map-reduce falls back to whatever partials succeeded; non-zero is degraded but not fatal."
      },
      {
        "id": 9,
        "title": "Map-Reduce chunk 分布 (last 5m)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (le) (rate(auto_summary_chunks_bucket[5m]))",
            "legendFormat": "≤ {{le}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "observations/sec"},
          {"format": "short"}
        ],
        "description": "Cumulative histogram. Most observations should land at 1 (single-shot) or 2-5 (typical map-reduce). Long tails (≥13) indicate very long sessions — verify auto_summary.map_reduce_threshold."
      },
      {
        "id": 10,
        "title": "Last-hour Auto-Summary 健康概览",
        "type": "table",
        "gridPos": {"x": 0, "y": 32, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "sum by (result) (increase(auto_summary_trigger_total[1h]))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true
        },
        "description": "Per-result trigger counts in the last 1h. ok should grow steadily; non-ok should be flat or 0. If 'saturated' or 'rate_limited' grow, you're hitting resource caps — bump worker_slots / rate_per_min (requires restart)."
      }
    ]
  }
}