# Phase 0 本地部署配置

## 环境变量

# Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=admin123

# 飞书 Webhook URL（可选，用于告警通知）
# 获取方式：在飞书群创建自定义机器人，复制 Webhook URL
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR-WEBHOOK-ID

# credential-team oncall webhook（credential-17 告警专用，强烈建议设置）
# alertmanager 会把 component=credential 的告警（severity critical/warning）
# 路由到 credential-team receiver 并 POST 到该地址。不设置时 webhook 保持
# https://placeholder.invalid 占位——派发会 loud-fail（设计内行为，说明"请配置我"）。
# 2026-08-18 起 245 原生部署的注入位置：/opt/monitoring/alertmanager/webhook.env
CREDENTIAL_TEAM_WEBHOOK_URL=https://your-credential-team-oncall.example/hook

# PostgreSQL 连接信息（用于监控数据库）
# 2026-09-07: llm-gateway-pg 容器的唯一登录角色是 llm_gateway，不是 postgres。
# 部署前请把 POSTGRES_PASSWORD 替换为 LLM_GATEWAY_PG_PASSWORD 的实际值（参见
# /Users/xutaohuang/kaixuan/postgres/run/llm-gateway-pg.env）。
POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://llm_gateway:${POSTGRES_PASSWORD}@llm-gateway-pg:5432/llm_gateway?sslmode=disable

# 2026-09-25 R65 补登：llm-gateway-go 服务容器（docker-compose.yml 的
# LLM_GATEWAY_DATABASE_URL）所需的 6 个 PG 变量——1c0c200be 把该 DSN
# 参数化时未同步本模板，按模板 up 起的服务容器会拿到 postgres://:@... 连库失败。
# 下方取值与 compose 默认一致（PG_HOST 默认指向 252 共享 PG 的网络别名
# pg-252-pg17；本地栈部署时改成 llm-gateway-pg）。
PG_USER=llm_gateway
PG_PASSWORD=replace-with-llm-gateway-pg-password
PG_HOST=pg-252-pg17
PG_PORT=5432
PG_DB=llm_gateway
PG_SSLMODE=disable
