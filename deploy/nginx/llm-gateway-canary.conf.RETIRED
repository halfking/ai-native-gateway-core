# ============================================================================
# File: deploy/nginx/llm-gateway-canary.conf
# Purpose: Canary deployment traffic control for LLM Gateway optimization
# Target: 252 Server (192.168.1.252) - Frontend proxy
# Reference: AUDIT_V2 A4 fix
# ============================================================================

# Canary upstream with weight-based traffic splitting
upstream llm_gateway_canary {
    # Old version (184 server) - adjust weight for traffic percentage
    # Week 1: weight=9 (90% traffic)
    # Week 2: weight=5 (50% traffic)
    # Week 3: weight=0 (0% traffic, full migration to 71)
    server 192.168.1.184:8781 weight=9 max_fails=3 fail_timeout=30s;
    
    # New version (71 server) - optimization code
    # Week 1: weight=1 (10% traffic)
    # Week 2: weight=5 (50% traffic)
    # Week 3: weight=10 (100% traffic)
    server 192.168.1.71:8781  weight=1 max_fails=3 fail_timeout=30s;
    
    # Connection pooling
    keepalive 64;
    keepalive_timeout 90s;
    keepalive_requests 1000;
}

# Main server block for LLM Gateway
server {
    listen 80;
    server_name llm-gateway.internal;
    
    # Health check endpoint (bypass canary)
    location = /healthz {
        proxy_pass http://192.168.1.184:8781/healthz;
        access_log off;
    }
    
    # Metrics endpoint (bypass canary, monitor both)
    location = /metrics {
        proxy_pass http://192.168.1.184:8781/metrics;
        access_log off;
    }
    
    # Main API routes (canary-enabled)
    location /v1/ {
        proxy_pass http://llm_gateway_canary;
        
        # HTTP/1.1 with keep-alive
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        
        # Preserve original request info
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Add canary tracking header (for debugging)
        add_header X-Canary-Backend $upstream_addr always;
        
        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        
        # Buffering (disabled for streaming)
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Error handling
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }
    
    # Admin routes (always to stable 184)
    location /admin/ {
        proxy_pass http://192.168.1.184:8781;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
    
    # Access log with upstream tracking
    access_log /var/log/nginx/llm-gateway-canary-access.log combined;
    error_log /var/log/nginx/llm-gateway-canary-error.log warn;
}

# ============================================================================
# Deployment Instructions
# ============================================================================
#
# 1. Deploy to 252 server:
#    scp deploy/nginx/llm-gateway-canary.conf root@192.168.1.252:/etc/nginx/conf.d/
#
# 2. Test configuration:
#    ssh root@192.168.1.252 "nginx -t"
#
# 3. Reload Nginx:
#    ssh root@192.168.1.252 "systemctl reload nginx"
#
# 4. Verify traffic split:
#    for i in {1..100}; do curl -s http://llm-gateway.internal/healthz -I | grep X-Canary; done | sort | uniq -c
#
# 5. Adjust canary percentage (Week 2):
#    Edit weights: 184:weight=5, 71:weight=5
#    Reload: systemctl reload nginx
#
# 6. Full migration (Week 3):
#    Edit weights: 184:weight=0, 71:weight=10
#    Reload: systemctl reload nginx
#
# 7. Rollback (if needed):
#    Edit weights: 184:weight=10, 71:weight=0
#    Reload: systemctl reload nginx (< 1 second downtime)
#
