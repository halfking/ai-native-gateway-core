# ============================================================================
# 252 unified gateway for kxpms.cn domains (Deployed 2026-07-08)
# Architecture:
#   - 252 is the unified SSL termination point for *.kxpms.cn
#   - Each domain proxies to its 154 backend via HTTP (internal network)
#   - certbot manages kxpms.cn SSL cert at /etc/letsencrypt/live/kxpms.cn
#   - 154 has its own nginx for direct-access mode (fallback)
#
# Domains & backends:
#   www.kxpms.cn    → 172.16.2.209:12009 (154 SPA static + api reverse proxy)
#   llm.kxpms.cn    → 172.16.2.241:8781  (154 llm-gateway-go native)
#   auth.kxpms.cn   → 172.16.2.209:8000  (154 casdoor-server native)
#   kxpms.cn        → 302 → www.kxpms.cn
#
# Cert topology (verified & updated 2026-08-15):
#   - kxpms.cn + llm.kxpms.cn share ONE cert: /etc/letsencrypt/live/kxpms.cn
#     (SAN: kxpms.cn, llm.kxpms.cn; renewed on 252 via certbot-renew.timer,
#     webroot /var/www/certbot HTTP-01).
#   - 154 keeps a mirror synced by /etc/letsencrypt/renewal-hooks/deploy/sync-to-154.sh
#     (runs natively on every successful renewal; NOT via $DEPLOY_HOOK in sysconfig).
#     Both 252 and 154 serve llm.kxpms.cn with the same cert → flip DNS at will.
#   - legacy /etc/nps/conf/certs/hosts/llm.kxpms.cn path no longer exists (removed).
# ============================================================================

upstream kxpms_www_backend {
    server 172.16.2.209:443 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream kxpms_memora_backend {
    server 172.16.2.209:9001 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream kxpms_maintain_backend {
    server 172.16.2.241:8082 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

upstream kxpms_llm_backend {
    server 172.16.2.209:8781 max_fails=2 fail_timeout=5s;
    keepalive 32;
    # 2026-08-21: Add 245 (172.16.2.241:8781) as backup gateway.
    # 245 is llmgo.kxpms.cn pre-prod (release e37f7a8c). When 154 gateway
    # fails (max_fails=2 fail_timeout=30s), nginx auto-shifts traffic here.
    server 172.16.2.241:8781 max_fails=2 fail_timeout=30s backup;

}

upstream kxpms_license_authority {
    server 172.16.2.209:8443 max_fails=3 fail_timeout=10s;
    keepalive 8;
}


upstream kxpms_auth_backend {
    server 172.16.2.209:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}


# HTTP :80 — ACME challenge + redirect to HTTPS
server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 80;
    listen [::]:80;
    # Expanded 2026-08-20: include all *.kxpms.cn subdomains that resolve to
    # 252 public IP (115.29.212.252). This makes ACME HTTP-01 challenges go to
    # the local webroot directly, instead of falling through to the regex
    # catch-all block below (which proxies to 154, where only llm.kxpms.cn
    # has a working ACME endpoint).
    server_name kxpms.cn www.kxpms.cn llm.kxpms.cn auth.kxpms.cn memora.kxpms.cn
                ai.kxpms.cn nexus.kxpms.cn nbjl.kxpms.cn
                acc.kxpms.cn m.kxpms.cn m-api.kxpms.cn
                finance.kxpms.cn doc-tools.kxpms.cn mcp.kxpms.cn
                bidding.kxpms.cn crm.kxpms.cn dashboard.kxpms.cn
                fmail.kxpms.cn geo.kxpms.cn geoflow.kxpms.cn
                marketing.kxpms.cn public-kb.kxpms.cn quotation.kxpms.cn
                trendaradar.kxpms.cn;

    # HTTP-01 ACME challenge — serve from local webroot (proven pattern, used
    # for *.itestu.cn certs). Certbot writes tokens here during renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Everything else → HTTPS redirect
    location / {
        return 301 https://$host$request_uri;
    }
    # Sensitive file blocking (hardened 2026-07-08)
    location ~ /\.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
    location ~ /\.(env|envrc|env\.local|env\.production|env\.development)$ { deny all; return 404; }
    location ~* (^|/)(wp-config|wp-settings|web\.config|composer\.json|composer\.lock|\.npmrc|\.docker/|\.git/|\.ssh/|\.aws/|Procfile|README\.md)$ { deny all; return 404; }
    location ~* (^|/)(database\.yml|secrets\.yml|\.htpasswd|credentials\.json|service-account.*\.json|\.kube/config)$ { deny all; return 404; }
    # Exploit pattern blocking
    location ~* (union.*select|select.*from|concat.*char|<script|javascript:|onerror=|onload=) { return 444; }
}


# HTTPS :9443 — memora.kxpms.cn
server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 9443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    server_name memora.kxpms.cn;
    ssl_certificate     /etc/letsencrypt/live/kxpms.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kxpms.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 100m;
    keepalive_timeout 300s;

    access_log /var/log/nginx/memora-252-access.log;
    error_log  /var/log/nginx/memora-252-error.log;

    location / {
        proxy_pass http://kxpms_memora_backend;
        proxy_set_header Host memora.kxpms.cn;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://kxpms_memora_backend;
        proxy_set_header Host memora.kxpms.cn;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location /api/chat/ {
        proxy_pass http://kxpms_memora_backend;
        proxy_set_header Host memora.kxpms.cn;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location ~ /.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
}
