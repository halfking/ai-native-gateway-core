server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 9443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    server_name llm.kxpms.cn;
    # Allow brand fonts for guest landing (Outfit / Noto Sans SC)
    proxy_hide_header Content-Security-Policy;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;


    # Cert managed by certbot at /etc/letsencrypt/live/kxpms.cn/ (auto-renewed on 252
    # via certbot-renew.timer). 154 keeps its own mirror via the deploy hook
    # /etc/letsencrypt/renewal-hooks/deploy/sync-to-154.sh.
    ssl_certificate     /etc/letsencrypt/live/kxpms.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kxpms.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL_kxpms_llm:10m;
    ssl_session_timeout 10m;
    client_max_body_size 100M;

    access_log /var/log/nginx/kxpms-cn-llm-access.log;
    error_log /var/log/nginx/kxpms-cn-llm-error.log;

    # LLM Gateway long-timeout (AI reasoning/thinking SSE)
    proxy_buffering off;
    proxy_cache off;

# --- license-authority /api/v1 (managed) ---
    location ^~ /api/v1/ {
        proxy_pass http://kxpms_license_authority;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }


    # ---- ai-native-maintain same-origin wiring (2026-07-20) ----
    location = /maintain-api/healthz {
        proxy_pass http://kxpms_maintain_backend/healthz;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /maintain-api/readyz {
        proxy_pass http://kxpms_maintain_backend/readyz;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /maintain-api/ {
        proxy_pass http://kxpms_maintain_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Tenant-ID "";
        proxy_connect_timeout 30s;
        proxy_read_timeout 300s;
    }

    location ^~ /artifacts/ {
        proxy_pass http://kxpms_maintain_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /maintain/ {
        root /opt/ai-native-maintain/web;
        try_files $uri $uri/ /maintain/index.html;
        add_header Cache-Control "no-cache";
    }
    location = /maintain { return 302 /maintain/home; }

    absolute_redirect off;
    location = /download { return 302 /maintain/download$is_args$args; }
    location = /support { return 302 /maintain/support$is_args$args; }
    location = /offline-activation { return 302 /maintain/offline-activation$is_args$args; }
    location = /activate { return 302 /maintain/activate$is_args$args; }
    location = /public/download { return 302 /maintain/download$is_args$args; }
    location = /public/support { return 302 /maintain/support$is_args$args; }
    location = /public/feedback { return 302 /maintain/feedback$is_args$args; }
    location = /public/offline-activation { return 302 /maintain/offline-activation$is_args$args; }
    location = /setup { return 302 /maintain/setup$is_args$args; }


    # Product intro → Maintain home. Gateway login entry: /?login=*
    location = / {
        error_page 418 = @llm_gateway_root;
        if ($arg_login != "") { return 418; }
        return 302 /maintain/home;
    }
    location @llm_gateway_root {
        proxy_pass http://kxpms_llm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 1200s;
    }

    # 2026-07-23: Gateway 菜单配置静态文件（供 Maintain 动态加载）
    # 252 本地服务，避免上游 Gateway 应用 SPA fallback
    location = /menu-config.json {
        root /opt;
        add_header Cache-Control "public, max-age=300" always;
        add_header Content-Type "application/json" always;
        access_log off;
    }

    # 2026-07-23: ai-session-manager plugin healthz（用于 Maintain 端 plugin 探测）
    location ^~ /plugins/ai-session-manager/healthz {
        default_type application/json;
        return 200 '{"status":"ok","plugin":"ai-session-manager","timestamp":"$arg_t"}';
    }

    # 2026-08-21: SPA fallback for llm-gateway-go web SPA paths (/dashboard, /keys, ...).
    # Root cause of 401 missing_key on /dashboard: this catch-all proxied SPA paths
    # to llm-gateway-go gateway (kxpms_llm_backend = 172.16.2.209:8781) which has a
    # global AuthMiddleware that bypasses only /api/, /healthz, /metrics, /. Now serve
    # SPA via 154 nginx (which was patched 2026-08-21 to serve /opt/llm-gateway-go/current/web).
    # Higher-priority ^~ and = locations already match /api/v1/, /maintain-api/,
    # /artifacts/, /maintain/, /menu-config.json, /plugins/, /api/admin/ etc., so
    # behavior for those routes is preserved.
    location / {
        try_files $uri $uri/ @llm_spa_154;
    }
    location @llm_spa_154 {
        proxy_pass https://172.16.2.209:443;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 30s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        proxy_buffering off;
        proxy_cache off;
    }

    # Admin API
    location /api/admin/ {
        proxy_pass http://kxpms_llm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    # Sensitive file blocking (hardened 2026-07-08)
    location ~ /\.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
    location ~ /\.(env|envrc|env\.local|env\.production|env\.development)$ { deny all; return 404; }
    location ~* (^|/)(wp-config|wp-settings|web\.config|composer\.json|composer\.lock|\.npmrc|\.docker/|\.git/|\.ssh/|\.aws/|Procfile|README\.md)$ { deny all; return 404; }
    location ~* (^|/)(database\.yml|secrets\.yml|\.htpasswd|credentials\.json|service-account.*\.json|\.kube/config)$ { deny all; return 404; }
    # Exploit pattern blocking
    location ~* (union.*select|select.*from|concat.*char|<script|javascript:|onerror=|onload=) { return 444; }
}

