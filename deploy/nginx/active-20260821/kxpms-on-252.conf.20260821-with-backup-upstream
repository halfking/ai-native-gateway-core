# ============================================================================
# HTTP :80 — ACME challenge proxy for *.kxpms.cn (2026-07-11)
# 252 is now the public ingress for *.kxpms.cn (DNS flipped to 115.29.212.252).
# But certbot is on 154 and renews there using HTTP-01.
# This block proxies /.well-known/acme-challenge/ for any *.kxpms.cn host back
# to 154 (172.16.2.209:80) so the renewal challenge can reach the 154 webroot.
# All non-challenge requests fall through to the 301->HTTPS redirect.
# ============================================================================
upstream kxpms_acme_154_backend {
    server 172.16.2.209:80 max_fails=2 fail_timeout=5s;
    keepalive 8;
}

server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;

    # Bind to :80 explicitly but don't set server_name so we can use regex
    # matching on the Host header to catch any *.kxpms.cn (or kxpms.cn) that
    # doesn't have its own server block on 252.
    listen 80;
    listen [::]:80;

    # Use regex to match ALL *.kxpms.cn subdomains + the bare domain.
    # Host header captured into $kxpms_host for proxying.
    server_name ~^(?<kxpms_host>(?:[^.]+\.)?kxpms\.cn)$;

    # Only allow ACME challenge path; everything else -> HTTPS redirect.
    # FIX (2026-08-20): Read ACME token from LOCAL /var/www/certbot instead of
    # proxying to 154. Reason: 154 only serves /.well-known/acme-challenge/ for
    # llm.kxpms.cn; the other *.kxpms.cn subdomains had no token on 154 → 502
    # when certbot tried to renew the unified kxpms.cn cert with extra SANs.
    # The :80 whitelist in the earlier server block already covers the historical
    # whitelisted hosts (kxpms.cn/www/llm/auth/memora/ai/files.kxpms.cn); this
    # regex block is the catch-all for the remaining *.kxpms.cn subdomains.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # All other requests -> redirect to HTTPS (handled by the earlier :80 block
    # for whitelisted hosts; for unknown *.kxpms.cn we also redirect).
    location / {
        return 301 https://$kxpms_host$request_uri;
    }
}
