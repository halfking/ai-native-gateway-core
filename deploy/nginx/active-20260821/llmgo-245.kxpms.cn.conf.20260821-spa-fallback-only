# llmgo.kxpms.cn on 245 (pre-prod test environment)
# Deployed: 2026-07-12 · commit e37f7a8c
# Purpose: pre-production tenant-feature testing against PG17 on 252 (172.16.2.210),
#          BEFORE pushing to 154 (47.97.111.154).
# Architecture: native systemd (no docker/podman); binary at /opt/llm-gateway-go/gateway
#               listening on 127.0.0.1:8781. PG17 accessed via internal network to 252.
# Cert: /etc/letsencrypt/live/kxpms.cn/fullchain.pem (certbot auto-renewed on 245;
#       SAN already includes llmgo.kxpms.cn, verified 2026-07-12).
# DNS: llmgo.kxpms.cn -> 8.136.114.245 (verified 2026-07-12).
# Aliyun ICP interception only affects port 80; HTTPS works directly on 443.

upstream llmgo_local_245 {
    server 127.0.0.1:8781 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 80;
    server_name llmgo.kxpms.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    location ~ /\.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
    location ~ /\.(env|envrc|env\.local|env\.production|env\.development)$ { deny all; return 404; }
    location ~* (^|/)(wp-config|wp-settings|web\.config|composer\.json|composer\.lock|\.npmrc|\.docker/|\.git/|\.ssh/|\.aws/|Procfile|README\.md)$ { deny all; return 404; }
    location ~* (^|/)(database\.yml|secrets\.yml|\.htpasswd|credentials\.json|service-account.*\.json|\.kube/config)$ { deny all; return 404; }
    location ~* (union.*select|select.*from|concat.*char|<script|javascript:|onerror=|onload=) { return 444; }
}

server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 443 ssl http2;
    server_name llmgo.kxpms.cn;

    client_max_body_size 256m;
    client_body_timeout 1200s;
    keepalive_timeout 300s;

    ssl_certificate     /etc/letsencrypt/live/kxpms.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kxpms.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL_LLMGO_245:10m;
    ssl_session_timeout 1d;

    access_log /var/log/nginx/llmgo.kxpms.cn-access.log;
    error_log  /var/log/nginx/llmgo.kxpms.cn-error.log;

    # Marker-driven deploy page. The marker is created only after index.html
    # is complete and removed after all deploy verification gates pass.
    error_page 503 =200 /__llm_gateway_upgrade.html;
    location = /__llm_gateway_upgrade.html {
        internal;
        alias /opt/llm-gateway-go/maintenance/index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header X-LLM-Gateway-Upgrade "in-progress" always;
    }

    # Keep probes real while public/root locations are gated.
    location = /healthz {
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
    location = /readyz {
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # maintain reverse proxy (2026-07-21, 31 §3.4) — single-origin integration
    location /maintain-api/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Instance-Id $http_x_instance_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 30s;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_buffering off;
        proxy_cache off;
    }
    # Artifact downloads (ticket-gated) — proxied to maintain (8082)
    # Maintain registers GET /artifacts/{version}/{filename}?ticket=<token>
    location /artifacts/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location /maintain {
        alias /opt/ai-native-maintain/web/maintain;
        try_files $uri $uri/ /maintain/index.html;
        index index.html;
        expires -1;
        add_header Cache-Control "no-cache";
    }

    location = /api/admin/live-stream {
        if (-f /opt/llm-gateway-go/maintenance/UPGRADING) { return 503; }
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_cache off;
    }
    location = /api/admin/live-stream/ {
        if (-f /opt/llm-gateway-go/maintenance/UPGRADING) { return 503; }
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ~ ^/v1/(chat/completions|messages) {
        if (-f /opt/llm-gateway-go/maintenance/UPGRADING) { return 503; }
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 1200s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }

    # Product intro → Maintain home. Gateway login entry: /?login=*
    location = / {
        if (-f /opt/llm-gateway-go/maintenance/UPGRADING) { return 503; }
        error_page 418 = @llm_gateway_root;
        if ($arg_login != "") { return 418; }
        return 302 /maintain/home;
    }
    location = /maintain {
        return 302 /maintain/home;
    }
    location @llm_gateway_root {
        if (-f /opt/llm-gateway-go/maintenance/UPGRADING) { return 503; }
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        proxy_buffering off;
        proxy_cache off;
    }

    location / {
        if (-f /opt/llm-gateway-go/maintenance/UPGRADING) { return 503; }
        proxy_pass http://llmgo_local_245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ~ /\.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
    location ~ /\.(env|envrc|env\.local|env\.production|env\.development)$ { deny all; return 404; }
    location ~* (^|/)(wp-config|wp-settings|web\.config|composer\.json|composer\.lock|\.npmrc|\.docker/|\.git/|\.ssh/|\.aws/|Procfile|README\.md)$ { deny all; return 404; }
    location ~* (^|/)(database\.yml|secrets\.yml|\.htpasswd|credentials\.json|service-account.*\.json|\.kube/config)$ { deny all; return 404; }
    location ~* (union.*select|select.*from|concat.*char|<script|javascript:|onerror=|onload=) { return 444; }
}