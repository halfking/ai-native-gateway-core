# ============================================================================
# 252 unified gateway for internal.example.com domains (Deployed 2026-07-08)
# Architecture:
#   - 252 is the unified SSL termination point for *.internal.example.com
#   - Each domain proxies to its 154 backend via HTTP (internal network)
#   - certbot manages internal.example.com SSL cert at /etc/letsencrypt/live/internal.example.com
#   - 154 has its own nginx for direct-access mode (fallback)
#
# Domains & backends:
#   www.internal.example.com    → 172.16.2.209:12009 (154 SPA static + api reverse proxy)
#   llmgateway.internal.example.com    → 172.16.2.241:8781  (154 llm-gateway-go native)
#   auth.internal.example.com   → 172.16.2.209:8000  (154 casdoor-server native)
#   internal.example.com        → 302 → www.internal.example.com
#
# Cert topology (verified & updated 2026-08-15):
#   - internal.example.com + llmgateway.internal.example.com share ONE cert: /etc/letsencrypt/live/internal.example.com
#     (SAN: internal.example.com, llmgateway.internal.example.com; renewed on 252 via certbot-renew.timer,
#     webroot /var/www/certbot HTTP-01).
#   - 154 keeps a mirror synced by /etc/letsencrypt/renewal-hooks/deploy/sync-to-154.sh
#     (runs natively on every successful renewal; NOT via $DEPLOY_HOOK in sysconfig).
#     Both 252 and 154 serve llmgateway.internal.example.com with the same cert → flip DNS at will.
#   - legacy /etc/nps/conf/certs/hosts/llmgateway.internal.example.com path no longer exists (removed).
# ============================================================================

upstream kxpms_www_backend {
    server 172.16.2.209:443 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream kxpms_memora_backend {
    server 172.16.2.209:9001 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream kxpms_maintain_backend {
    server 172.16.2.241:8082 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

upstream kxpms_llm_backend {
    server 172.16.2.209:8781 max_fails=2 fail_timeout=5s;
    keepalive 32;
}

upstream kxpms_license_authority {
    server 172.16.2.209:8443 max_fails=3 fail_timeout=10s;
    keepalive 8;
}


upstream kxpms_auth_backend {
    server 172.16.2.209:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}


# HTTP :80 — ACME challenge + redirect to HTTPS
server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 80;
    listen [::]:80;
    # Expanded 2026-08-20: include all *.internal.example.com subdomains that resolve to
    # 252 public IP (115.29.212.252). This makes ACME HTTP-01 challenges go to
    # the local webroot directly, instead of falling through to the regex
    # catch-all block below (which proxies to 154, where only llmgateway.internal.example.com
    # has a working ACME endpoint).
    server_name internal.example.com www.internal.example.com llmgateway.internal.example.com auth.internal.example.com memora.internal.example.com
                ai.internal.example.com nexus.internal.example.com nbjl.internal.example.com
                acc.internal.example.com m.internal.example.com m-api.internal.example.com
                finance.internal.example.com doc-tools.internal.example.com mcp.internal.example.com
                bidding.internal.example.com crm.internal.example.com dashboard.internal.example.com
                fmail.internal.example.com geo.internal.example.com geoflow.internal.example.com
                marketing.internal.example.com public-kb.internal.example.com quotation.internal.example.com
                trendaradar.internal.example.com;

    # HTTP-01 ACME challenge — serve from local webroot (proven pattern, used
    # for *.itestu.cn certs). Certbot writes tokens here during renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Everything else → HTTPS redirect
    location / {
        return 301 https://$host$request_uri;
    }
    # Sensitive file blocking (hardened 2026-07-08)
    location ~ /\.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
    location ~ /\.(env|envrc|env\.local|env\.production|env\.development)$ { deny all; return 404; }
    location ~* (^|/)(wp-config|wp-settings|web\.config|composer\.json|composer\.lock|\.npmrc|\.docker/|\.git/|\.ssh/|\.aws/|Procfile|README\.md)$ { deny all; return 404; }
    location ~* (^|/)(database\.yml|secrets\.yml|\.htpasswd|credentials\.json|service-account.*\.json|\.kube/config)$ { deny all; return 404; }
    # Exploit pattern blocking
    location ~* (union.*select|select.*from|concat.*char|<script|javascript:|onerror=|onload=) { return 444; }
}


# HTTPS :9443 — memora.internal.example.com
server {
    include /etc/nginx/conf.d/00-security-hardening.snippet;
    autoindex off;
    listen 9443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    server_name memora.internal.example.com;
    ssl_certificate     /etc/letsencrypt/live/internal.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/internal.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 100m;
    keepalive_timeout 300s;

    access_log /var/log/nginx/memora-252-access.log;
    error_log  /var/log/nginx/memora-252-error.log;

    location / {
        proxy_pass http://kxpms_memora_backend;
        proxy_set_header Host memora.internal.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://kxpms_memora_backend;
        proxy_set_header Host memora.internal.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location /api/chat/ {
        proxy_pass http://kxpms_memora_backend;
        proxy_set_header Host memora.internal.example.com;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location ~ /.(git|svn|hg|env|htaccess|htpasswd|docker|kube) { deny all; return 404; }
}
