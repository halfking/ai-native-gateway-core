# ============================================================================
# File: deploy/phase0/optimization.env
# Purpose: Phase 0 configuration optimization (zero-code tuning)
# Target: All environments (local/kaixuan-1/71/184)
# Expected: TTFB ↓ 15-20%
# Reference: AUDIT_V2 + IMPLEMENTATION_PLAN Phase 0
# ============================================================================

# Connection Pool Parameters (AUDIT_V2 A1 fix applied)
# Changed based on unified code parameters
LLM_GATEWAY_MAX_IDLE_CONNS_PER_HOST=64    # Code: pool.go:24, upstream/client.go:105
LLM_GATEWAY_MAX_CONNS_PER_HOST=256        # Code: pool.go:25
LLM_GATEWAY_IDLE_CONN_TIMEOUT=180s        # Increased: 90s → 180s

# HTTP/2 Settings
LLM_GATEWAY_ENABLE_HTTP2=true
LLM_GATEWAY_HTTP2_MAX_CONCURRENT_STREAMS=250   # Default: 100

# Timeouts
LLM_GATEWAY_CONNECT_TIMEOUT=5s            # Reduced: 10s → 5s
LLM_GATEWAY_HEADER_TIMEOUT=10s            # Keep default
LLM_GATEWAY_REQUEST_TIMEOUT=300s          # Keep default for streaming

# Keep-alive
LLM_GATEWAY_TCP_KEEPALIVE=60s             # Increased: 30s → 60s

# Health Check
LLM_GATEWAY_HEALTH_CHECK_INTERVAL=30s
LLM_GATEWAY_HEALTH_CHECK_TIMEOUT=5s

# Pool Manager
LLM_GATEWAY_POOL_MAX_POOLS=256            # Keep default
LLM_GATEWAY_POOL_IDLE_TTL=180s            # Match idle_conn_timeout
LLM_GATEWAY_POOL_EVICT_INTERVAL=30s       # Keep default

# Monitoring (for verification)
LLM_GATEWAY_ENABLE_METRICS=true
LLM_GATEWAY_METRICS_PORT=8781

# ============================================================================
# Deployment Instructions
# ============================================================================
#
# Local Testing:
#   export $(cat deploy/phase0/optimization.env | grep -v '^#' | xargs)
#   go run cmd/gateway/main.go
#
# Systemd Service (kaixuan-1/71/184):
#   sudo mkdir -p /etc/systemd/system/llm-gateway.service.d
#   sudo cat > /etc/systemd/system/llm-gateway.service.d/phase0-optimization.conf <<EOC
#   [Service]
#   EnvironmentFile=/opt/llm-gateway/config/phase0-optimization.env
#   EOC
#   sudo systemctl daemon-reload
#   sudo systemctl restart llm-gateway
#
# Docker:
#   docker run --env-file deploy/phase0/optimization.env llm-gateway:latest
#
# Verification:
#   curl http://localhost:8781/metrics | grep -E "pool|http2|connection"
#
# Rollback:
#   bash scripts/rollback-optimization.sh
#
