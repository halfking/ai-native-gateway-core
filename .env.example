# ====================================================================
# llm-gateway-go 本地开发环境变量模板
# 复制为 .env 使用（勿直接修改本文件）
# ====================================================================
# 用法: cp .env.example .env && docker compose up -d
# 敏感值: 从密码管理器获取或使用 <env:KEY> 占位符
# 生产环境: 敏感配置走 SOPS 加密（rule 16）
# ====================================================================

# ── 服务基础 ──────────────────────────────────────────────────────
# 服务监听端口（与 docker-compose.yml 中 ${PORT} 对应）
PORT=8080

# 运行环境：local / dev / staging / prod
NODE_ENV=local

# ── 预测性 TTFT 路由（O-1，默认关闭）──────────────────────────────
# 仅当 credential 的 EMA TTFB 严格高于阈值且样本达到门槛时预跳过一个候选。
# 预测跳过不会计入真实尝试；阈值为 0 时完全禁用。
# LLM_GATEWAY_PREDICTIVE_TTFB_THRESHOLD_MS=0
# LLM_GATEWAY_PREDICTIVE_TTFB_MIN_SAMPLES=3

# ── 数据库 ─────────────────────────────────────────────────────────
# 默认指向 localhost 上的共享数据库（见根目录 docker-compose.yml）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=<service_name>

# 敏感值使用 <env:KEY> 占位符（rule 16），或从密码管理器获取
# 占位符引用 envs/projects/llm-gateway-go 真实 KEY（见 ~/workspace/ai-native-tools/envs/）
# 加载方式: source ~/workspace/ai-native-tools/envs/loader.sh --project llm-gateway-go --server <target>
DB_USER=<env:COMMON_PG_USER_KXUSER>
DB_PASSWORD=<env:COMMON_PG_PASS_KXUSER>

# 连接字符串（如有需要）
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# ── 本地 RLS 测试（Docker PostgreSQL 17，可选）──────────────────────
# 本地使用：cp .env.example .env.local 后填入低权限测试角色信息，
# 再执行：set -a; source .env.local; set +a; make test-rls
# 不要把 superuser/BYPASSRLS 角色用于 RLS 门禁，否则会产生假绿。
# TEST_DATABASE_URL=postgres://<nosuperuser>:<password>@127.0.0.1:5432/llm_gateway_test?sslmode=disable
# TEST_DATABASE_SSLMODE=disable

REDIS_PORT=6379
REDIS_PASSWORD=<env:COMMON_REDIS_PASSWORD_252>

# 2026-08-04: LLM Gateway 主 Redis 连接配置
# 所有 Redis 客户端（session / live-stream / rpm / availability cache）
# 都通过这三个 env 拿连接，统一 db 选择避免与共享实例上其他系统混用。
# 默认 db=2（共享 Redis 实例上 db=0/1/9 已分别被 PMS / 其他系统 / 元数据占用），
# 历史遗留的 db=0 llmgw keys 会随 TTL（4h-24h）自动过期清理，无需迁移。
# 覆盖示例：LLM_GATEWAY_REDIS_DB=3
# LLM_GATEWAY_REDIS_ADDR=172.16.2.210:6389
# LLM_GATEWAY_REDIS_PASSWORD=<env:COMMON_REDIS_PASSWORD_252>
# LLM_GATEWAY_REDIS_DB=2

# ── 第三方服务 ─────────────────────────────────────────────────────
# API Key 等敏感值走 <env:KEY> 占位符（引用 envs/projects/llm-gateway-go）
API_ENDPOINT=http://localhost:8081
API_KEY=<env:LLM_GATEWAY_API_KEY>

# kxmemory 是向量库唯一写入者；gateway 通过 API 回写会话摘要。
MEMORA_WRITEBACK_ENABLED=false
LLM_GATEWAY_MEMORA_BASE_URL=http://localhost:8000
# TODO(secrets): MEMORA_INGEST_API_KEY 尚未在 envs 注册，需补充到 envs/projects/memora/
LLM_GATEWAY_MEMORA_API_KEY=<env:MEMORA_INGEST_API_KEY>
MEMORA_WRITEBACK_TIMEOUT=5s


# ── 会话分析模型（可选）───────────────────────────────────────────
# 同时设置后启用 LLM 请求摘要、rolling session summary 和 embedding 聚类。
# endpoint 必须兼容 OpenAI /v1/chat/completions 与 /v1/embeddings。
# 未设置时保持规则摘要/规则聚类，不产生外部模型调用。
# LLM_GATEWAY_ANALYSIS_BASE_URL=https://your-analysis-provider.example/v1
# LLM_GATEWAY_ANALYSIS_API_KEY=<env:ANALYSIS_API_KEY>
# 本地 httptest/loopback 开发时才允许开启；生产保持 false。
# LLM_GATEWAY_ANALYSIS_ALLOW_INSECURE_LOCAL=false
# 推荐通过模型 alias 配置：embedding-fast / summary-fast / intent-fast。

# ── 认证（Casdoor OIDC）────────────────────────────────────────────
CASDOOR_ENDPOINT=http://localhost:4800
# TODO(secrets): Casdoor 尚未为 llm-gateway 注册专属 app，需在 Casdoor 创建
# CASDOOR_LLM_GATEWAY_CLIENT_ID/SECRET 并补充到 envs/common/casdoor.yaml
CASDOOR_CLIENT_ID=<env:CASDOOR_LLM_GATEWAY_CLIENT_ID>
CASDOOR_CLIENT_SECRET=<env:CASDOOR_LLM_GATEWAY_CLIENT_SECRET>

# ── 日志 ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# 文件日志轮转：留空走 stderr；填绝对路径启用 rotation
# 默认 100MB × 10 文件 ≈ 1GB 上限，自动 gzip 过期文件，7 天滚动
# LLM_GATEWAY_LOG_FILE=/var/log/llm-gateway/gateway.log
# LLM_GATEWAY_LOG_MAX_SIZE_MB=100
# LLM_GATEWAY_LOG_MAX_BACKUPS=10
# LLM_GATEWAY_LOG_MAX_AGE_DAYS=7
# LLM_GATEWAY_LOG_COMPRESS=true

# 附件存储目录：默认为 ./data/attachments，建议使用绝对路径并配置持久化存储
# 容器部署时需挂载到 volume 或 PVC，避免容器重启导致数据丢失
# LLM_GATEWAY_ATTACHMENT_DIR=/data/attachments

# ── 附件访问认证配置 (2026-08-09) ────────────────────────────────
# 附件访问认证模式，可选值：
#   - none     无需认证（默认，向后兼容）
#   - apikey   使用 API Key 认证（推荐，客户端使用相同的 Bearer token 访问附件）
#   - signed   使用 HMAC 签名链接（用于 session 附件，待实现）
#   - admin    使用 Admin session cookie（用于管理后台，待实现）
# LLM_GATEWAY_ATTACHMENT_AUTH_MODE=apikey

# 附件公开访问 URL 前缀（用于生成下载链接）
# 留空则使用 /api/attachments/（默认）
# CDN 场景示例：https://cdn.example.com/attachments
# LLM_GATEWAY_ATTACHMENT_PUBLIC_URL=https://cdn.example.com/attachments

# 附件跨域访问允许的来源（逗号分隔，* 表示允许所有）
# 示例：https://app.example.com,https://admin.example.com
# LLM_GATEWAY_ATTACHMENT_CORS_ORIGINS=*
# ──────────────────────────────────────────────────────────────────

# ── Extensions 透传机制 ────────────────────────────────────────────
# 启用后，所有厂商特有字段（如 Ollama 的 keep_alive、GLM 的 web_search、
# DeepSeek 的 reasoning_tokens）会在协议转换时被保留并透传，防止字段丢失。
# 
# 请求协议转换主开关（默认 true；设为 false 才回退 legacy）
# LLM_GATEWAY_IR_CONVERTER=false
#
# Extensions 透传开关（默认 true；设为 false 才禁用）
# LLM_GATEWAY_TRANSPORT_IR=false
#
# 独立 TransportFactory 开关（默认 true；设为 false 才回退）
# TRANSPORT_LAYER_IR_ENABLED=false
# 默认全量 IR；仅在显式灰度时设置 0-99，100 表示全量。
# TRANSPORT_IR_ROLLOUT_PERCENT=100
#
# 影响范围：
#   - Ollama: keep_alive, format, context 等字段
#   - GLM: web_search, retrieval, tools 等扩展字段
#   - DeepSeek: reasoning_tokens 等计费字段
#   - 所有厂商的未知字段都会透传
#
# 验证方法：
#   curl -X POST http://localhost:8080/v1/chat/completions \
#     -H "Content-Type: application/json" \
#     -d '{"model":"ollama/llama3","messages":[...],"keep_alive":"5m"}'
#   # 检查上游请求日志，确认 keep_alive 字段被保留
#
# 详细文档：docs/2026-07-11-enable-extensions-guide.md

# ── Goal 模式（自动续跑 + 任务完成后审计）─────────────────────────
# 启用后，当 LLM 回复中没有 tool_calls 但任务尚未完成时，网关会自动
# 注入"请继续下一步"的后续请求，让 LLM 继续执行；任务完成后可自动
# 换一个模型对执行结果做代码审计。所有项默认关闭，可按租户在 settings
# 里通过 goal.* key 覆盖（见 settings/goal_specs.go）。
#
# 总开关（默认 false）。即使开启，下方 LLM 端点未配置时，完成检测
# 与审计的 LLM 判断步骤会跳过，仅走关键词/启发式策略。
# LLM_GATEWAY_GOAL_ENABLED=false
# 检测方式：keyword | explicit | llm | hybrid（默认 hybrid）
# LLM_GATEWAY_GOAL_DETECTION_MODE=hybrid
# 暂停/结束但未完成时自动续跑（默认 true）
# LLM_GATEWAY_GOAL_AUTO_CONTINUE=true
# 单会话最大自动续跑次数，防死循环（默认 3）
# 注意：该值 × (MAX_MODEL_SWITCH+1) 必须小于等于 MAX_FOLLOW_UP_DEPTH，
# 否则续跑链会被 follow-up 深度护栏截断，预算耗尽型模型切换不会触发。
# LLM_GATEWAY_GOAL_MAX_AUTO_CONTINUE=3
#
# 任务完成后审计
# LLM_GATEWAY_GOAL_AUDIT_ENABLED=false
# 审计走 autoroute 自动选模型（推荐），否则用下面指定的模型
# LLM_GATEWAY_GOAL_USE_AUTOROUTE_AUDIT=true
# LLM_GATEWAY_GOAL_AUDIT_MODEL=auto
# LLM_GATEWAY_GOAL_FALLBACK_AUDIT_MODEL=auto
# 审计发现问题后自动注入修复请求（高风险，默认 false）
# LLM_GATEWAY_GOAL_AUTO_FIX=false
#
# 死循环防护 —— 检测到死循环（续跑预算耗尽 或 模型连续重复相同响应）时，
# 自动切换到备选模型并重置续跑预算，让新模型继续完成任务，避免无限循环。
# 切换次数达到上限后放弃续跑（session 保留 active 供人工排查）。
# 死循环时是否切换模型（默认 true）
# LLM_GATEWAY_GOAL_MODEL_SWITCH_ON_LOOP=true
# 单会话最大模型切换次数（默认 3，0 表示禁止切换）
# LLM_GATEWAY_GOAL_MAX_MODEL_SWITCH=3
# 备选模型列表（逗号分隔，按顺序切换；auto 走 autoroute 自动选）
# LLM_GATEWAY_GOAL_FALLBACK_MODELS=auto,gpt-4o,claude-3-5-sonnet
# 启用重复响应检测（默认 true）
# LLM_GATEWAY_GOAL_REPEAT_DETECTION=true
# 连续相同响应判定死循环的阈值（默认 3，0 禁用）
# LLM_GATEWAY_GOAL_REPEAT_THRESHOLD=3
#
# 完成检测 LLM 判定的最低置信度（默认 0.8，越低越容易判定完成→续跑更少）
# LLM_GATEWAY_GOAL_COMPLETION_CONFIDENCE=0.8
#
# Follow-up 引擎硬护栏（可调，0 表示用系统默认）
# 单请求链路最大递归深度（默认 15）
# 必须大于 MAX_AUTO_CONTINUE × (MAX_MODEL_SWITCH+1)，否则续跑链会被截断、
# 预算耗尽型模型切换不会触发（默认 3×4=12 ≤ 15，留 audit 余量）。
# LLM_GATEWAY_GOAL_MAX_FOLLOW_UP_DEPTH=15
# 单会话续跑总次数上限（默认 50）
# LLM_GATEWAY_GOAL_MAX_FOLLOW_UPS_PER_SESSION=50
#
# Goal 完成检测 / 审计共用的 LLM 端点（与 autoroute 共享，OpenAI 兼容）。
# 留空则上述 LLM 判断步骤降级为 no-op。
# LLMGatewayAutoLLMEndpoint=https://llmgateway.internal.example.com/v1
# LLMGatewayAutoLLMApiKey=sk-...
# LLMGatewayAutoLLMModel=gpt-4o-mini
# LLMGatewayAutoLLMTimeout=15
#
# ════════════════════════════════════════════════════════════════════
# 自动 Handoff —— 网关在请求转发前检测上下文并执行会话交接。
# 透明模式会创建新网关会话、注入受控 resume packet 后继续当前请求；
# 显式模式返回 202 + resume_packet，由客户端自行续跑。默认关闭。
#
# 启用 Handoff（默认 false）
# LLM_GATEWAY_HANDOFF_ENABLED=false
# 触发模式：auto / manual / hybrid（manual 识别 /<skill>，由网关执行）
# LLM_GATEWAY_HANDOFF_TRIGGER_MODE=auto
# 客户端默认模式：transparent / explicit；单请求可用 X-Gw-Handoff-Mode: explicit 覆盖
# LLM_GATEWAY_HANDOFF_CLIENT_MODE=transparent
# 绝对 token 阈值：会话总 token 达到此值触发（默认 180000）
# LLM_GATEWAY_HANDOFF_ABSOLUTE_THRESHOLD=180000
# 百分比阈值：达到上下文窗口的此比例触发（默认 0.8 = 80%）
# LLM_GATEWAY_HANDOFF_PERCENTAGE_THRESHOLD=0.8
# 消息数量阈值：消息数达此值触发（0=禁用，默认禁用）
# LLM_GATEWAY_HANDOFF_MESSAGE_THRESHOLD=0
# 触发时调用的 skill 名称（默认 handoff，即 /handoff）
# LLM_GATEWAY_HANDOFF_SKILL_NAME=handoff
#
# 摘要调用只使用已识别的直通上游凭据或系统摘要凭据；绝不将网关
# Authorization Key 转发给供应商。此模式不再通过网关自调用 follow-up。

# ═══════════════════════════════════════════════════════════════════
# 自动会话标题 / 摘要（Auto Title / Summary）
# 首轮用户请求成功后，网关异步调用 LLM 生成会话标题；多轮后生成
# rolling summary。两者默认开启，可用下列开关单独关闭。环境变量
# 为空或非法（无法 ParseBool）时回落到默认（开启），避免误关闭。
#
# 自动标题总开关（默认 true）
# LLM_GATEWAY_AUTO_TITLE_ENABLED=true
# 自动摘要总开关（默认 true）
# LLM_GATEWAY_AUTO_SUMMARY_ENABLED=true
# 短消息豁免：请求体最后一条 user 消息 rune 数 ≤ sessionTitleMaxRunes(80)
# 时跳过 LLM 标题生成。命中占比见 Grafana auto-summary dashboard 的
# "Auto-Title 短消息豁免占比 (last 1h)" 面板。
# ════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════
# 部署 / 运维占位符
# ════════════════════════════════════════════════════════════════════
# 以下占位符出现在 scripts/*.sh、docs/*.md 和 Dockerfile 中。
# 真实值不进仓库；本地开发时在此处填入，生产环境从
# /etc/llm-gateway-go/env (chmod 600) 或 k8s secret 注入。
#
# 完整占位符→真实值对照表见 ~/Documents/llm-gateway-env.md（仓库外）。
# --------------------------------------------------------------------

