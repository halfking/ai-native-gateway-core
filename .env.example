SSHPASS=__REDACTED_SSH_PASSWORD__
SSHPASS_154=__REDACTED_SSH_PASSWORD__
SSHPASS_252=__REDACTED_SSH_PASSWORD__
SSHPASS_245=__REDACTED_SSH_PASSWORD__
SSHPASS_186=__REDACTED_SSH_PASSWORD__

# ── 多环境部署凭据（scripts/check-and-fix-missing-tables.sh, 36cd827f0）───
# 本地 dev 数据库 URL（指向本地 docker stack；5432 端口）
# LLM_GATEWAY_DATABASE_URL_LOCAL=postgres://kxuser:kxpass@127.0.0.1:5432/llm_gateway?sslmode=disable
# 运维节点标识（写入 gateway_instances.region，运维概览可见）
# 建议值：local / 245 / 154
OPS_NODE_REGION=local
# 首次激活与注册中心地址；未设置时网关默认使用 https://llm.kxpms.cn
LLM_GATEWAY_CENTER_URL=https://llm.kxpms.cn
# 节点数据汇聚 API（心跳/采集；未设置时沿用中心默认地址）
OPS_COLLECT_URL=https://llm.kxpms.cn
# OPS_COLLECT_LICENSE_KEY=       # 运维节点注册用 licensee license key
# OPS_COLLECT_DIRECT_DB=0        # 仅调试：设为 1 才允许直连 DB 写 gateway_instances
# OPS_INSTANCE_ID=            # 可选，默认持久化到 ~/.local/share/kx-gateway/instance.id（或 OPS_DATA_DIR）
# OPS_DATA_DIR=               # 本地 dev 可设为 ~/.local/share/kx-gateway
# OPS_CENTER_AGENT_DISABLED=0 # 设为 1 可关闭节点自注册心跳

# LLM_GATEWAY_DATABASE_URL_252=postgres://kxuser:REDACTED@172.16.2.210:5432/llm_gateway?sslmode=disable
# kaixuan-1 控制面后端 PG（192.168.31.8:30432，pg17 + citus 13.3-1 + pgvector）
# LLM_GATEWAY_DATABASE_URL_KAIXUAN_1=postgres://kxuser:REDACTED@192.168.31.8:30432/llm_gateway?sslmode=disable
# 154 主机部署的 llm.kxpms.cn（172.16.2.209:5432）
# LLM_GATEWAY_DATABASE_URL_154=postgres://kxuser:REDACTED@172.16.2.209:5432/llm_gateway?sslmode=disable
# check-and-fix-missing-tables.sh / ssh-deploy 等脚本的 SSH 密码占位
# 真实值走 k8s secret 或本地 ~/.ssh，勿提交进仓库
# DEPLOY_SSH_PASSWORD=__REDACTED_DEPLOY_SSH_PASSWORD__

# ── 数据库 ─────────────────────────────────────────────────────────
# 生产 DB 用户（原 stockuser，已统一为 kxuser）
DB_USER=__DB_USER__
DB_ADMIN_PASSWORD=__REDACTED_DB_PASSWORD__

# ── Gateway → ASM durable outbox ───────────────────────────────────
# Dispatcher only starts when both values are configured.
ASM_INTERNAL_ENDPOINT=http://127.0.0.1:8080/internal/v1/events
AI_SESSION_MANAGER_GATEWAY_EVENT_SECRET=__REDACTED_GATEWAY_EVENT_SECRET__
# Optional: Go duration / positive integer. Defaults: 5s / 5 / 10s.
OUTBOX_POLL_INTERVAL=5s
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_HTTP_TIMEOUT=10s

# ── 镜像仓库 ───────────────────────────────────────────────────────
# Dockerfile ARG REGISTRY 和 deploy/*.sh 的默认值
REGISTRY=registry.internal.example.com

# ── 内部域名 ───────────────────────────────────────────────────────
# 网关对外域名
LLMGATEWAY_HOST=llmgateway.internal.example.com
# 认证服务
AUTH_HOST=auth.internal.example.com
# MCP 服务
MCP_HOST=mcp.internal.example.com

# ── 插件权益门禁（Entitlement Gate）─────────────────────────────────
# 当 ai-session-manager 等 license_required 插件需要按租户权益控制访问时，
# Gateway 会在转发插件 API 请求前，以服务身份向 maintain 查询有效权益。
#
# 必须与 maintain 使用相同的 HS256 密钥：
LLM_GATEWAY_JWT_SECRET=
# maintain 服务地址（与 MAINTAIN_SERVICE_URL 一致）：
MAINTAIN_SERVICE_URL=
# 权益门禁开关（默认 false=不拦截；true=按 manifest license_required 拦截）：
LLM_GATEWAY_PLUGIN_ENTITLEMENT_GATE=false
# 插件签名公钥（ed25519 hex，可选；空跳过验证，仅 dev）：
LLM_GATEWAY_PLUGIN_SIGNING_PUBKEY=
