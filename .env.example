# ── SSH 连接 ───────────────────────────────────────────────────────
# 默认全部使用密钥登录（root 用户 + Kaixuan2026&#*9527）；sshpass 时优先读取 SSHPASS 环境变量
SSH_USER=root
SSH_PORT=25022
SSH_PORT_154=25022
SSH_PORT_252=25022
SSH_PORT_245=25022
SSH_PORT_186=25022
