# llm-gateway-go 环境变量模板
# 由 llm-gw-installer 自动填充
# === 必填（deploy.sh 之前已自动生成） ===

# 应用镜像 tag（不要改）
APP_IMAGE_TAG=__APP_IMAGE_TAG__

# PostgreSQL 配置
PG_PORT=__PG_PORT__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# Redis 配置
REDIS_PORT=__REDIS_PORT__
REDIS_PASSWORD=__REDIS_PASSWORD__

# 应用配置
APP_PORT=__APP_PORT__

# 网关密钥（运行时生成，留空时自动生成）
LLM_GATEWAY_API_KEY=__LLM_GATEWAY_API_KEY__
LLM_GATEWAY_ADMIN_API_KEY=__LLM_GATEWAY_ADMIN_API_KEY__
LLM_GATEWAY_JWT_SECRET=__LLM_GATEWAY_JWT_SECRET__
LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=__LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY__

# === 可选（有默认值） ===
LLM_GATEWAY_LISTEN=:8781
LOG_LEVEL=info
LOG_FORMAT=json
LLM_GATEWAY_ATTACHMENT_DIR=/opt/llm-gateway-go/data/attachments
OTEL_DEPLOYMENT_ENV=prod
TZ=Asia/Shanghai
