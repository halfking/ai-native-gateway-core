# llm-gateway-go 环境变量模板
# 由 llm-gw-installer 自动填充
# === 必填（deploy.sh 之前已自动生成） ===

# 应用镜像 tag（不要改）
APP_IMAGE_TAG=__APP_IMAGE_TAG__

# PostgreSQL 配置
PG_PORT=__PG_PORT__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# Redis 配置
REDIS_PORT=__REDIS_PORT__
REDIS_PASSWORD=__REDIS_PASSWORD__

# 应用配置
APP_PORT=__APP_PORT__

# 网关密钥（运行时生成，留空时自动生成）
LLM_GATEWAY_API_KEY=__LLM_GATEWAY_API_KEY__
LLM_GATEWAY_ADMIN_API_KEY=__LLM_GATEWAY_ADMIN_API_KEY__
LLM_GATEWAY_JWT_SECRET=__LLM_GATEWAY_JWT_SECRET__
LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=__LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY__

# ==== 存储模式（installer --mode 选择 / 运行时由 cmd/gateway 读取） ====
# full：标准生产路径（kx-citus + kx-redis）
# lite：单机 / 开发 / CI（SQLite + 本地，不拉 PG/Redis 镜像、不初始化 schema）
# 默认值：full
LLM_GATEWAY_STORAGE_MODE=__LLM_GATEWAY_STORAGE_MODE__

# ==== 主控端 URL（installer --master-url / license 激活 + 心跳） ====
# 默认值：https://llm.kxpms.cn
LLM_GATEWAY_MASTER_URL=__LLM_GATEWAY_MASTER_URL__

# ==== install 末尾是否跳过自动激活（installer --skip-activation） ====
# 0 = 走 install 末尾的自动激活调用（由后续子代理 B 接管实际调用）
# 1 = 跳过自动激活（仅完成容器部署 + 健康检查）
INSTALL_SKIP_ACTIVATION=__INSTALL_SKIP_ACTIVATION__

# 可选（有默认值）
LLM_GATEWAY_LISTEN=:8781
LOG_LEVEL=info
LOG_FORMAT=json
LLM_GATEWAY_ATTACHMENT_DIR=/opt/llm-gateway-go/data/attachments
LLM_GATEWAY_RAW_LOG_DIR=/opt/llm-gateway-go/data/raw-logs
LLM_GATEWAY_BACKUP_DIR=/opt/llm-gateway-go/data/backups
LLM_GATEWAY_PERSISTENT_LOG_DIR=/var/log/llm-gateway
OTEL_DEPLOYMENT_ENV=prod
TZ=Asia/Shanghai

# === 可选（Live Stream 缓存超时配置） ===
# 实时请求流（GET /api/admin/live-stream）的 per-tenant snapshot 缓存淘汰阈值。
# 活跃 SSE 订阅对应的 scope 会保留 baseline；无订阅 scope 到期后释放。
LLM_GATEWAY_LIVE_STREAM_CACHED_TTL=4h

# 缓存清理周期；未显式设置时自动跟随 CACHED_TTL。
LLM_GATEWAY_LIVE_STREAM_CACHED_CLEANUP_INTERVAL=4h
