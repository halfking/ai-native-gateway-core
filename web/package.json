{
  "name": "llm-gateway-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:check": "node scripts/i18n-audit.mjs",
