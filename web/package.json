{
  "name": "llm-gateway-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "node scripts/export-menu-config.mjs && node scripts/element-import-audit.mjs && node scripts/ui-audit.mjs --strict && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "ui:check": "node scripts/ui-audit.mjs",
    "ui:check:strict": "node scripts/ui-audit.mjs --strict",
    "ui:selftest": "node scripts/ui-audit.mjs --selftest",
    "i18n:check": "node scripts/i18n-audit.mjs && node scripts/i18n-cjk-count.mjs",
    "i18n:check:strict": "I18N_STRICT=1 vitest run src/i18n/keys_referenced.test.ts && vitest run src/i18n/hardcoded_cjk.baseline.test.ts",
    "i18n:cjk:check": "node scripts/i18n-cjk-count.mjs",
    "i18n:cjk:update-baseline": "node scripts/i18n-cjk-count.mjs --update-baseline",
    "i18n:check:json": "node scripts/i18n-audit.mjs --json --out=reports/i18n-audit.json",
    "i18n:fix:dry": "node scripts/i18n-fix.mjs --dry-run",
    "i18n:fix": "node scripts/i18n-fix.mjs --apply --yes",
    "responsive:check": "node scripts/responsive-audit.mjs --strict",
    "card:coverage": "node scripts/compact-card-coverage.mjs",
    "card:coverage:self-test": "node scripts/compact-card-coverage.mjs --self-test",
    "device-fit": "node scripts/device-fit-audit.mjs",
    "gesture:host": "node scripts/gesture-host-audit.mjs",
    "census:table": "node scripts/compact-table-census.mjs",
    "element:check": "node scripts/element-import-audit.mjs",
    "color:check": "node scripts/color-token-audit.mjs --strict --baseline scripts/color-audit-baseline.json",
    "color:baseline:update": "node scripts/color-token-audit.mjs --update-baseline --baseline scripts/color-audit-baseline.json",
    "color:baseline:stale": "node scripts/color-baseline-stale.mjs",
    "ui:sweep:selftest": "node scripts/ui-sweep.mjs --selftest",
    "ui:sweep:pages": "node scripts/ui-sweep.mjs --strict",
    "ui:sweep:overlays": "node scripts/ui-sweep.mjs --overlays --strict",
    "census:table:mobile": "node scripts/compact-table-census.mjs --root ../web-mobile/src",
    "file-inputs:check": "node scripts/file-input-census.mjs",
    "file-inputs:self-test": "node scripts/file-input-census.mjs --self-test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "chart.js": "^4.5.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.4",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "0.25.12",
    "jsdom": "^24.1.3",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.7"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "glob": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2.1.7": "2.1.7",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23"
    }
  }
}
