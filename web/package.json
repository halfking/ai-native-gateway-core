{
  "name": "llm-gateway-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "node scripts/export-menu-config.mjs && node scripts/element-import-audit.mjs && node scripts/ui-audit.mjs --strict && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "ui:check": "node scripts/ui-audit.mjs",
    "ui:check:strict": "node scripts/ui-audit.mjs --strict",
    "ui:selftest": "node scripts/ui-audit.mjs --selftest",
    "i18n:check": "node scripts/i18n-audit.mjs && node scripts/i18n-cjk-count.mjs",
    "i18n:check:strict": "I18N_STRICT=1 vitest run src/i18n/keys_referenced.test.ts && vitest run src/i18n/hardcoded_cjk.baseline.test.ts && vitest run src/i18n/localeValueQuality.test.ts && vitest run src/i18n/localePlaceholderParity.test.ts && vitest run src/i18n/callSitePlaceholderCoverage.test.ts && vitest run src/i18n/localeKeyParity.test.ts && vitest run src/i18n/plainAttrBinding.test.ts",
    "i18n:cjk:check": "node scripts/i18n-cjk-count.mjs",
    "i18n:cjk:update-baseline": "node scripts/i18n-cjk-count.mjs --update-baseline",
    "i18n:locale-value:check": "node scripts/i18n-locale-value-count.mjs",
    "i18n:locale-value:update-baseline": "node scripts/i18n-locale-value-count.mjs --update-baseline",
    "i18n:key-parity:check": "node scripts/i18n-key-parity-count.mjs",
    "i18n:key-parity:update-baseline": "node scripts/i18n-key-parity-count.mjs --update-baseline",
    "i18n:hidden-key:check": "node scripts/i18n-hidden-key-guard.mjs",
    "i18n:hidden-key:selftest": "node scripts/i18n-hidden-key-guard.mjs --selftest",
    "i18n:shared-dead:check": "node scripts/i18n-shared-dead-count.mjs",
    "i18n:shared-dead:update-baseline": "node scripts/i18n-shared-dead-count.mjs --update-baseline",
    "i18n:shared-dead:selftest": "node scripts/i18n-shared-dead-count.mjs --selftest",
    "i18n:empty-state:check": "node scripts/i18n-empty-state-guard.mjs",
    "i18n:empty-state:selftest": "node scripts/i18n-empty-state-guard.mjs --selftest",
    "i18n:error-clarity:check": "node scripts/i18n-error-clarity-guard.mjs",
    "i18n:error-clarity:selftest": "node scripts/i18n-error-clarity-guard.mjs --selftest",
    "i18n:error-clarity:list": "node scripts/i18n-error-clarity-guard.mjs --list",
    "i18n:error-outlet:check": "node scripts/i18n-error-outlet-guard.mjs",
    "i18n:error-outlet:selftest": "node scripts/i18n-error-outlet-guard.mjs --selftest",
    "i18n:jargon:check": "node --experimental-strip-types scripts/i18n-internal-jargon-guard.mjs",
    "i18n:jargon:selftest": "node --experimental-strip-types scripts/i18n-internal-jargon-guard.mjs --selftest",
    "i18n:jargon:list": "node --experimental-strip-types scripts/i18n-internal-jargon-guard.mjs --list",
    "i18n:jargon:runtime": "node --experimental-strip-types scripts/i18n-jargon-runtime-check.mjs",
    "i18n:jargon:runtime:selftest": "node --experimental-strip-types scripts/i18n-jargon-runtime-check.mjs --selftest",
    "i18n:error-outlet:list": "node scripts/i18n-error-outlet-guard.mjs --list",
    "i18n:check:json": "node scripts/i18n-audit.mjs --json --out=reports/i18n-audit.json",
    "i18n:fix:dry": "node scripts/i18n-fix.mjs --dry-run",
    "i18n:fix": "node scripts/i18n-fix.mjs --apply --yes",
    "responsive:check": "node scripts/responsive-audit.mjs --strict",
    "card:coverage": "node scripts/compact-card-coverage.mjs",
    "card:coverage:self-test": "node scripts/compact-card-coverage.mjs --self-test",
    "device-fit": "node scripts/device-fit-audit.mjs",
    "gesture:host": "node scripts/gesture-host-audit.mjs",
    "census:table": "node scripts/compact-table-census.mjs",
    "element:check": "node scripts/element-import-audit.mjs",
    "color:check": "node scripts/color-token-audit.mjs --strict --baseline scripts/color-audit-baseline.json",
    "copy-quality:check": "node scripts/copy-quality-audit.mjs",
    "copy-quality:selftest": "node scripts/copy-quality-audit.mjs --selftest",
    "copy-quality:update-baseline": "node scripts/copy-quality-audit.mjs --update-baseline",
    "copy-clarity:check": "node scripts/copy-clarity-guard.mjs",
    "copy-clarity:selftest": "node scripts/copy-clarity-guard.mjs --selftest",
    "copy-clarity:list": "node scripts/copy-clarity-guard.mjs --list",
    "copy-clarity-locale:check": "node scripts/copy-clarity-locale-guard.mjs",
    "copy-clarity-locale:selftest": "node scripts/copy-clarity-locale-guard.mjs --selftest",
    "copy-clarity-locale:list": "node scripts/copy-clarity-locale-guard.mjs --list",
    "design-ai-smell:check": "node scripts/design-ai-smell-guard.mjs",
    "design-ai-smell:selftest": "node scripts/design-ai-smell-guard.mjs --selftest",
    "design-ai-smell:list": "node scripts/design-ai-smell-guard.mjs --list",
    "design-elevation:check": "node scripts/design-elevation-guard.mjs",
    "design-elevation:selftest": "node scripts/design-elevation-guard.mjs --selftest",
    "design-elevation:list": "node scripts/design-elevation-guard.mjs --list",
    "design-elevation:update-baseline": "node scripts/design-elevation-guard.mjs --update-baseline",
    "design-elevation:runtime": "node scripts/design-elevation-runtime-check.mjs",
    "design-elevation:runtime:selftest": "node scripts/design-elevation-runtime-check.mjs --selftest",
    "design-primary-focus:check": "node scripts/design-primary-focus-guard.mjs",
    "design-primary-focus:selftest": "node scripts/design-primary-focus-guard.mjs --selftest",
    "design-primary-focus:list": "node scripts/design-primary-focus-guard.mjs --list",
    "design-primary-focus:update-baseline": "node scripts/design-primary-focus-guard.mjs --update-baseline",
    "design-primary-focus:runtime": "node scripts/design-primary-focus-runtime-check.mjs",
    "design-primary-focus:runtime:selftest": "node scripts/design-primary-focus-runtime-check.mjs --selftest",
    "color:baseline:update": "node scripts/color-token-audit.mjs --update-baseline --baseline scripts/color-audit-baseline.json",
    "color:baseline:stale": "node scripts/color-baseline-stale.mjs",
    "ui:sweep:selftest": "node scripts/ui-sweep.mjs --selftest",
    "ui:sweep:pages": "node scripts/ui-sweep.mjs --strict",
    "ui:sweep:overlays": "node scripts/ui-sweep.mjs --overlays --strict",
    "census:table:mobile": "node scripts/compact-table-census.mjs --root ../web-mobile/src",
    "file-inputs:check": "node scripts/file-input-census.mjs",
    "file-inputs:self-test": "node scripts/file-input-census.mjs --self-test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "chart.js": "^4.5.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.4",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "0.25.12",
    "jsdom": "^24.1.3",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.7"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "glob": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2.1.7": "2.1.7",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
