{
  "name": "llm-gateway-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-css-media-syntax.mjs && node scripts/verify-touch-targets.mjs && node scripts/verify-i18n-parity.mjs && node scripts/verify-comment-boundaries.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:stability": "node scripts/run-vitest-stability.mjs",
    "css:check": "node scripts/verify-css-media-syntax.mjs",
    "touch:check": "node scripts/verify-touch-targets.mjs",
    "i18n:check": "node scripts/verify-i18n-parity.mjs",
    "comment:check": "node scripts/verify-comment-boundaries.mjs",
    "audit:selftest": "node scripts/layout-audit-selftest.mjs",
    "audit:settle": "node scripts/settle-selftest.mjs",
    "gate:selftest": "node scripts/verify-css-media-syntax.selftest.mjs && node scripts/verify-touch-targets.selftest.mjs && node scripts/verify-i18n-parity.selftest.mjs && node scripts/verify-comment-boundaries.selftest.mjs && node scripts/anchor-check.selftest.mjs",
    "audit:web": "node scripts/layout-audit-web.mjs",
    "audit:anchors": "node scripts/anchor-check.mjs"
  },
  "dependencies": {
    "pinia": "4.0.2",
    "qrcode": "^1.5.4",
    "vue": "3.5.43",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "glob@>=10.2.0 <10.5.0": "10.5.0"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "10.5.0"
    }
  }
}
