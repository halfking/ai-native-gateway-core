{
  "name": "llm-gateway-web-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "LLM Gateway mobile ops frontend (Hyper-type SPA, mounted at /m)",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vue-tsc --noEmit && node scripts/verify-css-media-syntax.mjs && vite build",
    "css:check": "node scripts/verify-css-media-syntax.mjs",
    "css:selftest": "node scripts/verify-css-media-syntax.mjs --self-test",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "5.0.2",
    "vue-tsc": "^2.2.0"
  }
}
