deploy/sql/objects/


# Historical-secret sources used only by public-mirror rewrite tooling.
/scripts/scan-secrets.private.replacements

# 环境变量（明文，不提交）
# Spec cf8aad1a9 §SOPS and Credentials: only encrypted forms are
# trackable. Plaintext .env.* keys are sourced exclusively from
# env-injector at deploy time; they never enter the repository.
.env.local
.env.71
.env.184
.env.252
.env.kaixuan-1
.env.*.user
.env.*.local
.env.*.production

# 加密文件可提交（每个目标对应一个 .env.<target>.enc）
# 与 `.env.<target>` plaintext 行相反——这些是显式 allow-list，
# 覆盖更上面可能存在的 `*.enc` 忽略规则。
!.env.71.enc
!.env.184.enc
!.env.252.enc
!.env.kaixuan-1.enc
deployment-report-*.md
FINAL_AUDIT_REPORT_*.md

# Credential rotation log — produced by scripts/rotate-credentials.sh,
# per-environment state (commit hashes, key lengths, backup paths).
# The empty template commit keeps the directory tracked; runtime
# entries are gitignored so they don't leak into other branches.
docs/changelogs/credential-rotation.log
!docs/changelogs/credential-rotation.log.keep

FINAL_SUMMARY_REPORT.md
FINAL_SUMMARY.md
FINAL_COMPLETION_REPORT.md
*_REPORT.md
*_SUMMARY.md
*_AUDIT.md
TEST_RESULTS_*.md
test_output.log
reports/
# loadtest / 多页面测试 runtime JSON outputs (run artifacts, not source)
# 触发: docs/<feature>/results/*.json (如 docs/全方面测试/results/S*.json)
docs/**/results/*.json

# 2026-08-17: docs-archive overhaul
# 历史过程文档（bugfix / audit / fix / phase / handoff / deploy-report / summary / report）
# 统一归档到 docs/archive/，需要保留历史可追溯，**不应用上面的 SUMMARY/REPORT/AUDIT 排除规则**
!docs/archive/**/*_SUMMARY.md
!docs/archive/**/*_REPORT.md
!docs/archive/**/*_AUDIT.md
!docs/archive/**/TEST_RESULTS_*.md

