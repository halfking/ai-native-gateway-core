# ─────────────────────────────────────────────────────────────────────────────
# SI-LLM-Gateway 敏感信息扫描规则
# 格式: category|severity|description|regex_pattern
# severity: BLOCK (硬阻断) | WARN (警告) | INFO (信息)
# 注意: 使用 grep -E 引擎 (POSIX ERE)，全规则自动大小写不敏感
# ─────────────────────────────────────────────────────────────────────────────

# ===== 硬阻断：密钥 / Token =====
LLM_APIKEY|BLOCK|OpenAI API key|sk-[A-Za-z0-9]{32,}
LLM_APIKEY|BLOCK|OpenAI project key|sk-proj-[A-Za-z0-9_-]{32,}
LLM_APIKEY|BLOCK|Anthropic API key|sk-ant-[A-Za-z0-9_-]{32,}
LLM_APIKEY|BLOCK|Google AI Studio key|AIza[0-9A-Za-z_-]{35}
LLM_APIKEY|BLOCK|Stripe live key|sk_live_[A-Za-z0-9]{24,}
LLM_APIKEY|BLOCK|Stripe test key|sk_test_[A-Za-z0-9]{24,}
LLM_APIKEY|BLOCK|AWS Access Key|AKIA[0-9A-Z]{16}
LLM_APIKEY|BLOCK|AWS Secret Key assignment|aws_secret_access_key[[:space:]]*[:=][[:space:]]*['"][A-Za-z0-9/+=]{40}['"]

# GitHub tokens
GH_TOKEN|BLOCK|GitHub personal token|ghp_[A-Za-z0-9]{36}
GH_TOKEN|BLOCK|GitHub OAuth token|gho_[A-Za-z0-9]{36}
GH_TOKEN|BLOCK|GitHub user token|ghu_[A-Za-z0-9]{36}
GH_TOKEN|BLOCK|GitHub server token|ghs_[A-Za-z0-9]{36}
GH_TOKEN|BLOCK|GitHub refresh token|ghr_[A-Za-z0-9]{36}
GH_TOKEN|BLOCK|GitHub fine-grained token|github_pat_[A-Za-z0-9_]{82}

# 通用私钥 / 证书
PRIVATE_KEY|BLOCK|RSA/EC/SSH private key|-----[A-Z ]*BEGIN [A-Z ]*PRIVATE KEY-----
PRIVATE_KEY|BLOCK|OpenSSH private key|-----[A-Z ]*BEGIN OPENSSH PRIVATE KEY-----
PRIVATE_KEY|BLOCK|PGP private key|-----[A-Z ]*BEGIN PGP PRIVATE KEY BLOCK-----
PRIVATE_KEY|BLOCK|DSA private key|-----[A-Z ]*BEGIN DSA PRIVATE KEY-----

# JWT (粗略)
JWT|BLOCK|JSON Web Token|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}

# Slack
SLACK_TOKEN|BLOCK|Slack token|xox[abprs]-[A-Za-z0-9-]{10,}
SLACK_WEBHOOK|BLOCK|Slack webhook|https://hooks\.slack\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+

# 数据库连接串（带明文密码）
DB_CONNSTRING|BLOCK|Postgres conn string with password|postgres(ql)?://[^:/[:space:]]+:[^@/[:space:]]+@[^/[:space:]]+
DB_CONNSTRING|BLOCK|MySQL conn string with password|mysql://[^:/[:space:]]+:[^@/[:space:]]+@[^/[:space:]]+
DB_CONNSTRING|BLOCK|MongoDB conn string with password|mongodb(\+srv)?://[^:/[:space:]]+:[^@/[:space:]]+@[^/[:space:]]+
DB_CONNSTRING|BLOCK|Redis conn string with password|redis://[^:/[:space:]]*:[^@/[:space:]]+@[^/[:space:]]+
DB_CONNSTRING|BLOCK|Connection string with password|://[^:/[:space:]]+:[^@/[:space:]]{4,}@[^/[:space:]]+

# SSH 密码 (排除 ${VAR} 引用，要求字面值 ≥ 8 字符)
SSH_PASSWORD|BLOCK|SSH password assignment|K8S_SSH_PASSWORD[[:space:]]*=[[:space:]]*['\"][^$\'\"]{8,}['\"]
SSH_PASSWORD|BLOCK|Generic SSH password assignment|SSH_PASSWORD[[:space:]]*=[[:space:]]*['\"][^$\'\"]{8,}['\"]

# ===== 警告：内网信息 =====
INTERNAL_IP|WARN|RFC1918 10.x private IP|\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b
INTERNAL_IP|WARN|RFC1918 172.16-31.x private IP|\b172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]{1,3}\.[0-9]{1,3}\b
INTERNAL_IP|WARN|RFC1918 192.168.x private IP|\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b
INTERNAL_DOMAIN|WARN|Internal domain kxpms\.cn|kxpms\.cn
INTERNAL_DOMAIN|WARN|Internal domain kxpms\.com|kxpms\.com

# 凭据赋值模式（更宽松）
CRED_ASSIGN|WARN|Password/secret assignment|(password|passwd|pwd|secret|api_key|apikey|auth_token|access_token|bearer_token)[[:space:]]*[:=][[:space:]]*['\"][^'\"[:space:]]{8,}['\"]

# 业务邮箱
INTERNAL_EMAIL|WARN|Business email at kxpms\.cn|[A-Za-z0-9._%+-]+@kxpms\.cn

# 已知硬编码密钥 (来自仓库 baseline)
KNOWN_LEAK|BLOCK|Known leaked DB password (cmd/test_sql/main.go)|4Q92cFTaYY8Z3AO07XTBBH-1g7kceaxg
KNOWN_LEAK|BLOCK|Known leaked API key hash pattern|111\.0\.232\.226.*['\"][0-9a-f]{64}['\"]
KNOWN_LEAK|BLOCK|Old K8S SSH password literal|Kaixuan2025&9900#
KNOWN_LEAK|BLOCK|Known Xiaomi API key literal|tp-cia63detlzzaz731c3q3gebwi7ab6y1fas5r4sajo8n11l4m

# ===== 文件级检查：拒绝追踪的敏感文件类型 =====
SECRET_FILE|BLOCK|.env file pattern|\.env(\.|$)
SECRET_FILE|BLOCK|secrets.json file|secrets\.json$
SECRET_FILE|BLOCK|credentials.json file|credentials\.json$
SECRET_FILE|BLOCK|PEM private key file|\.pem$
SECRET_FILE|BLOCK|Private key file|\.key$
SECRET_FILE|BLOCK|PKCS12 file|\.p12$
SECRET_FILE|BLOCK|PFX file|\.pfx$
SECRET_FILE|BLOCK|Kubeconfig file|kubeconfig
SECRET_FILE|BLOCK|SSH private key|^id_rsa
SECRET_FILE|BLOCK|SSH ed25519 private key|^id_ed25519
