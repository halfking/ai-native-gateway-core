<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@SERVICE_NAME@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PREFIX@/current/scripts/lifecycle/service-runner.sh</string>
    <string>--config</string><string>@CONFIG_FILE@</string>
    <string>--binary</string><string>@PREFIX@/current/bin/gateway</string>
  </array>
  <key>WorkingDirectory</key><string>@PREFIX@/current</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@LOG_DIR@/gateway.log</string>
  <key>StandardErrorPath</key><string>@LOG_DIR@/gateway.error.log</string>
  <key>Umask</key><integer>63</integer>
</dict>
</plist>
