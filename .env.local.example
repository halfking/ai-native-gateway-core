#!/usr/bin/env bash
# deploy-local.sh 环境变量配置示例
# 
# 使用方法:
#   cp .env.local.example .env.local
#   # 编辑 .env.local 设置实际的数据库密码和密钥
#   source .env.local
#   ./scripts/deploy-local.sh deploy

# 本地开发数据库配置
# 根据实际环境修改用户名、密码和数据库名
export LLM_GATEWAY_DATABASE_URL="postgres://postgres:yourpassword@127.0.0.1:5432/llm_gateway_dev?sslmode=disable"

# ============================================================================
# 安全密钥配置（重要！）
# ============================================================================
# 
# 以下两个密钥 **必须是固定值**，一旦设置就不能变更：
#
# 1. LLM_GATEWAY_SECRET_KEY
#    - 用途：签发 admin 会话 token
#    - 变更影响：所有已签发的会话失效
#
# 2. LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY
#    - 用途：加密/解密 provider 凭据（API key）
#    - 变更影响：数据库中所有 credentials.secret_ciphertext 无法解密
#    - 故障症状：providers 的 API key 全部显示 decrypt_failed
#    - 参考事故：2026-09-05 provider 587 凭据解密失败
#
# ============================================================================
# 配置场景选择（二选一）
# ============================================================================
#
# 【场景 A】全新安装（空数据库）
# --------------------------------
# 首次安装时生成新密钥（仅执行一次，然后固定写入此文件）：
#
#   export LLM_GATEWAY_SECRET_KEY="$(openssl rand -base64 32)"
#   export LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY="$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
#
# 将生成的值替换下面的占位符，后续所有部署都使用相同值。
#
# 【场景 B】从远端同步数据库（245/252）
# ----------------------------------------
# 如果数据库是从 245 或 252 同步过来的，必须使用源环境的密钥：
#
#   # 从 245 同步密钥
#   ssh -p 25022 root@<env:HOST_245_IP> 'grep -E "^export (LLM_GATEWAY_SECRET_KEY|LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY)=" /opt/llm-gateway-go/.env'
#
#   # 从 252 同步密钥
#   ssh -p 25022 root@<env:HOST_252_IP> 'grep -E "^export (LLM_GATEWAY_SECRET_KEY|LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY)=" /opt/llm-gateway-go/.env'
#
# 将输出的完整 export 语句复制到下面。
#
# ============================================================================

export LLM_GATEWAY_SECRET_KEY="请替换为固定随机串（场景A生成或场景B同步）"
export LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY="请替换为固定 base64url 32 字节 key（场景A生成或场景B同步）"

# Admin API key 可以每次部署动态生成（不影响数据持久化）
export LLM_GATEWAY_ADMIN_API_KEY="$(openssl rand -base64 32)"

# ============================================================================
# 凭据解密冒烟测试配置（可选）
# ============================================================================
# 
# LLM_GATEWAY_DECRYPT_SMOKE_PROVIDER_ID
#   - 用途：指定部署后自动检查解密功能的 provider id
#   - 格式：逗号分隔的 provider id 列表（如 "587,18,1"）
#   - 默认行为（未设置时）：自动选择 active_credential_count 最高的前 3 个 provider
#   - 建议值：包含核心生产 provider（如 587=OpenAI, 18=Anthropic）
#   - 失败行为：解密失败时部署会自动回滚到旧版本
#
# 示例：
# export LLM_GATEWAY_DECRYPT_SMOKE_PROVIDER_ID="587,18,1"
#
# 如需禁用冒烟测试（不推荐）：
# export LLM_GATEWAY_SKIP_DECRYPT_SMOKE="true"


# ============================================================================
# 管理员账号配置
# ============================================================================
export LLM_GATEWAY_ADMIN_USER="admin"
export LLM_GATEWAY_ADMIN_PASSWORD="$(openssl rand -base64 16)"

# ============================================================================
# Redis 配置（可选）
# ============================================================================
# 用于会话管理和 URSM v2
export LLM_GATEWAY_REDIS_ADDR="127.0.0.1:6379"

# ============================================================================
# 服务端口配置（可选）
# ============================================================================
export SERVICE_PORT="8781"

# ============================================================================
# URSM v2 模式配置（可选）
# ============================================================================
# shadow: V1 主路径 + V2 影子写入
# authoritative: V2 为主路径
# export LLM_GATEWAY_URSM_V2_MODE="shadow"

# ============================================================================
# 无界增长表保留窗口（容量门禁整改，2026-09-05，可选）
# ============================================================================
# ursm_node_snapshot_min 快照保留天数（默认 30，0=禁用清理）
export URSM_SNAPSHOT_RETENTION_DAYS="30"
# request_stage_events 舞台事件保留天数（默认 7，0=禁用清理）
export STAGE_EVENTS_RETENTION_DAYS="7"

# ============================================================================
# 环境变量加载确认
# ============================================================================
echo "============================================"
echo "LLM Gateway 环境变量已加载"
echo "============================================"
echo "  DATABASE: ${LLM_GATEWAY_DATABASE_URL%%\?*}"  # 隐藏查询参数
echo "  ADMIN_USER: ${LLM_GATEWAY_ADMIN_USER}"
echo "  REDIS: ${LLM_GATEWAY_REDIS_ADDR:-未设置}"
echo "  PORT: ${SERVICE_PORT:-8781}"
echo ""
echo "密钥配置检查:"
if [[ -n "$LLM_GATEWAY_SECRET_KEY" && "$LLM_GATEWAY_SECRET_KEY" != "请替换为固定随机串"* ]]; then
  echo "  ✓ SECRET_KEY 已设置"
else
  echo "  ✗ SECRET_KEY 未设置或仍是占位符"
fi
if [[ -n "$LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY" && "$LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY" != "请替换为固定"* ]]; then
  echo "  ✓ CREDENTIAL_ENCRYPTION_KEY 已设置"
else
  echo "  ✗ CREDENTIAL_ENCRYPTION_KEY 未设置或仍是占位符"
  echo "    警告：部署可能因凭据解密门禁失败"
fi
echo "============================================"
