#!/usr/bin/env bash
# deploy-local.sh 环境变量配置示例
# 
# 使用方法:
#   cp .env.local.example .env.local
#   # 编辑 .env.local 设置实际的数据库密码
#   source .env.local
#   ./scripts/deploy-local.sh deploy

# 本地开发数据库配置
# 根据实际环境修改用户名、密码和数据库名
export LLM_GATEWAY_DATABASE_URL="postgres://postgres:yourpassword@127.0.0.1:5432/llm_gateway_dev?sslmode=disable"

# 安全密钥 —— 必须是固定值（仓库/环境一旦确定就不要变）：
#   LLM_GATEWAY_SECRET_KEY 变化会使已签发的 admin 会话全部失效；
#   LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY 变化会使库里所有
#   credentials.secret_ciphertext 无法解密（providers 的 apikey 全部
#   decrypt_failed，事故 2026-09-05 provider 587 即此因）。
# 若 DB 是从 245/252 同步的，这里的凭据加密 key 必须与源库所在环境一致。
# 首次全新安装（空库）可用下面注释掉的命令各生成一次，然后固定下来。
export LLM_GATEWAY_SECRET_KEY="请替换为固定随机串"
export LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY="请替换为固定 base64url 32 字节 key"
# export LLM_GATEWAY_SECRET_KEY="$(openssl rand -base64 32)"
# export LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY="$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
export LLM_GATEWAY_ADMIN_API_KEY="$(openssl rand -base64 32)"

# 部署后凭据解密冒烟的抽检对象（可选，逗号分隔 provider id；
# 缺省时按 active_credential_count 取前 3 家）
# export LLM_GATEWAY_DECRYPT_SMOKE_PROVIDER_ID="587"

# 管理员账号配置
export LLM_GATEWAY_ADMIN_USER="admin"
export LLM_GATEWAY_ADMIN_PASSWORD="$(openssl rand -base64 16)"

# Redis 配置（可选，用于会话管理和 URSM v2）
export LLM_GATEWAY_REDIS_ADDR="127.0.0.1:6379"

# 服务端口配置（可选，默认 8781）
export SERVICE_PORT="8781"

# URSM v2 模式配置（可选）
# shadow: V1 主路径 + V2 影子写入
# authoritative: V2 为主路径
# export LLM_GATEWAY_URSM_V2_MODE="shadow"

# 无界增长表保留窗口（容量门禁整改，2026-09-05，可选）
# ursm_node_snapshot_min 快照保留天数（默认 30，0=禁用清理）
# export URSM_SNAPSHOT_RETENTION_DAYS="30"
# request_stage_events 舞台事件保留天数（默认 7，0=禁用清理）
# export STAGE_EVENTS_RETENTION_DAYS="7"

echo "环境变量已加载:"
echo "  DATABASE: ${LLM_GATEWAY_DATABASE_URL}"
echo "  ADMIN_USER: ${LLM_GATEWAY_ADMIN_USER}"
echo "  REDIS: ${LLM_GATEWAY_REDIS_ADDR:-未设置}"
echo "  PORT: ${SERVICE_PORT:-8781}"
