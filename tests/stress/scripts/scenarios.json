[
  {
    "id": "s1_baseline_healthy",
    "name": "Baseline healthy — mock-stress-fast binds alpha/beta/gamma",
    "description": "Three bound mocks return 200 quickly. mock-stress-fast does NOT bind delta; do not claim 4-provider spread.",
    "plan_ref": "§5 baseline",
    "setup": [
      {"provider": "mock-alpha", "state": "healthy"},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 200,
      "concurrency": 20,
      "prompt": "short",
      "max_tokens": 32
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.99,
      "min_total_requests": 200,
      "require_providers": ["mock-alpha", "mock-beta", "mock-gamma"],
      "forbidden_providers": ["mock-delta"],
      "note": "mock-stress-fast (alpha/beta/gamma) all healthy → success ≥ 99%. Delta is unbound on this model."
    }
  },
  {
    "id": "s2_5xx_single_failure",
    "name": "Single 5xx — alpha returns 500 (failover to beta/gamma)",
    "description": "mock-alpha permanently returns 500. Expect gateway to redirect to beta/gamma.",
    "plan_ref": "§5.2 scenario 2 (5xx spike)",
    "setup": [
      {"provider": "mock-alpha", "state": "server_error"},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 200,
      "concurrency": 20,
      "prompt": "short",
      "max_tokens": 32
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.90,
      "min_total_requests": 200,
      "note": "alpha=500 → ≥90% traffic still succeeds via failover (alpha demoted within first ~10 reqs)."
    }
  },
  {
    "id": "s3_5xx_consecutive_unhealthy",
    "name": "Consecutive 5xx — alpha demoted to Unhealthy after threshold",
    "description": "alpha is hammered with 500s; gateway should record consecutive failures and stop routing to alpha.",
    "plan_ref": "§2 + §4 (degradation)",
    "setup": [
      {"provider": "mock-alpha", "state": "server_error"},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 100,
      "concurrency": 10,
      "prompt": "short",
      "max_tokens": 32
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.90,
      "min_total_requests": 100,
      "forbidden_status": [],
      "note": "After ≥3 consec-fail, gateway demotes alpha; remaining providers carry the load."
    }
  },
  {
    "id": "s4_provider_slowdown",
    "name": "Slow provider — alpha responses 5–30s; gateway weights shift",
    "description": "mock-alpha enters slow mode. Gateway's dynamic weighting should keep traffic flowing on fast paths.",
    "plan_ref": "§3.3 + §5.2 scenario 1",
    "setup": [
      {"provider": "mock-alpha", "state": "slow"},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 80,
      "concurrency": 16,
      "prompt": "short",
      "max_tokens": 16
    },
    "reset": true,
    "wait": "500ms",
    "expect": {
      "min_success_rate": 0.80,
      "min_total_requests": 80,
      "note": "Slow alpha still returns 200 → at least 80% should succeed even if slower."
    }
  },
  {
    "id": "s5_quota_exhausted",
    "name": "Quota exhausted — alpha returns 429; weight collapses, others carry traffic",
    "description": "alpha returns 429 quota_exceeded. Gateway should record and shift load away.",
    "plan_ref": "§5.2 scenario 3",
    "setup": [
      {"provider": "mock-alpha", "state": "quota_exceeded", "payload": {"recover_in_seconds": 30}},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 120,
      "concurrency": 12,
      "prompt": "short",
      "max_tokens": 32
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.90,
      "min_total_requests": 120,
      "note": "Quota 429s on alpha; ≥90% success via failover"
    }
  },
  {
    "id": "s6_all_providers_5xx",
    "name": "All providers 503 — graceful degradation",
    "description": "Catastrophic scenario: every mock returns 503. Gateway should return 503 to clients (no 500 leakage).",
    "plan_ref": "§5.2 scenario 4 (disaster)",
    "setup": [
      {"provider": "mock-alpha", "state": "no_available"},
      {"provider": "mock-beta", "state": "server_error"},
      {"provider": "mock-gamma", "state": "no_available"},
      {"provider": "mock-delta", "state": "server_error"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 40,
      "concurrency": 8,
      "prompt": "short",
      "max_tokens": 16
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.0,
      "max_success_rate": 0.0,
      "min_total_requests": 40,
      "require_status": [503],
      "forbidden_status": [200],
      "note": "All bound providers bad. Client must not see 200. Exhausted failover returns 503 (not 500/502 leak)."
    }
  },
  {
    "id": "s7_recovery_after_5xx",
    "name": "Recovery — alpha briefly 500s, then returns to healthy; weight ramps back",
    "description": "alpha goes 500 for 30s, then recovers. Gateway should re-enable traffic to alpha once failures stop.",
    "plan_ref": "§2.3 fast recovery + §4.2 upgrade",
    "setup": [
      {"provider": "mock-alpha", "state": "server_error"},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-fast",
      "stream": false,
      "total": 60,
      "concurrency": 6,
      "prompt": "short",
      "max_tokens": 32
    },
    "reset": true,
    "wait": "1s",
    "recovery": {
      "wait": "6s",
      "setup": [
        {"provider": "mock-alpha", "state": "healthy"},
        {"provider": "mock-beta", "state": "healthy"},
        {"provider": "mock-gamma", "state": "healthy"},
        {"provider": "mock-delta", "state": "healthy"}
      ],
      "request": {
        "model": "mock-stress-fast",
        "stream": false,
        "total": 80,
        "concurrency": 8,
        "prompt": "short",
        "max_tokens": 32
      }
    },
    "expect": {
      "min_success_rate": 0.90,
      "min_total_requests": 140,
      "require_providers": ["mock-alpha"],
      "note": "Phase 1 demotes alpha; phase 2 (after 6s probe) MUST send some traffic back to mock-alpha. Success-rate-only used to hide that alpha never returned."
    }
  },
