  {
    "id": "s10_stream_load",
    "name": "Stream load — 100 SSE streams @ concurrency 20",
    "description": "OpenAI-style SSE streams under load. Validates TTFB and full [DONE] delivery.",
    "plan_ref": "§11.4 stream completion 100%",
    "setup": [
      {"provider": "mock-alpha", "state": "healthy"},
      {"provider": "mock-beta", "state": "healthy"},
      {"provider": "mock-gamma", "state": "healthy"},
      {"provider": "mock-delta", "state": "healthy"}
    ],
    "request": {
      "model": "mock-stress-stream",
      "stream": true,
      "total": 100,
      "concurrency": 20,
      "prompt": "short",
      "max_tokens": 16
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.99,
      "min_total_requests": 100,
      "require_done": true,
      "min_done_rate": 0.99,
      "note": "SSE streams succeed ≥99% AND every success must include data: [DONE]."
    }
  },
  {
    "id": "s11_stream_broken_provider",
