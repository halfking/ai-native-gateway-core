      "stream": true,
      "total": 80,
      "concurrency": 12,
      "prompt": "short",
      "max_tokens": 16
    },
    "reset": true,
    "expect": {
      "min_success_rate": 0.50,
      "min_total_requests": 80,
      "min_done_rate": 0.50,
      "note": "broken_stream is NOT a 200 success. Failover to beta must produce [DONE]. acceptable_any was a lie that let 80/80 HTTP 200 pass."
    }
  },
