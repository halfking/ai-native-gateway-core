# tests/local/env.example — 本地环境变量样例
# 复制为 .env 后填入真实值：
#   cp env.example .env && vi .env

# Gateway listen
LLM_GATEWAY_LISTEN_ADDR=0.0.0.0:8781

# Local DB
LLM_GATEWAY_DATABASE_URL=postgres://llm_gateway:local_password@localhost:55432/llm_gateway?sslmode=disable

# Local Redis
LLM_GATEWAY_REDIS_ADDR=localhost:56379

# Mock upstream (when not using real LLM providers)
LLM_GATEWAY_MOCK_LLM_BASE_URL=http://localhost:6000

# Kill-switch (2026-07-12 incident response)
# Default: all empty (= all enabled).
# Set to 1 to disable for incident isolation:
#   KILL_SESSION_COMPRESSION=1
#   KILL_SESSION_CACHE=1
#   KILL_CIRCUIT_DEGRADATION=1
#   KILL_RATE_LIMITER=1
#   KILL_FP_SLOT=1

# Test API keys (seeded by 01-schema-bootstrap.sql)
TEST_API_KEY=sk-loc-1234567890abcdef
