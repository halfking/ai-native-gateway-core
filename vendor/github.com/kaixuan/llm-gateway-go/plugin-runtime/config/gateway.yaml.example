# LLM Gateway Configuration
# This file is monitored for changes and automatically reloaded

server:
  # Server listening address
  host: 0.0.0.0

  # Server listening port (1-65535)
  port: 8080

plugins:
  # Plugin directory path (must exist)
  directory: /etc/llm-gateway/plugins

  # List of enabled plugins
  enabled:
    - auth
    - rate-limit
    - logging
    - metrics

security:
  # Enable TLS/HTTPS
  tls_enabled: false

  # TLS certificate file (required if tls_enabled is true)
  # cert_file: /etc/llm-gateway/certs/server.crt

  # TLS private key file (required if tls_enabled is true)
  # key_file: /etc/llm-gateway/certs/server.key
