#!/usr/bin/env bash
***REMOVED***
# .githooks/pre-push — SI-LLM-Gateway 双仓库推送保护
#
# v2 Phase 3B-3 + 3B-4: 在原有 sensitive-info scan 之上，新增 11 套 shell
# 测试 + 1 套可选 Go test gate (RUN_GO_TESTS=1)。operator 可通过
# SKIP_TESTS=1 / STRICT_SCANNER=1 / git push --no-verify 跳过。
#
# 默认使用 --mode=normal（WARN 不阻断）— 与本地 `scan-secrets.sh`
# 调用行为一致。需要严格模式（任何 finding 阻断）时：
#   STRICT_SCANNER=1 git push …
#
# 测试 gate 默认开启（每次 push ~30-60s）。紧急绕过：
#   SKIP_TESTS=1 git push …
***REMOVED***
set -uo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

if [[ -z "$remote_name" || -z "$remote_url" ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"

# ── 0. Worktree sanity guard ────────────────────────────────────────────
# Shared checkouts have twice (2026-09-30 05:09 / 05:24) been found with
# core.bare=true + core.worktree in the module config — an invalid state
# written by unknown tooling. It makes `git status`/`git check-ignore`
# exit 128 ("must be run in a work tree") and breaks `go build` VCS
# stamping tree-wide. Heal before scanning/testing so the gate fails on
# real findings, not on a poisoned host config.
# 三十七轮 §三#14 (2026-09-30): 这段守卫原先排在 github-only 早退之后，
# 推 codeup（主远端）时永远走不到；现移到早退之前，所有远端的推送都
# 触发自愈。pre-commit 侧同款守卫见 scripts/pre-commit-check.sh §0。
if [[ "$(git -C "$repo_root" rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]]; then
  if [[ "$(git -C "$repo_root" config core.bare 2>/dev/null)" == "true" ]]; then
    git -C "$repo_root" config core.bare false
    echo "⚠️  healed core.bare=true + core.worktree conflict (was breaking git ops + go build VCS stamping)" >&2
  fi
fi

# 仅对 github 远端做严格检查
if [[ "$remote_url" != *"github.com"* ]]; then
  exit 0
fi

scanner="$repo_root/scripts/scan-secrets.sh"

# ── 1. Sensitive-info scan (BLOCK-level findings) ────────────────────────

if [[ ! -x "$scanner" ]]; then
  echo "⚠️  scan-secrets.sh not found or not executable: $scanner" >&2
  echo "    Run: ./scripts/install-githooks.sh" >&2
fi

echo "🔍 GitHub push detected — running sensitive-info scan (normal mode)..."

# v2 Phase 3B-4: pre-push uses --mode=normal, not strict, so that
# only BLOCK findings block the push. WARN findings (e.g. docs with
# placeholder URLs, scrubbed KNOWN_LEAK test values) are visible
# but non-blocking — same behavior we get from `scan-secrets.sh`
# called locally. Operators running in --mode=strict can opt in
# per-push via STRICT_SCANNER=1.
scan_mode=normal
[[ "${STRICT_SCANNER:-0}" == "1" ]] && scan_mode=strict

scan_failed=0
if [[ -x "$scanner" ]]; then
  baseline="$repo_root/scripts/scan-secrets.baseline"
  baseline_arg=""
  [[ -f "$baseline" ]] && baseline_arg="--baseline=$baseline"
  # mktemp 而非固定 /tmp/scan-output.txt（三十七轮审计）：并发推送互踩 +
  # 扫描摘录 0644 对同机其他用户可读。
  scan_out="$(mktemp "${TMPDIR:-/tmp}/scan-output.XXXXXX")"
  if ! "$scanner" --mode="$scan_mode" --paths=. --tracked-only $baseline_arg --format=text >"$scan_out" 2>&1; then
    echo "❌ Sensitive findings detected:" >&2
    head -50 "$scan_out" >&2
    scan_failed=1
  fi
  rm -f "$scan_out"
fi

if [[ $scan_failed -eq 1 ]]; then
  echo "" >&2
  echo "🚫 Push to GitHub BLOCKED by pre-push hook." >&2
  echo "" >&2
  echo "   If you believe these are false positives:" >&2
  echo "   1. Add an entry to scripts/scan-secrets.baseline with the file:line:category" >&2
  echo "   2. Or run: git push --no-verify github  (use with extreme caution)" >&2
  echo "" >&2
  exit 1
fi

# ── 2. v2 Phase 3B-3: 11-suite shell test gate ──────────────────────────

if [[ "${SKIP_TESTS:-0}" == "1" ]]; then
  echo "⏩ SKIP_TESTS=1 — skipping test gate (use only with extreme caution)"
else
  echo "🧪 Running 11-suite shell test gate (v2 Phase 3B-3)..."

  # ── Git env 消毒（三十七轮续五根修，2026-10-01）────────────────────
  # 真实 push 时 git 向本钩子导出 GIT_DIR（指向 module gitdir）。套件若为
  # 自建 fixture 跑 `git init`（bump_version_collision_test.sh:34，三秒
  # 复现），会在毒化态下 reinit 本仓 gitdir 并写入 core.bare=true——
  # 数周"未知工具毒化"与多轮 github 门集体假红的同一根源。套件必须
  # 在中性 git 环境里执行；钩子自身的 git 调用都在此之前已用绝对路径
  # 完成，不受影响。
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
        GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_QUARANTINE_PATH

  test_failures=0
  while IFS= read -r t; do
    # Ensure executable — some tests are tracked without +x bit.
    chmod +x "$t" 2>/dev/null || true
    # Per-suite timeout to bound the gate (60s is generous for
    # the existing shells).
    test_name=$(basename "$t")
    echo -n "  $test_name: "
    # 每套独立日志（三十七轮续五）：此前共写 /tmp/test-$$.log，多套同败时
    # 互相覆盖只剩最后一套；失败日志保留供排障，通过即清。
    log_file="/tmp/test-${test_name}-$$.log"
    if timeout 60 bash "$t" > "$log_file" 2>&1; then
      summary=$(grep -E "summary:" "$log_file" | tail -1)
      [[ -n "$summary" ]] && summary="  $summary"
      echo "PASS${summary}"
      rm -f "$log_file"
    else
      echo "FAIL (see $log_file)"
      test_failures=$((test_failures + 1))
    fi
  done < <(find "$repo_root/tests" -maxdepth 1 -name '*.sh' -print | sort)

  if [[ $test_failures -gt 0 ]]; then
    echo "" >&2
    echo "🚫 Push to GitHub BLOCKED: ${test_failures} test suite(s) failed." >&2
    echo "" >&2
    echo "   To bypass (NOT recommended):" >&2
    echo "     SKIP_TESTS=1 git push …   (CI/quick-push only)" >&2
    echo "     git push --no-verify …    (last resort)" >&2
    echo "" >&2
    exit 1
  fi
fi

# ── 3. v2 Phase 3B-3: Go unit tests (opt-in via RUN_GO_TESTS=1) ────────────

# Running all Go tests takes ~25s for licensing + ~3s for envinjector
# on developer machines; CI pipelines run them separately. We make
# this opt-in so contributors do not pay the cost on every push by
# default. Operators wanting full coverage pre-push can set:
#   RUN_GO_TESTS=1 git push …
if [[ "${RUN_GO_TESTS:-0}" == "1" ]]; then
  echo "🐹 Running Go unit tests (RUN_GO_TESTS=1)..."
  if command -v go >/dev/null 2>&1; then
    if ! (cd "$repo_root" && go test ./licensing/... ./envinjector/... -count=1 -timeout=180s) > /tmp/go-test-$$.log 2>&1; then
      echo "❌ Go unit tests failed." >&2
      tail -20 /tmp/go-test-$$.log | sed 's/^/    /'
      rm -f /tmp/go-test-$$.log
      exit 1
    fi
    rm -f /tmp/go-test-$$.log
  else
    echo "⚠️  go not in PATH — skipping Go-test gate" >&2
  fi
fi

echo "✅ Scan clean + tests passing — push to GitHub allowed"
exit 0
