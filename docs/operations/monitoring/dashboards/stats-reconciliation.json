{
  "dashboard": {
    "title": "运营体系 - 统计对账监控",
    "tags": ["operations", "stats", "reconciliation"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "统计对账Gap率",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "abs((stats_minute_client_count - stats_minute_rollup_count) / stats_minute_client_count) * 100",
            "legendFormat": "Gap百分比",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 2, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"},
          "tooltip": {"mode": "multi"}
        },
        "alert": {
          "name": "统计Gap率过高",
          "conditions": [
            {
              "evaluator": {"params": [2], "type": "gt"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "统计对账Gap率超过2%阈值",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 2,
        "title": "重扫臂延迟",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "(time() - stats_minute_rollup_last_resweep_timestamp) / 60",
            "legendFormat": "延迟(分钟)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "m",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 3, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "reduceOptions": {"calcs": ["lastNotNull"]}
        }
      },
      {
        "id": 3,
        "title": "Event Inbox积压",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "event_inbox_pending_count",
            "legendFormat": "未处理事件",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5000, "color": "yellow"},
                {"value": 10000, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "reduceOptions": {"calcs": ["lastNotNull"]}
        }
      },
      {
        "id": 4,
        "title": "成本链完整性",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "(1 - sum(request_stats_minute_cost_usd_zero_count) / sum(request_stats_minute_total_count)) * 100",
            "legendFormat": "有效成本占比",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 80, "color": "yellow"},
                {"value": 95, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 5,
        "title": "分钟级统计趋势",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "rate(stats_minute_client_count[5m])",
            "legendFormat": "Client面请求/分钟",
            "refId": "A"
          },
          {
            "expr": "rate(stats_minute_rollup_count[5m])",
            "legendFormat": "Rollup面请求/分钟",
            "refId": "B"
          },
          {
            "expr": "rate(usage_ledger_total_count[5m])",
            "legendFormat": "Ledger面请求/分钟",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqpm"
          }
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"]},
          "tooltip": {"mode": "multi"}
        }
      },
      {
        "id": 6,
        "title": "Gap分钟级分布 (Top 10)",
        "type": "table",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "topk(10, abs((stats_minute_client_count - stats_minute_rollup_count) / stats_minute_client_count) * 100)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "minute_timestamp": "分钟",
                "Value": "Gap%"
              }
            }
          }
        ],
        "options": {
          "sortBy": [{"displayName": "Gap%", "desc": true}]
        }
      },
      {
        "id": 7,
        "title": "重扫臂执行频率",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(stats_minute_resweep_executions_total[5m]) * 60",
            "legendFormat": "执行次数/分钟",
            "refId": "A"
          },
          {
            "expr": "rate(stats_minute_resweep_errors_total[5m]) * 60",
            "legendFormat": "错误次数/分钟",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "cpm"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {"text": "Prometheus", "value": "Prometheus"}
        },
        {
          "name": "time_range",
          "type": "interval",
          "query": "5m,15m,30m,1h,6h,12h,1d",
          "current": {"text": "30m", "value": "30m"}
        }
      ]
    },
    "time": {
      "from": "now-3h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m"]
    }
  }
}
