{
  "dashboard": {
    "title": "LLM Gateway - SSE Validation Monitoring",
    "tags": ["llm-gateway", "sse", "validation", "production"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
    },
    "panels": [
      {
        "id": 1,
        "title": "Malformed SSE Frame 总数（按 Provider）",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_malformed_sse_frame_total[5m])) by (provider)",
            "legendFormat": "{{provider}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqps",
            "min": 0
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "right"}
        }
      },
      {
        "id": 2,
        "title": "Malformed SSE Frame 总数（按 Stage）",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_malformed_sse_frame_total[5m])) by (stage)",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqps",
            "min": 0
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "right"}
        }
      },
      {
        "id": 3,
        "title": "Malformed SSE Frame 错误率 (%)",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_malformed_sse_frame_total[5m])) / sum(rate(llm_gateway_stream_chunks_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "orange"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 4,
        "title": "请求成功率 (%)",
        "type": "gauge",
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_requests_total{status=\"success\"}[5m])) / sum(rate(llm_gateway_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 70, "color": "orange"},
                {"value": 85, "color": "yellow"},
                {"value": 95, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 5,
        "title": "服务健康状态",
        "type": "stat",
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "up{job=\"llm-gateway\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "none",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 6,
        "title": "请求 QPS（按状态）",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_requests_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "stacking": {"mode": "normal"}
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 7,
        "title": "MiniMax 模型请求成功率",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_requests_total{provider=~\".*minimax.*\",status=\"success\"}[5m])) / sum(rate(llm_gateway_requests_total{provider=~\".*minimax.*\"}[5m])) * 100",
            "legendFormat": "MiniMax Success Rate",
            "refId": "A"
          },
          {
            "expr": "sum(rate(llm_gateway_requests_total{provider=~\".*glm.*\",status=\"success\"}[5m])) / sum(rate(llm_gateway_requests_total{provider=~\".*glm.*\"}[5m])) * 100",
            "legendFormat": "GLM Success Rate",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "bottom"}
        }
      },
      {
        "id": 8,
        "title": "响应延迟分布（P50, P95, P99）",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(llm_gateway_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(llm_gateway_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(llm_gateway_request_duration_seconds_bucket[5m]))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 0,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "s"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 9,
        "title": "错误类型分布（Top 10）",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "topk(10, sum(rate(llm_gateway_requests_total{status=\"failed\"}[5m])) by (error_kind))",
            "legendFormat": "{{error_kind}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 1,
              "fillOpacity": 20,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "last"]}
        }
      },
      {
        "id": 10,
        "title": "Malformed Frame 详细统计（最近 5 分钟）",
        "type": "table",
        "gridPos": {"x": 0, "y": 30, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(llm_gateway_malformed_sse_frame_total[5m])) by (provider, stage, client_model)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {},
              "renameByName": {
                "provider": "Provider",
                "stage": "Stage",
                "client_model": "Client Model",
                "Value": "Count (5m)"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "Count (5m)", "desc": true}]
        }
      },
      {
        "id": 11,
        "title": "Survival Resume Blocked 事件",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 38, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_survival_resume_blocked_total[5m])) by (reason)",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "ops"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 12,
        "title": "合成 [DONE] 标记统计",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 38, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(llm_gateway_stream_synthesized_done_total[5m])) by (provider)",
            "legendFormat": "{{provider}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "ops"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "-- Grafana --",
          "enable": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "tags": ["deployment"]
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "text": "Prometheus",
            "value": "Prometheus"
          }
        },
        {
          "name": "environment",
          "type": "constant",
          "query": "154-production",
          "current": {
            "text": "154-production",
            "value": "154-production"
          }
        }
      ]
    }
  },
  "overwrite": true,
  "alerts": [
    {
      "name": "SSE Malformed Frame Rate - Warning",
      "condition": "sum(rate(llm_gateway_malformed_sse_frame_total[5m])) / sum(rate(llm_gateway_stream_chunks_total[5m])) * 100 > 5",
      "frequency": "1m",
      "for": "5m",
      "severity": "warning",
      "annotations": {
        "description": "Malformed SSE frame rate is above 5% for 5 minutes. Current value: {{ $value }}%",
        "summary": "High malformed SSE frame rate detected"
      }
    },
    {
      "name": "SSE Malformed Frame Rate - Critical",
      "condition": "sum(rate(llm_gateway_malformed_sse_frame_total[5m])) / sum(rate(llm_gateway_stream_chunks_total[5m])) * 100 > 10",
      "frequency": "1m",
      "for": "5m",
      "severity": "critical",
      "annotations": {
        "description": "Malformed SSE frame rate is above 10% for 5 minutes. Current value: {{ $value }}%. Immediate action required!",
        "summary": "Critical: Very high malformed SSE frame rate"
      }
    },
    {
      "name": "LLM Gateway Service Down",
      "condition": "up{job=\"llm-gateway\"} == 0",
      "frequency": "30s",
      "for": "1m",
      "severity": "critical",
      "annotations": {
        "description": "LLM Gateway service is down for more than 1 minute.",
        "summary": "LLM Gateway service is not responding"
      }
    },
    {
      "name": "Request Success Rate Low - Warning",
      "condition": "sum(rate(llm_gateway_requests_total{status=\"success\"}[5m])) / sum(rate(llm_gateway_requests_total[5m])) * 100 < 85",
      "frequency": "1m",
      "for": "10m",
      "severity": "warning",
      "annotations": {
        "description": "Request success rate is below 85% for 10 minutes. Current value: {{ $value }}%",
        "summary": "Low request success rate"
      }
    },
    {
      "name": "Request Success Rate Low - Critical",
      "condition": "sum(rate(llm_gateway_requests_total{status=\"success\"}[5m])) / sum(rate(llm_gateway_requests_total[5m])) * 100 < 70",
      "frequency": "1m",
      "for": "5m",
      "severity": "critical",
      "annotations": {
        "description": "Request success rate is below 70% for 5 minutes. Current value: {{ $value }}%. Check service immediately!",
        "summary": "Critical: Very low request success rate"
      }
    },
    {
      "name": "MiniMax Model High Error Rate",
      "condition": "sum(rate(llm_gateway_requests_total{provider=~\".*minimax.*\",status=\"failed\"}[5m])) / sum(rate(llm_gateway_requests_total{provider=~\".*minimax.*\"}[5m])) * 100 > 20",
      "frequency": "1m",
      "for": "10m",
      "severity": "warning",
      "annotations": {
        "description": "MiniMax provider error rate is above 20% for 10 minutes. Current value: {{ $value }}%",
        "summary": "High error rate for MiniMax models"
      }
    }
  ],
  "meta": {
    "version": "1.0",
    "created": "2026-08-29",
    "updated": "2026-08-29",
    "description": "Grafana dashboard for monitoring SSE validation feature in LLM Gateway production environment"
  }
}
