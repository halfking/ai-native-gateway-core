# AI Native Gateway - Quick Start Environment Variables
# Copy this file to .env before running docker-compose.quickstart.yml
#
# SECURITY: Generate strong random values for all keys below!
# Example generation commands:
#   openssl rand -hex 32
#   openssl rand -base64 32

# PostgreSQL and Redis passwords
POSTGRES_PASSWORD=your_secure_postgres_password_here
REDIS_PASSWORD=your_secure_redis_password_here

# Gateway encryption and authentication keys
# REQUIRED: Must be set before first startup
CREDENTIAL_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
SECRET_KEY=your_secret_key_for_sessions_here
API_KEY=your_api_key_for_data_plane_here
ADMIN_API_KEY=your_admin_api_key_for_control_plane_here

# Quick start values - replace with secure random strings:
# POSTGRES_PASSWORD=$(openssl rand -hex 16)
# REDIS_PASSWORD=$(openssl rand -hex 16)
# CREDENTIAL_ENCRYPTION_KEY=$(openssl rand -hex 32)
# SECRET_KEY=$(openssl rand -base64 32)
# API_KEY=sk-$(openssl rand -hex 16)
# ADMIN_API_KEY=admin-$(openssl rand -hex 16)
