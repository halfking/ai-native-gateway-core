# Dev Research 本地集成环境变量模板
# ─────────────────────────────────────────────────────────────────────────────
# 用法:
#   cp .env.dev-research.example .env.dev-research
#   chmod 0600 .env.dev-research
#   vim .env.dev-research      # 填入真实本地凭证
#
# 安全: 本文件包含本地数据库/Redis/encryption 凭证, 仅本地使用, 严禁提交到 git。
# .gitignore 已忽略 .env.dev-research。
#
# 凭证说明:
#   POSTGRES_PASSWORD         复用 host llm-gateway-pg 的密码 (问同事)
#   REDIS_PASSWORD            dev-research redis 本地无密码; 仅占位
#   LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY   32-byte base64url, 用于解密 provider credentials
#                                            (dev-research 与 local-deploy-test 不可混用!)
#   LLM_GATEWAY_JWT_SECRET    JWT 签名密钥, dev 路径固定值即可
#   LLM_GATEWAY_ADMIN_API_KEY /api/admin/* 鉴权 token
#   LLM_GATEWAY_SEED_ADMIN_PASSWORD 首次启动时 seed 的 admin 密码 (本地用, 简单即可)
#
# 默认连接目标 (复用本机 host 共享 PG):
#   POSTGRES_HOST=host.docker.internal
#   POSTGRES_PORT=5432
#   POSTGRES_DB=llm_gateway_test_dev
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (host 共享 llm-gateway-pg, db 由本组占用, 与主库隔离)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=kxuser
POSTGRES_PASSWORD=__set_in_local_only__
POSTGRES_DB=llm_gateway_test_dev

# Redis (compose 内服务, 无密码)
REDIS_PORT=6379

# 32-byte base64url, 用于解密已存的 provider credentials
# dev-research 自己的 key, 不要与部署环境共享
# 生成: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
LLM_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=__set_in_local_only__

# JWT signing secret (任意固定值, dev 路径即可)
LLM_GATEWAY_JWT_SECRET=__set_in_local_only__

# Admin API token (/api/admin/*)
LLM_GATEWAY_ADMIN_API_KEY=__set_in_local_only__

# 首次启动 seed 的 admin 密码 (本地简单即可)
LLM_GATEWAY_SEED_ADMIN_PASSWORD=__set_in_local_only__